<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Cron job to fetch incoming emails from Microsoft 365 -->
        <record id="ir_cron_microsoft_fetch_incoming_mail" model="ir.cron">
            <field name="name">Microsoft Graph: Fetch Incoming Mail</field>
            <field name="model_id" ref="model_microsoft_incoming_mail_processor"/>
            <field name="state">code</field>
            <field name="code">model._cron_fetch_incoming_mail()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">100</field>
        </record>
    </data>
</odoo>
