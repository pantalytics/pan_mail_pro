<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Incoming mail: every syncing mailbox, whatever its provider -->
        <record id="ir_cron_pan_mail_fetch_incoming_mail" model="ir.cron">
            <field name="name">Mail Pro: Fetch Incoming Mail</field>
            <field name="model_id" ref="model_pan_mail_fetcher"/>
            <field name="state">code</field>
            <field name="code">model._cron_fetch_incoming_mail()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">100</field>
        </record>

        <!-- Routing log housekeeping. One row per incoming mail on a
             one-minute cron adds up; rows still flagged for review are kept
             regardless of age. -->
        <record id="ir_cron_pan_mail_routing_log_gc" model="ir.cron">
            <field name="name">Mail Pro: Clean Up Routing Log</field>
            <field name="model_id" ref="model_pan_mail_routing_log"/>
            <field name="state">code</field>
            <field name="code">model._gc_routing_logs()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">200</field>
        </record>
    </data>
</odoo>
