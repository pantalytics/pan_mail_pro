<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The account page (the Mail Pro canvas, 02, 26 Nov 2026): Connector
         Pro's pattern. The status in the header, the way out beside it, and
         two grey rows: the workspace and who connected it when. A button that
         fixes something (Choose a Plan, Add a Card, Check Again) shows only
         while there is something to fix; billing in the normal case is at
         Pantalytics, not here. Nothing is typed on this page. -->
    <record id="view_pan_mail_license_form" model="ir.ui.view">
        <field name="name">pan.mail.license.form</field>
        <field name="model">pan.mail.license</field>
        <field name="arch" type="xml">
            <form string="Pantalytics Account" class="o_mailpro_mailbox_form"
                  create="false" edit="false" delete="false" duplicate="false">
                <header>
                    <field name="mail_paused" invisible="1"/>
                    <field name="check_again" invisible="1"/>
                    <button name="action_open_dashboard" type="object"
                            string="Choose a Plan" class="btn-primary"
                            invisible="status != 'canceled'"/>
                    <button name="action_open_dashboard" type="object"
                            string="Add a Card" class="btn-primary"
                            invisible="not mail_paused or status == 'canceled'"/>
                    <button name="action_check_approval" type="object"
                            string="Check Again" class="btn-secondary"
                            invisible="not check_again"/>
                    <button name="action_disconnect" type="object"
                            string="Disconnect" class="btn-secondary"
                            confirm="This Odoo instance forgets its Pantalytics key. You can connect again at any time."/>
                    <field name="status" widget="badge" class="ms-auto"
                           decoration-success="status in ('active', 'trialing')"
                           decoration-warning="status == 'past_due'"
                           decoration-danger="status in ('canceled', 'revoked', 'invalid')"/>
                </header>
                <!-- Only while there is something to say. -->
                <div class="alert alert-danger mb-0 rounded-0" role="alert" invisible="not last_error">
                    <field name="last_error" readonly="1" nolabel="1"/>
                </div>
                <div class="alert alert-info mb-0 rounded-0" role="status" invisible="not message">
                    <field name="message" readonly="1" nolabel="1"/>
                </div>
                <sheet>
                    <div class="oe_title o_mailpro_mailbox_head">
                        <h1>Pantalytics Account</h1>
                    </div>
                    <div class="list-group o_mailpro_rows">
                        <div class="list-group-item d-flex align-items-center gap-3"
                             invisible="not workspace_label">
                            <span class="flex-grow-1">Workspace</span>
                            <field name="workspace_label" class="w-auto text-muted"/>
                        </div>
                        <div class="list-group-item d-flex align-items-center gap-3">
                            <span class="flex-grow-1">Connected By</span>
                            <field name="connected_line" class="w-auto text-muted"/>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
