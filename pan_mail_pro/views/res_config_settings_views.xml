<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mail Pro Settings App -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mail.pro</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Mail Pro" name="pan_mail_pro" groups="base.group_system">
                    <!-- State the sections below hide behind. -->
                    <field name="x_setup_provider_done" invisible="1"/>
                    <field name="x_setup_domains_done" invisible="1"/>
                    <field name="x_setup_notification_done" invisible="1"/>
                    <field name="x_internal_domain_ids" invisible="1" widget="many2many_tags"/>
                    <field name="x_setup_account_done" invisible="1"/>
                    <field name="x_license_state" invisible="1"/>
                    <field name="x_license_sync_blocked" invisible="1"/>
                    <field name="x_license_mail_paused" invisible="1"/>
                    <field name="x_account_dot" invisible="1"/>
                    <field name="x_provider_dot" invisible="1"/>
                    <field name="x_domains_dot" invisible="1"/>
                    <field name="x_mailboxes_dot" invisible="1"/>
                    <field name="x_notification_dot" invisible="1"/>
                    <field name="x_up_and_running" invisible="1"/>

                    <!-- The checklist sits in Odoo's own settings container so
                         it is capped and indented like every other block on this
                         page. Without it the rows ran the full width of the
                         window and the arrow ended up a screen away from the
                         name it belongs to.

                         Five steps, in one shape: a coloured dot on the left,
                         the name, the answer, and the way to the place you
                         change it. Configuration only (#415): the first mail
                         is not a step, the Pantalytics app walks the person
                         to it. Steps 2 to 5 are tables, so that way is a
                         link to the table — nothing is typed on this page,
                         and nothing is done on it either: no button or link
                         on a row that has an arrow, and the whole row is the
                         way in (one route, #369 and #382).
                         Step 1 is a pairing with our server, so while it is
                         open its way is a button on the line itself; once it
                         is connected the line names the Pantalytics workspace
                         and its arrow opens the account page like the other
                         four. An
                         answer is one word or one number, never a list.
                         Anything longer than an answer — a warning, a fix —
                         goes on its own line under the name, never beside it,
                         so the column of dots and names stays a column. -->
                    <!-- A copy (staging, a restore): outgoing mail goes to
                         the host's catcher and nothing is read. One line, no
                         switch: Odoo's neutralization decided, not a person. -->
                    <field name="x_is_copy" invisible="1"/>
                    <h2>Setup</h2>
                    <div class="row mt-3 o_settings_container">
                    <div class="col-12 o_setting_box o_mailpro_copy_marker" role="status" invisible="not x_is_copy">
                        This is a copy. Mail is shown, not sent.
                    </div>
                    <!-- The end of the line (#391, #415): all five dots
                         done, an amber step 5 included. The five steps fold
                         under one line and its one next action,
                         and Show setup unfolds them again; the widget holds
                         that fold, so it is a click and never a change to
                         save. Confetti once per database. -->
                    <widget name="mailpro_up_and_running" class="col-12 o_setting_box o_mailpro_running_box"
                            invisible="not x_up_and_running"/>
                    <div class="col-12 o_setting_box o_mailpro_steps">

                    <!-- Step 1. One primary action per state, and the code is
                         the biggest thing on screen while it is waiting,
                         because it gets read off here and typed somewhere
                         else. Red once it was connected and broke: a lapsed
                         or revoked link is a stopped step, not an open one. -->
                    <div class="o_mailpro_step">
                        <span class="o_mailpro_dot o_mailpro_dot_ok" role="img" aria-label="Done" title="Done"
                              invisible="x_account_dot != 'ok'"/>
                        <span class="o_mailpro_dot o_mailpro_dot_warn" role="img" aria-label="Attention needed" title="Attention needed"
                              invisible="x_account_dot != 'warn'"/>
                        <span class="o_mailpro_dot o_mailpro_dot_todo" role="img" aria-label="To do" title="To do"
                              invisible="x_account_dot != 'todo'"/>
                        <div class="o_mailpro_step_body">
                            <div class="o_mailpro_step_head">
                                <span class="o_mailpro_step_name">1. Pantalytics account</span>
                                <span class="o_mailpro_step_value" invisible="x_license_state != 'not_connected'">Not connected</span>
                                <span class="o_mailpro_step_value" invisible="x_license_state != 'pending'">Waiting for approval</span>
                                <!-- The workspace's name while the link holds
                                     (#418), "Connected" when the answer names
                                     none. A long name is cut with an
                                     ellipsis, never wrapped. When it broke,
                                     the dot is red and the word is what
                                     broke: Payment failed, Revoked. -->
                                <span class="o_mailpro_step_value" invisible="not x_setup_account_done or x_license_mail_paused or not x_license_workspace_name">
                                    <field name="x_license_workspace_name" nolabel="1" readonly="1" class="d-inline"/>
                                </span>
                                <span class="o_mailpro_step_value" invisible="not x_setup_account_done or x_license_mail_paused or x_license_workspace_name">Connected</span>
                                <span class="o_mailpro_step_value" invisible="not x_license_mail_paused">Incoming paused</span>
                                <span class="o_mailpro_step_value"
                                      invisible="x_license_state != 'connected' or x_setup_account_done or x_license_status in ('invalid', 'revoked')">
                                    <field name="x_license_status" nolabel="1" readonly="1" class="d-inline"/>
                                </span>
                                <span class="o_mailpro_step_value" invisible="x_license_status not in ('invalid', 'revoked')">Disconnected</span>
                            </div>
                            <div class="o_mailpro_step_msg" invisible="x_license_state != 'not_connected'">
                                Connect this Odoo to your Pantalytics account.
                            </div>
                            <div class="o_mailpro_step_msg" invisible="x_license_state != 'not_connected'">
                                <button name="action_license_connect" type="object"
                                        string="Connect to Pantalytics" class="btn-primary"/>
                            </div>
                            <div class="o_mailpro_step_msg" invisible="x_license_state != 'pending'">
                                Approve the connection on the Pantalytics page.
                                It shows this code:
                                <field name="x_license_user_code" nolabel="1" readonly="1" class="fw-bold ms-1"/>
                            </div>
                            <div class="o_mailpro_step_msg" invisible="x_license_state != 'pending'">
                                Not approved yet? <field name="x_license_verify_url" widget="url" nolabel="1" readonly="1"
                                               options="{'website_path': False}" text="Open the Pantalytics page"/>
                            </div>
                            <div class="o_mailpro_step_msg" invisible="x_license_state != 'pending'">
                                <button name="action_license_check" type="object"
                                        string="Check approval" class="btn-secondary"/>
                                <button name="action_license_disconnect" type="object"
                                        string="Cancel" class="btn-link"/>
                            </div>
                            <!-- A failure stays on the line it happened to,
                                 with the one thing to do about it under it.
                                 Everything else about a connected account
                                 (who, when, the plan, usage and billing,
                                 Disconnect) is on the account page the arrow
                                 opens. -->
                            <!-- The key is dead on the server: a new pairing
                                 is the whole fix, and the button does it. -->
                            <div class="o_mailpro_step_msg" invisible="x_license_status not in ('invalid', 'revoked')">
                                No longer connected to Pantalytics.
                            </div>
                            <div class="o_mailpro_step_msg" invisible="x_license_status not in ('invalid', 'revoked')">
                                <button name="action_license_connect" type="object"
                                        string="Connect again" class="btn-primary"/>
                            </div>
                            <!-- Connected, but the workspace has no plan.
                                 Choose a plan is on the account page. -->
                            <div class="o_mailpro_step_msg" invisible="x_license_status != 'canceled'">
                                Your Pantalytics workspace has no Mail Pro plan.
                            </div>
                            <!-- Connected, but the last answer lapsed: our
                                 server or the way to it is down. -->
                            <div class="o_mailpro_step_msg o_mailpro_msg_warn"
                                 invisible="not x_license_sync_blocked or x_license_state != 'connected' or x_license_status in ('invalid', 'revoked', 'canceled')">
                                Pantalytics has not confirmed this Odoo recently, so incoming mail is paused.
                                Sending keeps working.
                            </div>
                            <div class="o_mailpro_step_msg o_mailpro_msg_warn"
                                 invisible="not x_license_last_error or x_license_status in ('invalid', 'revoked', 'canceled')">
                                <field name="x_license_last_error" nolabel="1" readonly="1"/>
                            </div>
                            <!-- Connected, and the month's included mails are
                                 used with no card on the workspace. Only
                                 incoming waits, so steps 2 to 5 stay. Add a
                                 card and Check again are on the account page. -->
                            <div class="o_mailpro_step_msg o_mailpro_msg_warn" invisible="not x_license_mail_paused">
                                <field name="x_license_mail_paused_msg" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                        <button name="action_license_open" type="object"
                                icon="oi-chevron-right" title="Pantalytics account"
                                class="oe_link o_mailpro_step_edit"
                                invisible="x_license_state != 'connected' or x_license_status in ('invalid', 'revoked')"/>
                    </div>

                    <!-- Nothing below this line exists until step 1 is green:
                         not before connecting, and not after the connection
                         broke (a refused or revoked key, no plan, an answer
                         that lapsed). Every step of it configures a product
                         that will not run, and a checklist you cannot finish
                         reads as the thing that is broken. One screen, one
                         action: the one step 1 names. -->
                    <div invisible="not x_setup_account_done">
                    <div class="o_mailpro_step o_mailpro_step_provider">
                        <!-- One status, shared with the provider form: the
                             dot is the row's own `status`, the badge on the
                             form behind the arrow. Green once somebody signed
                             in, amber while nobody has (the form's one button
                             is Sign in), the open dot before the registration
                             exists. The phase reads the credentials, not
                             this, so sync does not wait for a sign-in.

                             The one exception is the row still on the
                             customer's own Azure app: amber whatever its
                             status, until it has moved (#369). Accounts that
                             still refresh through the old app are each
                             mailbox's status, not this step's. Not red: the
                             old sign-ins keep working, so nothing is broken. -->
                        <field name="x_provider_status" invisible="1"/>
                        <field name="x_microsoft_on_own_app" invisible="1"/>
                        <span class="o_mailpro_dot o_mailpro_dot_ok" role="img" aria-label="Done" title="Done"
                              invisible="x_provider_dot != 'ok'"/>
                        <span class="o_mailpro_dot o_mailpro_dot_attention" role="img" aria-label="Attention needed" title="Attention needed"
                              invisible="x_provider_dot != 'attention'"/>
                        <span class="o_mailpro_dot o_mailpro_dot_todo" role="img" aria-label="To do" title="To do"
                              invisible="x_provider_dot != 'todo'"/>
                        <div class="o_mailpro_step_body">
                            <div class="o_mailpro_step_head">
                                <span class="o_mailpro_step_name">2. Email provider</span>
                                <span class="o_mailpro_step_value" invisible="x_provider_status != 'connected'">
                                    <field name="x_active_provider_id" nolabel="1" readonly="1" options="{'no_open': True}"/>
                                </span>
                                <span class="o_mailpro_step_value" invisible="x_provider_status != 'not_connected'">Not signed in</span>
                                <span class="o_mailpro_step_value" invisible="x_setup_provider_done">
                                    <field name="x_setup_provider_todo" nolabel="1" readonly="1"/>
                                </span>
                            </div>
                            <!-- Only while the step is open. Once it is answered
                                 the answer beside the name explains the step
                                 better than any sentence could, and a hint that
                                 stays is the one people learn to skip. -->
                            <div class="o_mailpro_step_msg" invisible="x_setup_provider_done or x_setup_provider_needs_account">
                                Where your company's email lives.
                            </div>
                            <div class="o_mailpro_step_msg" invisible="not x_setup_provider_needs_account">
                                Each IMAP/SMTP address is an account with its own server, login and password.
                            </div>
                            <!-- The move off an own Azure app (ARCHITECTURE.md
                                 §9.20), as status only: one line, no button.
                                 The move is on the provider form behind the
                                 arrow (#369). The provider is Microsoft 365
                                 throughout; whose app it signs in with is not
                                 a provider, so the words "Pantalytics app"
                                 stay off this page. -->
                            <div class="o_mailpro_step_msg o_mailpro_msg_attention" invisible="not x_microsoft_on_own_app">
                                Sign in again to finish the move
                            </div>
                        </div>
                        <field name="x_setup_provider_needs_account" invisible="1"/>
                        <!-- The row itself, never the list: a list could
                             land on a new, unsaved form, and saving that is
                             a second provider row. With no row yet the
                             method makes one, so the form opens saved, on
                             its Sign in with Microsoft button (#382). -->
                        <button type="object" name="action_open_provider"
                                icon="oi-chevron-right" title="Provider"
                                class="oe_link o_mailpro_step_edit"
                                invisible="x_setup_provider_needs_account"/>
                        <button type="action" name="%(action_pan_mail_account)d"
                                icon="oi-chevron-right" title="Email Accounts"
                                class="oe_link o_mailpro_step_edit"
                                invisible="not x_setup_provider_needs_account"/>
                    </div>

                    <div class="o_mailpro_step">
                        <span class="o_mailpro_dot o_mailpro_dot_ok" role="img" aria-label="Done" title="Done"
                              invisible="x_domains_dot != 'ok'"/>
                        <span class="o_mailpro_dot o_mailpro_dot_todo" role="img" aria-label="To do" title="To do"
                              invisible="x_domains_dot != 'todo'"/>
                        <div class="o_mailpro_step_body">
                            <div class="o_mailpro_step_head">
                                <span class="o_mailpro_step_name">3. Internal domains</span>
                                <span class="o_mailpro_step_value" invisible="not x_setup_domains_done">
                                    <field name="x_internal_domains_summary" nolabel="1" readonly="1"/>
                                </span>
                                <span class="o_mailpro_step_value" invisible="x_setup_domains_done">Not set yet</span>
                            </div>
                            <div class="o_mailpro_step_msg" invisible="x_setup_domains_done">
                                The domains your company owns. Email between them is never copied into Odoo.
                            </div>
                            <!-- What can be read off the database is offered
                                 on the list the arrow opens, while it is
                                 empty (pan.mail.domain.action_add_suggested),
                                 not here: this row only reports (#382). -->
                        </div>
                        <button type="action" name="%(action_pan_mail_domain)d"
                                icon="oi-chevron-right" title="Internal domains"
                                class="oe_link o_mailpro_step_edit"/>
                    </div>

                    <div class="o_mailpro_step o_mailpro_step_mailboxes">
                        <!-- Green once one mailbox works: not stopped, and
                             signed in so it reaches its provider. Red when a
                             mailbox stopped or the provider refused it, with
                             the sentence under the name. Which one sends
                             Odoo's own email is step 5 (#415). -->
                        <span class="o_mailpro_dot o_mailpro_dot_ok" role="img" aria-label="Done" title="Done"
                              invisible="x_mailboxes_dot != 'ok'"/>
                        <span class="o_mailpro_dot o_mailpro_dot_warn" role="img" aria-label="Attention needed" title="Attention needed"
                              invisible="x_mailboxes_dot != 'warn'"/>
                        <span class="o_mailpro_dot o_mailpro_dot_todo" role="img" aria-label="To do" title="To do"
                              invisible="x_mailboxes_dot != 'todo'"/>
                        <div class="o_mailpro_step_body">
                            <div class="o_mailpro_step_head">
                                <span class="o_mailpro_step_name">4. Mailboxes</span>
                                <!-- A count, like the domains line. -->
                                <span class="o_mailpro_step_value" invisible="x_mailboxes_dot == 'todo'">
                                    <field name="x_mailboxes_summary" nolabel="1" readonly="1"/>
                                </span>
                                <span class="o_mailpro_step_value" invisible="x_mailboxes_dot != 'todo'">None working yet</span>
                            </div>
                            <div class="o_mailpro_step_msg" invisible="x_mailboxes_dot != 'todo'">
                                The addresses Mail Pro sends and receives on. At least one
                                has to be signed in and working.
                            </div>
                            <div class="o_mailpro_step_msg o_mailpro_msg_warn" invisible="not x_mailboxes_alert">
                                <field name="x_mailboxes_alert" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                        <button type="action" name="%(action_pan_mail_mailbox)d"
                                icon="oi-chevron-right" title="Mailboxes"
                                class="oe_link o_mailpro_step_edit"/>
                    </div>

                    <div class="o_mailpro_step o_mailpro_step_notification">
                        <!-- Green only once the owner's sign-in has been seen to
                             read and send from it (the access table), not once
                             the row exists with a token on it: that is the
                             difference between a step answered and a step that
                             works, and it was the one the Emovr checklist could
                             not tell. Red when the provider refused; the open
                             dot while a probe or the first email is still to
                             happen. -->
                        <field name="x_notification_access_state" invisible="1"/>
                        <field name="x_notification_mailbox_type" invisible="1"/>
                        <!-- Amber while a personal mailbox carries the system
                             email (#387): it works, and a shared mailbox
                             with the flag is the better way. A step that has
                             stopped is one dot, not two: the red wins. -->
                        <span class="o_mailpro_dot o_mailpro_dot_ok" role="img" aria-label="Done" title="Done"
                              invisible="x_notification_dot != 'ok'"/>
                        <span class="o_mailpro_dot o_mailpro_dot_warn" role="img" aria-label="Attention needed" title="Attention needed"
                              invisible="x_notification_dot != 'warn'"/>
                        <span class="o_mailpro_dot o_mailpro_dot_attention" role="img" aria-label="Attention needed" title="Attention needed"
                              invisible="x_notification_dot != 'attention'"/>
                        <span class="o_mailpro_dot o_mailpro_dot_todo" role="img" aria-label="To do" title="To do"
                              invisible="x_notification_dot != 'todo'"/>
                        <div class="o_mailpro_step_body">
                            <div class="o_mailpro_step_head">
                                <span class="o_mailpro_step_name">5. Notification mailbox</span>
                                <!-- One address: the mailbox ticked to send
                                     Odoo's own email. -->
                                <span class="o_mailpro_step_value" invisible="not x_notification_mailbox_email">
                                    <field name="x_notification_mailbox_email" nolabel="1" readonly="1"/>
                                </span>
                                <span class="o_mailpro_step_value" invisible="x_notification_mailbox_email">Not chosen yet</span>
                            </div>
                            <div class="o_mailpro_step_msg" invisible="x_setup_notification_done">
                                The mailbox Odoo sends its own email from, like password
                                resets. A shared one is best, with you as its owner.
                            </div>
                            <!-- What is still to happen before the dot turns:
                                 one muted line while open, the provider's own
                                 sentence in warning colour when it refused. -->
                            <div class="o_mailpro_step_msg"
                                 invisible="not x_setup_notification_done or x_notification_access_state != 'open' or not x_notification_access_msg">
                                <field name="x_notification_access_msg" nolabel="1" readonly="1"/>
                            </div>
                            <div class="o_mailpro_step_msg o_mailpro_msg_warn"
                                 invisible="x_notification_access_state != 'broken'">
                                <field name="x_notification_access_msg" nolabel="1" readonly="1"/>
                            </div>
                            <div class="o_mailpro_step_msg o_mailpro_msg_attention"
                                 invisible="x_notification_access_state == 'broken' or not x_setup_notification_done or x_notification_mailbox_type != 'personal'">
                                System email from a personal mailbox
                            </div>
                        </div>
                        <!-- The Mailboxes list, where the notification
                             column is and where a shared mailbox takes the
                             flag. -->
                        <button type="action" name="%(action_pan_mail_mailbox)d"
                                icon="oi-chevron-right" title="Notification mailbox"
                                class="oe_link o_mailpro_step_edit"/>
                    </div>

                    </div>
                    </div>
                    </div>

                    <h2>About</h2>
                    <!-- No left/right pane: an empty left pane draws a divider
                         beside a single link, which reads as a missing field.

                         The version is the first thing a support mail has to
                         answer, and the licence claim belongs where anyone
                         using the module can read it — not in the tooltip it
                         used to hide in. -->
                    <div class="row mt-3 o_settings_container">
                        <div class="col-12 o_setting_box o_mailpro_about">
                            <div>
                                <span class="o_form_label">Mail Pro</span>
                                <field name="x_module_version" nolabel="1" readonly="1" class="ms-1"/>
                            </div>
                            <div class="text-muted">
                                © Pantalytics B.V. Licensed under the Elastic License 2.0.
                                You may use, copy and modify this software. You may not
                                offer it to third parties as a hosted or managed service,
                                and you may not remove or circumvent its licensing notices.
                            </div>
                            <div class="mt-2">
                                <a href="https://odoo.pantalytics.com/knowledge/article/116" target="_blank">
                                    <i class="fa fa-external-link me-1" title="Documentation"/>Documentation
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Help improve Mail Pro. Switched on at Pantalytics, for
                         the workspace; this page can only refuse it for this
                         instance, so the toggle exists only while it is on: a
                         switch for something that is not happening is a puzzle.
                         Last on the page, because nothing depends on it. The
                         label says what it does; what it does not do is behind
                         the icon, in a title, the way Odoo's own settings mark
                         a company-specific field. Odoo's tooltip attributes are
                         forbidden in an arch, so title is the only tooltip
                         there is. -->
                    <div class="row mt-3 o_settings_container" invisible="not x_improve_on">
                        <div class="col-12 o_setting_box o_mailpro_about">
                            <div class="d-flex align-items-center">
                                <field name="x_improve" widget="boolean_toggle" nolabel="1"
                                       class="d-inline-block"/>
                                <label for="x_improve" class="o_form_label ms-2 mb-0"/>
                                <i class="fa fa-info-circle text-muted ms-2" role="img"
                                   title="On for your Pantalytics workspace. The Mail Pro inbox reports which screens, tabs and buttons are used, and records the session with every word and field masked. Never a mail, an address, a name or a subject. Off here refuses it for this Odoo instance only."/>
                            </div>
                        </div>
                    </div>
                </app>
            </xpath>
        </field>
    </record>

    <!-- Banner in standard Email settings -->
    <record id="res_config_settings_view_form_email_banner" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mail.pro.email.banner</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='email_servers_setting']" position="before">
                <div class="alert alert-info mb-3" role="alert">
                    <i class="fa fa-info-circle me-2" title="Info"/>
                    <strong>Mail Pro is installed.</strong>
                    Outgoing and incoming email is handled by Mail Pro.
                    <a href="/odoo/settings#pan_mail_pro" class="alert-link ms-1">Configure in Settings → Mail Pro</a>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
