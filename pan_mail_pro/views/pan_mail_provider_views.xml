<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- One row: the provider this database runs on. Credentials and status
         live here, not on the settings page — the settings page only links to
         this table, the same way it links to Internal Domains and Mailboxes. -->
    <record id="view_pan_mail_provider_list" model="ir.ui.view">
        <field name="name">pan.mail.provider.list</field>
        <field name="model">pan.mail.provider</field>
        <field name="arch" type="xml">
            <!-- No New, here or on the form: there is one row, made by
                 Settings step 2, and a second one is refused by the
                 constraint after the admin typed into it. -->
            <list string="Providers" create="0">
                <field name="provider"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'connected'"
                       decoration-warning="status == 'not_connected'"
                       decoration-danger="status == 'not_configured'"/>
                <field name="client_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_pan_mail_provider_form" model="ir.ui.view">
        <field name="name">pan.mail.provider.form</field>
        <field name="model">pan.mail.provider</field>
        <field name="arch" type="xml">
            <!-- One primary button while the provider is not connected:
                 Sign in with Microsoft or Google, straight to the consent
                 screen in this tab, and back on this form connected (#382).
                 Settings step 2 only reports; this is where it is acted on.
                 Saving a changed own registration (Google's client, never
                 Mail Pro's Microsoft app) also opens the verify dialog
                 (pan_mail_provider_form). A connected provider offers
                 Disconnect, secondary, to whoever is signed in. -->
            <form string="Provider" js_class="pan_mail_provider_form" create="0">
                <sheet>
                    <field name="uses_oauth" invisible="1"/>
                    <field name="credentials_set" invisible="1"/>
                    <field name="pantalytics_connected" invisible="1"/>
                    <field name="my_account_connected" invisible="1"/>
                    <group>
                        <group>
                            <field name="provider"/>
                            <field name="status" widget="badge" readonly="1"
                                   decoration-success="status == 'connected'"
                                   decoration-warning="status == 'not_connected'"
                                   decoration-danger="status == 'not_configured'"/>
                            <!-- No "Sign in through" choice (#369): Microsoft
                                 365 signs in with Mail Pro's Microsoft app.
                                 An own app registration is a legacy state a
                                 database can still be in, never one it can
                                 be put in from here. The field stays on the
                                 model; only the choice left the screen. -->
                            <field name="registration" invisible="1"/>
                        </group>
                    </group>

                    <!-- The only thing standing between this row and a
                         sign-in, so it is the one line said. -->
                    <div class="text-warning mb-3"
                         invisible="provider != 'outlook' or registration != 'pantalytics' or pantalytics_connected">
                        Signing in with Microsoft needs this Odoo connected to Pantalytics
                        first: Settings, Mail Pro, step 1.
                    </div>
                    <div class="mb-3"
                         invisible="provider != 'outlook' or registration != 'pantalytics' or not pantalytics_connected or status == 'connected'">
                        <button name="action_connect_myself" type="object"
                                string="Sign in with Microsoft" class="btn-primary o_mailpro_provider_sign_in"/>
                    </div>
                    <div class="mb-3"
                         invisible="provider != 'gmail' or not credentials_set or status == 'connected'">
                        <button name="action_connect_myself" type="object"
                                string="Sign in with Google" class="btn-primary o_mailpro_provider_sign_in"/>
                    </div>
                    <!-- Connected: the way out, for the reader's own sign-in
                         only (My Preferences' Disconnect). A colleague's
                         sign-in is theirs, so a reader without one gets no
                         button and the badge stays Connected. -->
                    <div class="mb-3" invisible="status != 'connected' or not my_account_connected">
                        <button name="action_disconnect_myself" type="object"
                                string="Disconnect" class="btn-secondary o_mailpro_provider_disconnect"
                                confirm="Mailboxes that send or sync with your sign-in stop until someone signs in again."/>
                    </div>

                    <!-- The move off an own app registration (§9.20), the
                         one action a deprecated state offers. The move keeps
                         the old credentials for the accounts that still
                         refresh with them, and clears them on its own once
                         none does: who still has to sign in again is each
                         mailbox's status, never this form's (#369). Settings
                         step 2 only reports the state, as an amber dot and
                         one line, and its arrow opens this form. -->
                    <div class="text-warning mb-2" invisible="provider != 'outlook' or registration != 'own'">
                        Your own app registration is deprecated. Sign in with Microsoft once to move over.
                    </div>
                    <div class="mb-3" invisible="provider != 'outlook' or registration != 'own' or not pantalytics_connected">
                        <!-- No confirm: it only sends the admin to
                             Microsoft, and nothing is lost on the way. -->
                        <button name="action_switch_to_pantalytics" type="object"
                                string="Sign in with Microsoft" class="btn-primary"/>
                    </div>
                    <div class="text-muted mb-3" invisible="provider != 'outlook' or registration != 'own' or pantalytics_connected">
                        Connect this Odoo to Pantalytics first: Settings, Mail Pro, step 1.
                    </div>
                    <!-- What to do and where the steps are, before the
                         fields: the form alone asks for IDs nobody has yet.
                         The steps themselves stay in the knowledge base, one
                         click deeper. Gmail only: an own Azure app is no
                         longer made, so it has no guide here. -->
                    <div class="alert alert-info mb-3" role="status" invisible="provider != 'gmail'">
                        Mail Pro signs in through an OAuth client in your Google Cloud
                        project. Creating one takes about ten minutes; you paste its Client
                        ID and secret here.
                        <a href="https://odoo.pantalytics.com/knowledge/article/128" target="_blank"
                           class="fw-bold ms-1">Step-by-step guide</a>
                    </div>

                    <group string="Application registration"
                           invisible="not uses_oauth or (provider == 'outlook' and registration != 'own')">
                        <group>
                            <!-- Microsoft's own words, copied from the app
                                 registration's Overview page. A field labelled
                                 anything else is a field the admin has to
                                 translate while copying, which is how a client
                                 secret ends up in the tenant box. -->
                            <!-- Read-only (#369): an own Azure app is a
                                 deprecated state, shown so the admin can
                                 tell which app it is, not edited. -->
                            <field name="client_id" string="Application (client) ID"
                                   invisible="provider != 'outlook'" readonly="1"/>
                            <field name="client_secret" string="Client Secret Value"
                                   password="True" invisible="provider != 'outlook'" readonly="1"/>
                            <field name="tenant_id" string="Directory (tenant) ID"
                                   invisible="provider != 'outlook'" readonly="1"/>
                            <!-- Google's console says "Client ID" and "Client
                                 secret", and has no tenant at all. -->
                            <field name="client_id" invisible="provider == 'outlook'"/>
                            <field name="client_secret" password="True"
                                   invisible="provider == 'outlook'"/>
                        </group>
                        <group invisible="provider == 'outlook'">
                            <label for="redirect_uri"/>
                            <div>
                                <field name="redirect_uri" nolabel="1" readonly="1" widget="CopyClipboardChar"/>
                                <div class="text-muted mt-1">
                                    Paste this into the provider console's redirect URIs.
                                    Sign-in fails until it matches exactly.
                                </div>
                            </div>
                        </group>
                    </group>

                    <!-- `not uses_oauth` is also true before a provider is
                         chosen, so a brand new record opened with IMAP's
                         explanation on it. Say it about IMAP, not about the
                         empty form. -->
                    <div class="alert alert-info" role="alert"
                         invisible="uses_oauth or not provider">
                        <i class="fa fa-info-circle me-2" title="Info"/>
                        IMAP/SMTP has no application registration — a server, login and
                        password are per address. "Configured" means at least one account
                        exists; add one under Settings → Technical → Email → Email Accounts.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pan_mail_provider" model="ir.actions.act_window">
        <field name="name">Providers</field>
        <field name="res_model">pan.mail.provider</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No provider yet
            </p>
            <p>
                Settings, Mail Pro, step 2 sets it up.
            </p>
        </field>
    </record>

    <!-- Menu: Settings → Technical → Email → Providers -->
    <menuitem id="menu_pan_mail_provider"
              name="Providers"
              parent="pan_mail_pro.menu_pan_mail_root"
              action="action_pan_mail_provider"
              sequence="10"
              groups="base.group_system"/>
</odoo>
