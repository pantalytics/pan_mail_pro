<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_pan_mail_mailbox_list" model="ir.ui.view">
        <field name="name">pan.mail.mailbox.list</field>
        <field name="model">pan.mail.mailbox</field>
        <field name="arch" type="xml">
            <list string="Mailboxes" js_class="mailbox_list">
                <field name="sequence" widget="handle"/>
                <field name="email" string="Mailbox"/>
                <!-- What the mailbox is at the provider. Mail Pro's own
                     sending policy (`mailbox_type`) is not shown. -->
                <field name="provider_type" string="Type" optional="show"/>
                <!-- The same one word as the mailbox page's header. -->
                <field name="sync_status" string="Status" widget="badge"
                       decoration-success="sync_status == 'syncing'"
                       decoration-danger="sync_status == 'stopped'"
                       decoration-muted="sync_status in ('not_started', 'paused')"/>
                <!-- Editable straight from the list: exactly one mailbox
                     sends the system email, so ticking one here unticks the
                     other, and the last one cannot be unticked. -->
                <field name="is_notification_mailbox" string="Notification"
                       widget="boolean_toggle"/>
                <!-- What the provider says is at the address, as the access
                     check last found it: the detail behind Type. -->
                <field name="address_kind" string="Kind" optional="hide"/>
                <field name="provider" string="Provider" optional="hide"/>
                <field name="owner_user_id" string="Owner" optional="hide"/>
                <field name="sync_level" string="Sync" optional="hide"/>
                <!-- The cursor, named as one. It used to say "Last Synced"
                     here too, which is the question the next column answers. -->
                <field name="last_sync_date" string="Newest mail read" optional="hide"/>
                <field name="last_check_date" string="Last checked" optional="hide"/>
                <field name="error_message" string="Error" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View: the mailbox page (the Mail Pro canvas, 04 and 05).
         Connector Pro's pattern: the address and one card of rows. The status
         is the sync's and is said once, on the Sync page; here the Sync row
         says it. A row that is right is grey; one that waits on a
         person is red. The Sync row opens the Sync page, the same record in
         its second form, where the runs are. The only button is Sign In,
         while the sign-in is missing. -->
    <record id="view_pan_mail_mailbox_form" model="ir.ui.view">
        <field name="name">pan.mail.mailbox.form</field>
        <field name="model">pan.mail.mailbox</field>
        <field name="arch" type="xml">
            <form string="Mailbox" class="o_mailpro_mailbox_form">
                <header>
                    <field name="can_sign_in" invisible="1"/>
                    <button name="action_sign_in" type="object" string="Sign In"
                            class="btn-primary" invisible="not can_sign_in or not id"/>
                </header>
                <sheet>
                    <field name="provider" invisible="1"/>
                    <field name="state" invisible="1"/>
                    <field name="active" invisible="1"/>
                    <field name="owner_is_address" invisible="1"/>
                    <field name="health_status" invisible="1"/>
                    <field name="sync_attention" invisible="1"/>
                    <field name="sync_failure_count" invisible="1"/>

                    <div class="oe_title o_mailpro_mailbox_head">
                        <h1>
                            <field name="email" placeholder="support@company.com"/>
                        </h1>
                    </div>

                    <div class="list-group o_mailpro_rows">
                        <!-- On a personal mailbox whoever connected it owns
                             it, so the owner is read, not picked. -->
                        <div class="list-group-item d-flex align-items-center gap-3 o_mailpro_row_owner">
                            <span class="flex-grow-1">Owner</span>
                            <field name="sign_in_problem" readonly="1" nolabel="1"
                                   class="w-auto text-danger o_mailpro_row_problem"
                                   invisible="not sign_in_problem"/>
                            <field class="w-auto" name="owner_user_id" nolabel="1"
                                   readonly="owner_is_address and id"
                                   required="is_notification_mailbox"
                                   options="{'no_create': True}"/>
                            <!-- The only way from an IMAP mailbox to its password. -->
                            <button name="action_open_account" type="object"
                                    string="Edit Server Login" class="btn-link btn-sm p-0"
                                    invisible="provider != 'imap'"/>
                        </div>
                        <button name="action_open_sync" type="object" invisible="not id"
                                class="list-group-item list-group-item-action d-flex align-items-center gap-3 o_mailpro_row_sync">
                            <span class="flex-grow-1 text-start">Sync</span>
                            <field name="sync_value" class="w-auto text-muted" invisible="sync_attention"/>
                            <field name="sync_value" class="w-auto text-danger o_mailpro_row_problem"
                                   invisible="not sync_attention"/>
                            <span class="badge rounded-pill text-bg-danger" invisible="not sync_failure_count">
                                <field name="sync_failure_count"/>
                            </span>
                            <i class="fa fa-chevron-right text-muted o_mailpro_chevron" title="Open"/>
                        </button>
                    </div>

                    <div class="o_mailpro_rows_title">Advanced</div>
                    <div class="list-group o_mailpro_rows">
                        <div class="list-group-item d-flex align-items-center gap-3">
                            <span class="flex-grow-1">Notification Mailbox</span>
                            <field name="is_notification_mailbox" widget="boolean_toggle"
                                   nolabel="1" class="w-auto"/>
                        </div>
                    </div>

                    <group string="Technical" groups="base.group_no_one">
                        <field name="provider_type" string="Type" readonly="1"/>
                        <field name="address_kind" string="Kind" readonly="1"/>
                        <field name="last_check_date" string="Last Checked" readonly="1"/>
                        <field name="access_checked_date" string="Access Checked" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- The Sync Level page, opened from the Sync page's row: the slider
         with its checkmark grid (`mailpro_sync_level`), the same widget as
         My Preferences, and nothing else. -->
    <record id="view_pan_mail_mailbox_sync_level_form" model="ir.ui.view">
        <field name="name">pan.mail.mailbox.sync.level.form</field>
        <field name="model">pan.mail.mailbox</field>
        <field name="priority">110</field>
        <field name="arch" type="xml">
            <form string="Sync Level" class="o_mailpro_mailbox_sync_level" create="false" delete="false">
                <sheet>
                    <field name="sync_level" widget="mailpro_sync_level" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- The Sync page (the Mail Pro canvas, 06 and 07): the same mailbox in
         its second form, opened from the mailbox's Sync row. One status in
         the statusbar (Not Started, Syncing; Paused or Stopped while it is
         one) with Pause or Resume beside it, the settings as rows, and Runs,
         the level below, where each run's mails and errors are. -->
    <record id="view_pan_mail_mailbox_sync_form" model="ir.ui.view">
        <field name="name">pan.mail.mailbox.sync.form</field>
        <field name="model">pan.mail.mailbox</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Sync" class="o_mailpro_mailbox_form o_mailpro_mailbox_sync" create="false" delete="false">
                <header>
                    <button name="action_pause" type="object" string="Pause" groups="pan_mail_pro.group_mail_mailbox_manager"
                            invisible="sync_status != 'syncing'"/>
                    <button name="action_resume" type="object" string="Resume" class="btn-primary" groups="pan_mail_pro.group_mail_mailbox_manager"
                            invisible="sync_status not in ('paused', 'stopped')"/>
                    <field name="sync_status" widget="statusbar" statusbar_visible="not_started,syncing"/>
                </header>
                <div class="alert alert-danger mb-0 rounded-0" role="alert" invisible="not sync_note">
                    <field name="sync_note" readonly="1" nolabel="1"/>
                </div>
                <sheet>
                    <field name="sync_attention" invisible="1"/>
                    <field name="sync_failure_count" invisible="1"/>
                    <div class="oe_title o_mailpro_mailbox_head">
                        <h1>Sync</h1>
                    </div>

                    <div class="o_mailpro_rows_title">Settings</div>
                    <div class="list-group o_mailpro_rows o_mailpro_sync_settings">
                        <!-- The slider and its grid of what lands where are
                             a page of their own. -->
                        <button name="action_open_sync_level" type="object"
                                class="list-group-item list-group-item-action d-flex align-items-center gap-3">
                            <span class="flex-grow-1 text-start">Sync Level</span>
                            <field name="sync_level" class="w-auto text-muted" readonly="1"/>
                            <i class="fa fa-chevron-right text-muted o_mailpro_chevron" title="Open"/>
                        </button>
                        <!-- Replies follow their conversation whatever is set
                             here; from Known Contacts on, a new conversation
                             goes to the team picked, or to the sender's
                             contact. -->
                        <div class="list-group-item d-flex align-items-center gap-3">
                            <span class="flex-grow-1">Routing</span>
                            <span class="text-muted"
                                  invisible="sync_level in ('contacts', 'everyone')">Replies follow their conversation</span>
                            <field class="w-auto" name="alias_id" nolabel="1"
                                   invisible="sync_level not in ('contacts', 'everyone')"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   placeholder="Sender's Contact"/>
                        </div>
                        <div class="list-group-item d-flex align-items-center gap-3">
                            <span class="flex-grow-1">Import From</span>
                            <field class="w-auto" name="sync_start_date" nolabel="1"/>
                        </div>
                    </div>

                    <div class="o_mailpro_rows_title">Runs</div>
                    <div class="list-group o_mailpro_rows">
                        <div class="list-group-item list-group-item-action d-flex align-items-center gap-3 o_mailpro_row_runs">
                            <button name="action_open_runs" type="object"
                                    class="btn btn-link flex-grow-1 d-flex align-items-center gap-3 p-0 text-reset text-decoration-none">
                                <span class="flex-grow-1 text-start">Runs</span>
                                <field name="runs_value" class="w-auto text-muted" invisible="sync_attention"/>
                                <field name="runs_value" class="w-auto text-danger o_mailpro_row_problem"
                                       invisible="not sync_attention"/>
                                <span class="badge rounded-pill text-bg-danger" invisible="not sync_failure_count">
                                    <field name="sync_failure_count"/>
                                </span>
                            </button>
                            <button name="action_sync_now" type="object" string="Run Now"
                                    class="btn-secondary btn-sm text-nowrap" groups="pan_mail_pro.group_mail_mailbox_manager"
                                    invisible="sync_status == 'paused'"/>
                            <button name="action_open_runs" type="object" class="btn btn-link p-0"
                                    aria-label="Open Runs">
                                <i class="fa fa-chevron-right text-muted o_mailpro_chevron" title="Open"/>
                            </button>
                        </div>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_pan_mail_mailbox" model="ir.actions.act_window">
        <field name="name">Mailboxes</field>
        <field name="res_model">pan.mail.mailbox</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>No mailboxes yet</p>
            <p>Add one with New.</p>
        </field>
    </record>

    <!--
        Mailbox Manager, not only the system administrator: the ACL gives that
        group write on `pan.mail.mailbox`, and `action_sync_now` is gated
        on it, so an admin-only menu meant the only people allowed to press
        Try again could not reach the form it is on. Credentials stay administrator-only: Email Accounts and
        Providers keep `base.group_system`.
    -->
    <!-- Menu: Settings → Technical → Email → Mailboxes -->
    <menuitem id="menu_pan_mail_mailbox"
              name="Mailboxes"
              parent="pan_mail_pro.menu_pan_mail_root"
              action="action_pan_mail_mailbox"
              sequence="20"
              groups="pan_mail_pro.group_mail_mailbox_manager"/>

</odoo>
