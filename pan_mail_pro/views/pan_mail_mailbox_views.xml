<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_pan_mail_mailbox_list" model="ir.ui.view">
        <field name="name">pan.mail.mailbox.list</field>
        <field name="model">pan.mail.mailbox</field>
        <field name="arch" type="xml">
            <list string="Mailboxes" js_class="mailbox_list"
                  decoration-danger="health_status == 'error'"
                  decoration-warning="health_status == 'warning'">
                <field name="sequence" widget="handle"/>
                <field name="email" string="Mailbox"/>
                <!-- What the mailbox is at the provider. Mail Pro's own
                     sending policy (`mailbox_type`) is not shown. -->
                <field name="provider_type" string="Type" optional="show"/>
                <!-- The same one word as the mailbox page's header. -->
                <field name="health_status" column_invisible="1"/>
                <field name="sync_status" string="Status" widget="badge"
                       decoration-success="sync_status == 'syncing'"
                       decoration-danger="sync_status in ('failing', 'stopped')"
                       decoration-muted="sync_status in ('not_checked', 'off')"/>
                <!-- Editable straight from the list: exactly one mailbox
                     sends the system email, so ticking one here unticks the
                     other, and the last one cannot be unticked. -->
                <field name="is_notification_mailbox" string="Notification"
                       widget="boolean_toggle"/>
                <!-- What the provider says is at the address, as the access
                     check last found it: the detail behind Type. -->
                <field name="address_kind" string="Kind" optional="hide"/>
                <field name="provider" string="Provider" optional="hide"/>
                <field name="owner_user_id" string="Owner" optional="hide"/>
                <field name="sync_level" string="Sync" optional="hide"/>
                <!-- The cursor, named as one. It used to say "Last Synced"
                     here too, which is the question the next column answers. -->
                <field name="last_sync_date" string="Newest mail read" optional="hide"/>
                <field name="last_check_date" string="Last checked" optional="hide"/>
                <field name="error_message" string="Error" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View: the mailbox page (the Mail Pro canvas, 04 and 05).

         One status in the header, said once: Not Checked until the access
         check or a run has spoken, then Syncing, Failing, Stopped or Off.
         No primary button: what is wrong is said on the row it belongs to,
         as a short red word next to the row's value. The rows
         are Odoo's own group; the Sync row opens the Sync page, the same
         record in its second form. The chatter is the mailbox's history. -->
    <record id="view_pan_mail_mailbox_form" model="ir.ui.view">
        <field name="name">pan.mail.mailbox.form</field>
        <field name="model">pan.mail.mailbox</field>
        <field name="arch" type="xml">
            <form string="Mailbox" class="o_mailpro_mailbox_form">
                <header>
                    <field name="sync_status" widget="badge" class="ms-auto o_mailpro_mailbox_status"
                           decoration-success="sync_status == 'syncing'"
                           decoration-danger="sync_status in ('failing', 'stopped')"
                           decoration-muted="sync_status in ('not_checked', 'off')"/>
                </header>
                <sheet>
                    <field name="provider" invisible="1"/>
                    <field name="state" invisible="1"/>
                    <field name="active" invisible="1"/>
                    <field name="owner_is_address" invisible="1"/>
                    <field name="health_status" invisible="1"/>

                    <div name="button_box" class="oe_button_box">
                        <button name="action_open_routing_log" type="object"
                                class="oe_stat_button" icon="fa-random">
                            <field name="routing_log_count" widget="statinfo" string="Routed Here"/>
                        </button>
                    </div>

                    <div class="oe_title o_mailpro_mailbox_head">
                        <h1>
                            <field name="email" placeholder="support@company.com"/>
                        </h1>
                    </div>

                    <group class="o_mailpro_mailbox_rows">
                        <!-- Read, not asked: see _compute_provider_type. -->
                        <field name="provider_type" string="Type"
                               invisible="not provider_type"/>
                        <field name="is_notification_mailbox" string="Notification Mailbox"/>
                        <!-- The owner and this mailbox are verified
                             together: a row that is right says nothing, a
                             problem names who lacks what, and Sign In appears
                             only while the sign-in is missing (Mail Pro picks
                             whose). On a personal mailbox whoever connected it
                             owns it, so the owner is read, not picked. -->
                        <label for="owner_user_id" string="Owner"/>
                        <div class="o_mailpro_row_owner d-flex align-items-center gap-2">
                            <field class="w-auto" name="owner_user_id" nolabel="1"
                                   readonly="owner_is_address and id"
                                   required="is_notification_mailbox"/>
                            <field name="sign_in_problem" readonly="1" nolabel="1"
                                   class="w-auto text-danger small o_mailpro_row_problem"
                                   invisible="not sign_in_problem"/>
                            <field name="can_sign_in" invisible="1"/>
                            <button name="action_sign_in" type="object"
                                    string="Sign In" class="btn-secondary btn-sm text-nowrap"
                                    invisible="not can_sign_in"/>
                            <!-- The only way from an IMAP mailbox to its password. -->
                            <button name="action_open_account" type="object"
                                    string="Edit Server Login" class="btn-link btn-sm"
                                    invisible="provider != 'imap'"/>
                        </div>
                        <!-- The value says how it runs; a problem is a red
                             word next to it. The only run button lives on the
                             Sync page (Run Now). -->
                        <label for="sync_value" string="Sync" invisible="not id"/>
                        <div class="o_mailpro_row_sync d-flex align-items-center gap-2" invisible="not id">
                            <field name="sync_value" readonly="1" nolabel="1" class="w-auto text-muted"/>
                            <field name="sync_problem" readonly="1" nolabel="1"
                                   class="w-auto text-danger small o_mailpro_row_problem"
                                   invisible="not sync_problem"/>
                            <button name="action_open_sync" type="object" string="Open"
                                    class="btn-link btn-sm"/>
                        </div>
                        <label for="issue_text" string="Issues" invisible="not id"/>
                        <div class="o_mailpro_row_issues d-flex align-items-center gap-2" invisible="not id">
                            <field name="issue_count" invisible="1"/>
                            <field name="issue_text" readonly="1" nolabel="1"
                                   decoration-danger="issue_count &gt; 0"
                                   class="w-auto small"/>
                            <button name="action_open_issues" type="object" string="Open"
                                    class="btn-link btn-sm" invisible="not issue_count"/>
                        </div>
                    </group>

                    <group string="Advanced" groups="base.group_no_one">
                        <field name="address_kind" string="Kind" readonly="1"/>
                        <field name="last_check_date" string="Last Checked" readonly="1"/>
                        <field name="access_checked_date" string="Access Checked" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- The Sync page (the Mail Pro canvas, 06 and 07): the same mailbox in
         its second form, opened from the mailbox's Sync row. Settings, the
         switch, and the runs; the chatter beside it. -->
    <record id="view_pan_mail_mailbox_sync_form" model="ir.ui.view">
        <field name="name">pan.mail.mailbox.sync.form</field>
        <field name="model">pan.mail.mailbox</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Sync" class="o_mailpro_mailbox_sync" create="false" delete="false">
                <sheet>
                                        <group string="Settings" class="o_mailpro_sync_settings">
                        <field name="sync_level" string="Sync Level"/>
                        <!-- Routing is always a row. Replies follow their
                             conversation whatever is set here; from Known
                             Contacts on, a new conversation goes to the team
                             picked, or to the sender's contact. -->
                        <label for="alias_id" string="Routing"/>
                        <div class="d-flex align-items-center gap-2">
                            <span class="text-muted"
                                  invisible="sync_level in ('contacts', 'everyone')">Replies follow their conversation</span>
                            <field class="w-auto" name="alias_id" nolabel="1"
                                   invisible="sync_level not in ('contacts', 'everyone')"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   placeholder="Sender's Contact"/>
                        </div>
                        <field name="sync_start_date" string="Import From"/>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="sync_level != 'everyone'">
                        Every new sender becomes a contact in Odoo, newsletters included.
                    </div>
                    <group string="Sync">
                        <label for="sync_enabled" string="Sync"/>
                        <div class="d-flex align-items-center gap-2">
                            <field class="w-auto" name="sync_enabled" widget="boolean_toggle" nolabel="1"
                                  />
                            <field class="w-auto" name="sync_status" widget="badge" nolabel="1" 
                                   decoration-success="sync_status == 'syncing'"
                                   decoration-danger="sync_status in ('failing', 'stopped')"
                                   decoration-muted="sync_status in ('not_checked', 'off')"/>
                        </div>
                    </group>
                    <group string="Runs">
                        <label for="last_run_text" string="Last Run"/>
                        <div class="d-flex align-items-center gap-2">
                            <field class="w-auto" name="last_run_text" readonly="1" nolabel="1"/>
                            <button name="action_open_runs" type="object" string="Open"
                                    class="btn-link btn-sm"/>
                        </div>
                        <label for="next_run" string="Next Run"/>
                        <div class="d-flex align-items-center gap-2">
                            <field class="w-auto" name="next_run" readonly="1" nolabel="1"/>
                            <button name="action_sync_now" type="object" string="Run Now"
                                    class="btn-secondary btn-sm text-nowrap"/>
                        </div>
                        <label for="routing_log_count" string="Mail Log"/>
                        <div class="d-flex align-items-center gap-2">
                            <field class="w-auto" name="routing_log_count" readonly="1" nolabel="1"/>
                            <button name="action_open_routing_log" type="object" string="Open"
                                    class="btn-link btn-sm"/>
                        </div>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_pan_mail_mailbox" model="ir.actions.act_window">
        <field name="name">Mailboxes</field>
        <field name="res_model">pan.mail.mailbox</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first mailbox
            </p>
            <p>
                A mailbox is an email address Mail Pro sends and receives on.
            </p>
        </field>
    </record>

    <!--
        Mailbox Manager, not only the system administrator: the ACL gives that
        group write on `pan.mail.mailbox`, and `action_sync_now` is gated
        on it, so an admin-only menu meant the only people allowed to press
        Try again could not reach the form it is on. Credentials stay administrator-only: Email Accounts and
        Providers keep `base.group_system`.
    -->
    <!-- Menu: Settings → Technical → Email → Mailboxes -->
    <menuitem id="menu_pan_mail_mailbox"
              name="Mailboxes"
              parent="pan_mail_pro.menu_pan_mail_root"
              action="action_pan_mail_mailbox"
              sequence="20"
              groups="pan_mail_pro.group_mail_mailbox_manager"/>

</odoo>
