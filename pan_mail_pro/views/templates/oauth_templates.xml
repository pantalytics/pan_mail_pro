<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- OAuth Result Template -->
    <template id="oauth_result" name="Microsoft OAuth Result">
        <html>
            <head>
                <title t-out="title"/>
                <style>
                    body {
                        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        min-height: 100vh;
                        margin: 0;
                        background-color: #f8f9fa;
                    }
                    .container {
                        text-align: center;
                        padding: 40px;
                    }
                    .icon {
                        font-size: 64px;
                        margin-bottom: 20px;
                    }
                    .icon.success { color: #28a745; }
                    .icon.error { color: #dc3545; }
                    .title {
                        font-size: 24px;
                        font-weight: 600;
                        color: #1a1a1a;
                        margin-bottom: 12px;
                    }
                    .message {
                        color: #5a6169;
                        font-size: 15px;
                        margin-bottom: 24px;
                        max-width: 400px;
                    }
                    .hint {
                        color: #5c6570;
                        font-size: 14px;
                    }
                    .next {
                        margin-bottom: 24px;
                    }
                    .button {
                        display: inline-block;
                        padding: 8px 16px;
                        border-radius: 4px;
                        background-color: #714b67;
                        color: #ffffff;
                        text-decoration: none;
                        font-weight: 600;
                    }
                </style>
            </head>
            <body>
                <div class="container">
                    <div t-attf-class="icon #{success and 'success' or 'error'}">
                        <t t-if="success">&#10003;</t>
                        <t t-else="">&#10007;</t>
                    </div>
                    <div class="title" t-out="title"/>
                    <div class="message" t-out="message"/>
                    <!-- One next step when the round has one: approving the
                         app for the organization, or connecting after that
                         approval. -->
                    <div class="next" t-if="action_url">
                        <a class="button" t-att-href="action_url" t-out="action_label"/>
                    </div>
                    <t t-if="success">
                        <!-- Opened in a tab of its own (the own app
                             registration), this page reloads the Odoo tab
                             behind it and can be closed. Opened in the same
                             tab (the Pantalytics app), there is nothing
                             behind it, so it leads back instead of ending. -->
                        <div class="hint" id="o_mailpro_oauth_back"><a href="/odoo">Back to Odoo</a></div>
                        <script>
                            if (window.opener) {
                                window.opener.location.reload();
                                document.getElementById('o_mailpro_oauth_back').textContent = 'You can close this tab.';
                            }
                        </script>
                    </t>
                    <t t-else="">
                        <!-- No timed redirect: the provider's reason is the
                             one thing on this page worth reading, and three
                             seconds is not enough to read or copy it. -->
                        <div class="hint"><a href="/odoo">Back to Odoo</a></div>
                    </t>
                </div>
            </body>
        </html>
    </template>
</odoo>
