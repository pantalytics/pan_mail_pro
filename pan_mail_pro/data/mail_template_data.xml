<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        "Connect your mailbox" invitation.

        Sent by an admin from the setup checklist to everyone who has not
        authorized their account yet. The link goes to /mail_pro/connect, which
        drops the user straight on their provider's consent screen instead of
        asking them to find a button in their preferences.
    -->
    <record id="mail_template_connect_mailbox" model="mail.template">
        <field name="name">Mail Pro: Connect Your Mailbox</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="subject">Connect your mailbox to {{ object.company_id.name }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="description">Asks a user to authorize their email account so they can send from Odoo</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px; font-size: 13px;">
                <p>Hello <t t-out="object.name or ''">Colleague</t>,</p>
                <p>
                    <t t-out="object.company_id.name or ''">Your company</t> now sends and
                    receives email from Odoo through your own mailbox. Connect your account
                    once and everything you send from Odoo goes out from your own address.
                </p>
                <div style="margin: 16px 0px;">
                    <a t-attf-href="{{ object.get_base_url() }}/mail_pro/connect"
                       style="background-color: #714B67; padding: 8px 16px; text-decoration: none;
                              color: #fff; border-radius: 5px; display: inline-block;">
                        Connect my mailbox
                    </a>
                </div>
                <p style="color: #888888; font-size: 12px;">
                    You will be asked to sign in with your email account and approve access.
                    Odoo stores no password — only a token you can revoke at any time.
                </p>
            </div>
        </field>
    </record>
</odoo>
