<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pan_mail_pro.SyncLevelField">
        <div class="o_mailpro_sync_level" t-att-data-level="this.props.record.data[this.props.name]">
            <div class="o_mailpro_sync_slider">
                <!-- Odoo's own range: the arrows move it, the theme draws its
                     focus ring. The full label is what a screen reader says. -->
                <input type="range" class="form-range o_mailpro_sync_range"
                       t-att-id="this.props.id or this.id"
                       min="0" t-att-max="this.max" step="1"
                       t-att-value="this.index"
                       t-attf-style="--mailpro-fill: {{ this.position(this.index) * 100 }}%"
                       t-att-aria-valuetext="this.valueText"
                       t-att-disabled="this.props.readonly"
                       t-on-input="this.onInput"/>
                <!-- Each name sits under its own stop and never wraps. -->
                <div class="o_mailpro_sync_stops">
                    <t t-foreach="this.stops" t-as="stop" t-key="stop_index">
                        <button type="button" tabindex="-1"
                                class="o_mailpro_sync_stop"
                                t-att-class="{'o_mailpro_sync_stop_on': stop_index === this.index}"
                                t-att-data-stop="stop_index"
                                t-attf-style="--mailpro-stop: {{ this.position(stop_index) }}"
                                t-att-disabled="this.props.readonly"
                                t-on-click="(ev) => this.choose(+ev.currentTarget.dataset.stop)"
                                t-esc="stop"/>
                    </t>
                </div>
            </div>

            <table class="o_mailpro_sync_grid">
                <thead>
                    <tr>
                        <td/>
                        <th scope="col" class="o_mailpro_sync_col">
                            <i class="fa fa-envelope-o" aria-hidden="true"/>
                            <span>Your mail app</span>
                        </th>
                        <th scope="col" class="o_mailpro_sync_col">
                            <i class="fa fa-file-text-o" aria-hidden="true"/>
                            <span>Odoo record</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="this.rows" t-as="row" t-key="row_index">
                        <tr class="o_mailpro_sync_row"
                            t-att-class="{'o_mailpro_sync_flash': this.state.flash.includes(row_index)}"
                            t-att-data-row="row_index">
                            <th scope="row" class="o_mailpro_sync_what">
                                <span t-esc="row.name"/>
                                <button type="button" class="o_mailpro_sync_info"
                                        t-att-aria-expanded="this.state.open[row_index] ? 'true' : 'false'"
                                        t-att-aria-controls="this.id + '_detail_' + row_index"
                                        t-att-aria-label="row.name"
                                        t-on-click="(ev) => this.toggle(+ev.currentTarget.closest('tr').dataset.row)">i</button>
                                <div class="o_mailpro_sync_detail text-muted"
                                     t-att-id="this.id + '_detail_' + row_index"
                                     t-if="this.state.open[row_index]"
                                     t-esc="row.detail"/>
                            </th>
                            <td class="o_mailpro_sync_cell o_mailpro_sync_app">
                                <span class="o_mailpro_sync_mark o_mailpro_sync_on" role="img"
                                      aria-label="Yes"><i class="fa fa-check" aria-hidden="true"/></span>
                            </td>
                            <td class="o_mailpro_sync_cell o_mailpro_sync_odoo">
                                <span t-if="this.inOdoo(row)" class="o_mailpro_sync_mark o_mailpro_sync_on"
                                      role="img" aria-label="Yes"><i class="fa fa-check" aria-hidden="true"/></span>
                                <span t-else="" class="o_mailpro_sync_mark o_mailpro_sync_off"
                                      role="img" aria-label="No"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>
    </t>
</templates>
