<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Beside New, while the list is empty and something can be suggested. -->
    <t t-name="pan_mail_pro.DomainListButtons">
        <button t-if="suggested" type="button"
                class="btn btn-secondary o_mailpro_add_suggested"
                t-on-click="() => this.onAddSuggested()">
            Add <t t-esc="suggested"/>
        </button>
    </t>

</templates>
