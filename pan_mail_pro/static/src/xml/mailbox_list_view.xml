<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Add Back button to the list view layout-buttons slot -->
    <t t-name="pan_mail_pro.MailboxListButtons">
        <button type="button" class="btn btn-secondary" t-on-click="() => this.onBackToSettings()">
            <i class="fa fa-arrow-left me-1" title="Back"/>Back
        </button>
        <!-- While a personal mailbox carries the system email, on Microsoft
             365 (#387). Show me only when its file slot holds a recording. -->
        <a t-if="hint.url" t-att-href="hint.url" target="_blank" rel="noopener"
           class="btn btn-secondary o_mailpro_create_shared">Create a shared mailbox</a>
        <a t-if="hint.url and hint.show_me" t-att-href="hint.show_me" target="_blank" rel="noopener"
           class="btn btn-link o_mailpro_show_me">Show me</a>
    </t>

</templates>
