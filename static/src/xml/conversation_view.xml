<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Four panes: where you are, what is waiting, the conversation, the
        record. Content carries the screen; the chrome stays out of the way.
        Progressive disclosure: the rail holds the mailbox and its folders and
        nothing else, our own states filter the list one pane over, the
        routing diagnostic stays folded until somebody asks, and everything
        else is one click deeper on the record itself.

        Every pane is a region with a name, and everything clickable is a
        button. A div with a click handler is invisible to a keyboard and to a
        screen reader, and this screen is somebody's whole working day. The
        dividers are controls too: a separator you can drag, arrow-key, and
        fold with Enter.
    -->
    <t t-name="pan_mail_pro.ConversationView">
        <div class="o_content o_mailpro_conversation d-flex flex-column h-100">

            <!--
                No title here: the control panel above already says Mail Pro /
                Inbox, and saying it twice is chrome competing with content.
            -->
            <div class="o_mailpro_topbar d-flex align-items-center justify-content-end gap-2">
                <input type="search" id="o_mailpro_search"
                       class="o_mailpro_search form-control form-control-sm"
                       aria-label="Search people and subjects"
                       placeholder="Vandermolen, offerte..."
                       t-on-keyup="(ev) => this.onSearch(ev)"/>
            </div>

            <div t-if="state.error" class="o_mailpro_error d-flex align-items-center gap-2" role="alert">
                <span t-esc="state.error"/>
                <button class="btn btn-sm btn-link p-0" t-on-click="() => this.refresh()">Try again</button>
            </div>

            <div class="o_mailpro_panes d-flex flex-grow-1"
                 t-att-class="{'o_mailpro_zoomed': panes.state.zoom}">

                <!--
                    1. where you are: the mailbox, and inside it the folder.
                    The same shape as every mail client, because reading mail
                    is the one job people already know the layout of. Every
                    mailbox folds away the way Outlook folds an account: the
                    chevron opens and closes it, the name opens the mailbox
                    itself. A folded mailbox is not counted, so a rail of six
                    accounts costs what the ones you actually watch cost.
                -->
                <nav t-if="!panes.state.collapsed.rail and !panes.state.zoom" class="o_mailpro_rail"
                     aria-label="Mailboxes and folders"
                     t-attf-style="flex-basis: {{panes.state.rail}}px">
                    <t t-foreach="state.mailboxes" t-as="mailbox" t-key="mailbox.id">
                        <div class="o_mailpro_mailbox_row d-flex align-items-center">
                            <button type="button" class="o_mailpro_mailbox_toggle flex-shrink-0"
                                    t-att-aria-expanded="isExpanded(mailbox.id) ? 'true' : 'false'"
                                    t-attf-aria-label="{{ isExpanded(mailbox.id) ? 'Hide folders of' : 'Show folders of' }} {{ mailbox.email }}"
                                    t-on-click="() => this.toggleMailbox(mailbox.id)">
                                <i class="fa" aria-hidden="true"
                                   t-att-class="isExpanded(mailbox.id) ? 'fa-caret-down' : 'fa-caret-right'"/>
                            </button>
                            <button type="button"
                                    class="o_mailpro_mailbox d-flex align-items-center gap-2"
                                    t-att-class="{ 'o_mailpro_mailbox_active': mailbox.id === state.mailboxId }"
                                    t-att-aria-current="mailbox.id === state.mailboxId ? 'true' : undefined"
                                    t-on-click="() => this.setMailbox(mailbox.id)">
                                <span class="o_mailpro_mailbox_name text-truncate" t-esc="mailbox.email"/>
                            </button>
                        </div>
                        <div t-if="isExpanded(mailbox.id)" class="o_mailpro_folders">
                            <t t-set="railMailbox" t-value="mailbox.id"/>
                            <t t-call="pan_mail_pro.ConversationFolders"/>
                        </div>
                    </t>
                    <!-- No mailbox configured yet: the folders are still the
                         reader's own mail, so the rail is not empty. -->
                    <div t-if="!state.mailboxes.length" class="o_mailpro_folders">
                        <t t-set="railMailbox" t-value="false"/>
                        <t t-call="pan_mail_pro.ConversationFolders"/>
                    </div>
                </nav>

                <t t-set="divider" t-value="'rail'"/>
                <t t-call="pan_mail_pro.PaneSplitter"/>

                <!-- 2. what is waiting -->
                <div t-if="!panes.state.zoom" class="o_mailpro_list" role="region" aria-label="Conversations"
                     t-attf-style="flex-basis: {{panes.state.list}}px">

                    <!--
                        The states that are ours, as a filter row over the
                        list rather than as folders in the rail. A folder is
                        a place mail is and the provider decides what those
                        are; "needs reply" is a question we ask about it.
                        A second click clears the filter.
                    -->
                    <div t-if="filters.length" class="o_mailpro_filters d-flex align-items-center gap-1 flex-wrap"
                         role="group" aria-label="Filter conversations">
                        <button t-foreach="filters" t-as="pill" t-key="pill.id"
                                type="button" class="o_mailpro_filter"
                                t-att-class="{ 'o_mailpro_filter_active': state.filter === pill.id }"
                                t-att-aria-pressed="state.filter === pill.id ? 'true' : 'false'"
                                t-on-click="() => this.setFilter(pill.id)">
                            <span class="o_mailpro_filter_label" t-esc="pill.name"/>
                            <span t-if="pill.count" class="o_mailpro_count" t-esc="folderCount(pill)"/>
                        </button>
                    </div>
                    <t t-if="state.loading and !state.conversations.length">
                        <div class="o_mailpro_skeleton" aria-hidden="true">
                            <div class="o_mailpro_skeleton_row" t-foreach="[1, 2, 3, 4, 5]" t-as="row" t-key="row"/>
                        </div>
                        <span class="visually-hidden" role="status">Loading conversations</span>
                    </t>
                    <t t-elif="!state.conversations.length">
                        <!-- An empty search is not an empty folder: "new
                             mail appears here" would say the mail does not
                             exist, when it may be one mailbox over. -->
                        <div t-if="state.search" class="o_mailpro_empty">
                            <h3 class="o_mailpro_empty_title">Nothing matches "<t t-esc="state.search"/>" in <t t-esc="listLabel"/>.</h3>
                            <p class="o_mailpro_empty_text">
                                The search covers this mailbox. Try another one, or clear it.
                            </p>
                        </div>
                        <div t-else="" class="o_mailpro_empty">
                            <h3 class="o_mailpro_empty_title">Nothing in <t t-esc="listLabel"/> yet.</h3>
                            <p class="o_mailpro_empty_text">
                                New mail appears here as it arrives.
                            </p>
                        </div>
                    </t>
                    <t t-else="">
                        <button t-foreach="state.conversations" t-as="conversation"
                                t-key="conversation.message_id"
                                type="button"
                                class="o_mailpro_item"
                                t-att-class="{
                                    'o_mailpro_item_active': state.selected
                                        and sameConversation(conversation, state.selected),
                                    'o_mailpro_item_unread': conversation.unread }"
                                t-att-aria-current="state.selected and sameConversation(conversation, state.selected) ? 'true' : undefined"
                                t-on-click="() => this.select(conversation)">
                            <span t-if="conversation.unread" class="visually-hidden">Unread. </span>
                            <!--
                                The contact's own picture, the way every mail
                                client draws a list: you find the conversation
                                you want by who it is with, before you read a
                                word. A partner without a photo gets Odoo's own
                                letter circle; a sender who is nobody in the
                                database gets initials from the name on the
                                mail.
                            -->
                            <div class="d-flex align-items-start gap-2">
                                <img t-if="conversation.partner_id" class="o_mailpro_avatar flex-shrink-0"
                                     alt="" t-att-src="partnerAvatar(conversation)"/>
                                <span t-else="" class="o_mailpro_avatar o_mailpro_avatar_text flex-shrink-0"
                                      aria-hidden="true" t-esc="initials(conversation.correspondent)"/>
                                <span class="flex-grow-1 min-w-0">
                                    <span class="d-flex justify-content-between align-items-baseline gap-2">
                                        <span class="o_mailpro_from text-truncate" t-esc="conversation.correspondent"/>
                                        <span class="o_mailpro_date" t-att-title="fullDate(conversation.date)"
                                              t-esc="day(conversation.date)"/>
                                    </span>
                                    <span class="o_mailpro_subject d-block text-truncate" t-esc="conversation.subject"/>
                                    <span class="o_mailpro_preview d-block text-truncate" t-esc="conversation.preview"/>
                                    <span class="o_mailpro_meta d-flex align-items-center gap-2">
                                        <span t-if="conversation.record_name" class="o_mailpro_chip text-truncate"
                                              t-esc="conversation.record_name"/>
                                        <span class="o_mailpro_muted" t-esc="messageCount(conversation.count)"/>
                                        <span t-if="conversation.waiting_on_us" class="o_mailpro_chip_warn">Needs reply</span>
                                    </span>
                                </span>
                            </div>
                        </button>
                        <div t-if="state.hasMore" class="o_mailpro_more">
                            <button type="button" class="btn btn-link btn-sm"
                                    t-on-click="() => this.loadMore()">Load more</button>
                        </div>
                    </t>
                </div>

                <t t-set="divider" t-value="'list'"/>
                <t t-call="pan_mail_pro.PaneSplitter"/>

                <!-- 3. the conversation -->
                <div t-if="!panes.state.zoom" class="o_mailpro_thread" role="region" aria-label="Conversation">
                    <t t-if="state.selected">
                        <div class="o_mailpro_thread_head">
                            <div class="d-flex align-items-start justify-content-between gap-3">
                                <div class="min-w-0">
                                    <h2 class="o_mailpro_thread_title" t-esc="state.selected.subject"/>
                                    <div class="o_mailpro_thread_sub">
                                        <span t-esc="state.selected.correspondent"/>
                                        <span t-if="state.thread.messages.length > 1">
                                            &#183; <t t-esc="messageCount(state.thread.messages.length)"/>
                                        </span>
                                    </div>
                                </div>
                                <!--
                                    One primary action per screen. This is it,
                                    and while a reply is open it is Send: the
                                    button does not move, it changes what it
                                    does. Log note sits beside Reply and quiet,
                                    because the record pane no longer carries a
                                    chatter and a note has to be writable
                                    somewhere.
                                -->
                                <div t-if="state.selected.model and !composer.state.open"
                                     class="d-flex align-items-center gap-2 flex-shrink-0">
                                    <button type="button" class="btn btn-link btn-sm"
                                            t-on-click="() => this.logNote()">Log note</button>
                                    <button type="button" class="btn btn-primary btn-sm"
                                            t-on-click="() => this.reply()">Reply</button>
                                </div>
                                <div t-if="composer.state.open"
                                     class="d-flex align-items-center gap-2 flex-shrink-0">
                                    <button type="button" class="btn btn-link btn-sm"
                                            t-on-click="() => composer.close()">Discard</button>
                                    <!-- Same button, and it says what it will
                                         do: a note is logged, a reply is sent. -->
                                    <button type="button" class="btn btn-primary btn-sm"
                                            t-att-disabled="composer.state.sending"
                                            t-on-click="() => composer.send()">
                                        <t t-if="composer.state.mode === 'note'">Log</t>
                                        <t t-else="">Send</t>
                                    </button>
                                </div>
                            </div>
                            <div t-if="state.thread.records.length" class="o_mailpro_chips d-flex align-items-center gap-2">
                                <span class="o_mailpro_label">Linked to</span>
                                <button t-foreach="state.thread.records" t-as="chip"
                                        t-key="chip.model + '-' + chip.res_id"
                                        type="button"
                                        class="o_mailpro_chip_button"
                                        t-on-click="() => this.openRecordChip(chip)">
                                    <span t-esc="chip.name"/>
                                </button>
                                <!-- Secondary, and deliberately quiet: a
                                     correctly linked thread is the normal case
                                     and this is the exception next to it. -->
                                <button t-if="state.linkTargets.length" type="button"
                                        class="btn btn-link btn-sm p-0 o_mailpro_relink_toggle"
                                        t-att-aria-expanded="state.linking ? 'true' : 'false'"
                                        t-on-click="() => state.linking = !state.linking">
                                    <t t-if="state.linking">Cancel</t>
                                    <t t-else="">Change</t>
                                </button>
                            </div>
                            <!--
                                The suggestion is its own block, outside the
                                unlinked one, because the case it matters most
                                in is not "linked to nothing" but "linked to
                                the contact": delivered, and to a place nobody is
                                looking. A thread with a real record never
                                carries one, because the server only records
                                a suggestion when the mail went somewhere else.

                                One suggestion, never a list. Five
                                possibilities hand the matching back to the
                                reader; one asks them to confirm or ignore,
                                which is a decision made in a second. The
                                number behind it stays in the routing log, one
                                level deeper.
                            -->
                            <div t-if="state.thread.suggestion"
                                 class="o_mailpro_suggestion d-flex align-items-center flex-wrap gap-2">
                                <span class="o_mailpro_suggestion_text">
                                    Looks like
                                    <strong t-esc="state.thread.suggestion.name"/>
                                </span>
                                <span class="o_mailpro_muted" t-esc="state.thread.suggestion.reason"/>
                                <button type="button" class="btn btn-secondary btn-sm"
                                        t-on-click="() => this.acceptSuggestion()">Link it here</button>
                            </div>
                            <div t-if="!state.thread.records.length" class="o_mailpro_unlinked">
                                <div class="d-flex align-items-center justify-content-between gap-2">
                                    <span class="o_mailpro_unlinked_title">Not linked to a record yet.</span>
                                    <button t-if="state.thread.rejected.length"
                                            type="button" class="btn btn-link btn-sm p-0"
                                            t-att-aria-expanded="state.showRejected ? 'true' : 'false'"
                                            t-on-click="() => state.showRejected = !state.showRejected">
                                        <t t-if="state.showRejected">Hide why</t>
                                        <t t-else="">Why?</t>
                                    </button>
                                </div>
                                <ul t-if="state.showRejected" class="o_mailpro_unlinked_list">
                                    <li t-foreach="state.thread.rejected" t-as="row" t-key="row.id">
                                        <span t-esc="row.rule_label"/>: <span t-esc="row.reason"/>
                                    </li>
                                </ul>
                            </div>
                            <div t-if="state.selected and state.linkTargets.length and !state.thread.records.length"
                                 class="o_mailpro_relink_open">
                                <button type="button" class="btn btn-link btn-sm p-0"
                                        t-att-aria-expanded="state.linking ? 'true' : 'false'"
                                        t-on-click="() => state.linking = !state.linking">
                                    <t t-if="state.linking">Cancel</t>
                                    <t t-else="">Link to a record</t>
                                </button>
                            </div>
                            <!--
                                The model first, the record second. A single
                                picker over every model in the database would
                                be a search box that answers with four hundred
                                technical names; two short steps are the same
                                two decisions, asked in the order somebody
                                already has them.
                            -->
                            <div t-if="state.linking" class="o_mailpro_relink d-flex align-items-center flex-wrap gap-2"
                                 role="group" aria-label="Link this conversation to">
                                <span class="o_mailpro_label">Link to</span>
                                <button t-foreach="state.linkTargets" t-as="target" t-key="target.model"
                                        type="button" class="o_mailpro_chip_button"
                                        t-on-click="() => this.pickTarget(target)">
                                    <span t-esc="target.label"/>
                                </button>
                            </div>
                            <!--
                                Four readings of one conversation, one strip.
                                This is what the record pane's chatter used to
                                carry: the notes, the record's own events, the
                                files and the follow-ups. A count is drawn
                                only when there is one.
                            -->
                            <div t-if="!composer.state.open"
                                 class="o_mailpro_tabs d-flex align-items-center gap-1" role="tablist"
                                 aria-label="What to read about this conversation">
                                <button t-foreach="TABS" t-as="tab" t-key="tab.id"
                                        type="button" role="tab"
                                        class="o_mailpro_tab"
                                        t-att-class="{ 'o_mailpro_tab_active': state.tab === tab.id }"
                                        t-att-aria-selected="state.tab === tab.id ? 'true' : 'false'"
                                        t-on-click="() => this.setTab(tab.id)">
                                    <span t-esc="tab.label"/>
                                    <span t-if="tabCount(tab.id)" class="o_mailpro_tab_count"
                                          t-esc="tabCount(tab.id)"/>
                                </button>
                            </div>
                        </div>
                        <!--
                            The thread is a stack, the way every mail client
                            draws one: the message you came for is open and
                            the history above it is one line each. A thread of
                            nine mails that opens nine full bodies is a page
                            you have to scroll to find the end of, and the end
                            is the only part anybody reads first.

                            The header is the toggle and it is a button, so
                            the whole history is reachable with a keyboard.
                        -->
                        <!--
                            Answering happens where the mail is. The composer
                            takes this pane instead of a dialog over the
                            screen, so the list, the record and the mail being
                            answered all stay readable while somebody writes.
                            It is Odoo's own composer form; `use_composer.js`
                            says what mounting it here costs.
                        -->
                        <div t-if="composer.state.open" class="o_mailpro_composer"
                             role="region" aria-label="Reply">
                            <ComposerForm t-props="composer.formProps"/>
                        </div>
                        <t t-elif="state.tab === 'files'">
                            <t t-call="pan_mail_pro.ConversationFiles"/>
                        </t>
                        <t t-elif="state.tab === 'activities'">
                            <t t-call="pan_mail_pro.ConversationActivities"/>
                        </t>
                        <div t-else="" class="o_mailpro_messages">
                            <t t-foreach="state.thread.messages" t-as="message" t-key="message.id">
                            <!--
                                A record event is one line, never a card:
                                "Stage: New to Qualified" is the whole message,
                                and forty of them as cards is a page you
                                scroll past to reach the mail.
                            -->
                            <div t-if="message.kind === 'event'" class="o_mailpro_event d-flex justify-content-between gap-2">
                                <span class="min-w-0">
                                    <t t-if="message.tracking.length">
                                        <span t-foreach="message.tracking" t-as="change" t-key="change.field"
                                              class="o_mailpro_event_change">
                                            <t t-esc="change.field"/>: <t t-esc="change.old or '-'"/>
                                            &#8594; <t t-esc="change.new or '-'"/>
                                        </span>
                                    </t>
                                    <t t-else=""><span t-esc="message.subject or message.author"/></t>
                                </span>
                                <span class="o_mailpro_date flex-shrink-0" t-att-title="fullDate(message.date)"
                                      t-esc="day(message.date)"/>
                            </div>
                            <article t-else=""
                                     class="o_mailpro_message"
                                     t-att-class="{
                                        'o_mailpro_message_open': isOpen(message),
                                        'o_mailpro_message_note': message.kind === 'note' }">
                                <button type="button" class="o_mailpro_message_head d-flex gap-2 w-100"
                                        t-att-aria-expanded="isOpen(message) ? 'true' : 'false'"
                                        t-on-click="() => this.toggleMessage(message)">
                                    <img t-if="message.author_id" class="o_mailpro_avatar flex-shrink-0"
                                         alt="" t-att-src="avatar(message)"/>
                                    <span t-else="" class="o_mailpro_avatar o_mailpro_avatar_text flex-shrink-0"
                                          aria-hidden="true" t-esc="initials(message.author)"/>
                                    <span class="o_mailpro_message_lines flex-grow-1 min-w-0">
                                        <span class="d-flex justify-content-between align-items-baseline gap-2">
                                            <span class="min-w-0 d-flex align-items-baseline gap-2">
                                                <span class="o_mailpro_message_from text-truncate"
                                                      t-esc="message.author"/>
                                                <!-- The one thing that must never be
                                                     mistaken for a mail to the customer. -->
                                                <span t-if="message.kind === 'note'"
                                                      class="o_mailpro_note_tag flex-shrink-0">Internal note</span>
                                            </span>
                                            <span class="o_mailpro_date" t-att-title="fullDate(message.date)"
                                                  t-esc="day(message.date)"/>
                                        </span>
                                        <span t-if="!isOpen(message)"
                                              class="o_mailpro_message_snippet d-block text-truncate"
                                              t-esc="snippet(message)"/>
                                        <span t-elif="message.recipients or message.cc"
                                              class="o_mailpro_muted d-block text-truncate"
                                              t-esc="recipientLine(message)"/>
                                    </span>
                                </button>
                                <t t-if="isOpen(message)">
                                    <div class="o_mailpro_body" t-out="visibleBody(message)"/>
                                    <div t-if="hasQuote(message)" class="o_mailpro_quote_block">
                                        <button type="button" class="o_mailpro_quote_toggle"
                                                aria-label="Quoted history"
                                                t-att-aria-expanded="state.quotes[message.id] ? 'true' : 'false'"
                                                t-on-click="() => this.toggleQuote(message)">&#8230;</button>
                                        <div t-if="state.quotes[message.id]" class="o_mailpro_quote"
                                             t-out="quotedBody(message)"/>
                                    </div>
                                </t>
                            </article>
                            </t>
                        </div>
                    </t>
                    <div t-else="" class="o_mailpro_empty">
                        <h3 class="o_mailpro_empty_title">Pick a conversation.</h3>
                    </div>
                </div>

                <t t-set="divider" t-value="'record'"/>
                <t t-call="pan_mail_pro.PaneSplitter"/>

                <!-- 4. the record: the pane a mail client cannot have -->
                <div t-if="!panes.state.collapsed.record or panes.state.zoom" class="o_mailpro_record"
                     role="region" aria-label="Record"
                     t-attf-style="flex-basis: {{panes.state.record}}px">
                    <RecordPane t-if="selectedRecord" record="selectedRecord"
                                zoomed="panes.state.zoom"
                                zoomLabel="panes.zoomLabel()"
                                onToggleZoom.bind="() => panes.toggleZoom()"/>
                    <div t-else="" class="o_mailpro_empty">
                        <h3 class="o_mailpro_empty_title">No record yet.</h3>
                        <p class="o_mailpro_empty_text">Link this conversation and it appears here.</p>
                        <!-- Zoom hides the way back with the rest of the
                             screen, so the way back comes along. -->
                        <button t-if="panes.state.zoom" type="button"
                                class="btn btn-secondary btn-sm"
                                t-on-click="() => panes.toggleZoom()">Back to the Inbox</button>
                    </div>
                </div>

            </div>
        </div>
    </t>

    <!--
        The folders of one mailbox, `railMailbox`. One definition, two call
        sites. A folder is only the open one when its mailbox is the open one:
        two unfolded mailboxes must not both claim to be showing Inbox.
    -->
    <t t-name="pan_mail_pro.ConversationFolders">
        <t t-set="isOpenMailbox" t-value="(railMailbox or false) === (state.mailboxId or false)"/>
        <button t-foreach="foldersFor(railMailbox)" t-as="folder" t-key="folder.id"
                type="button"
                class="o_mailpro_folder d-flex align-items-center justify-content-between"
                t-att-class="{ 'o_mailpro_folder_active': isOpenMailbox and folder.id === state.folder }"
                t-att-aria-current="isOpenMailbox and folder.id === state.folder ? 'true' : undefined"
                t-on-click="() => this.setFolder(folder.id, railMailbox or null)">
            <span t-esc="folder.name"/>
            <span t-if="folder.count" class="o_mailpro_count" t-esc="folderCount(folder)"/>
        </button>
    </t>

    <!--
        The files of a conversation. Every attachment on it, newest first,
        which is the list the chatter's paperclip used to hold. A row is a
        link and not a preview: what people do here is open the quote they
        were sent, and a gallery is a second screen to maintain.
    -->
    <t t-name="pan_mail_pro.ConversationFiles">
        <div class="o_mailpro_files">
            <t t-if="state.thread.files.length">
                <a t-foreach="state.thread.files" t-as="file" t-key="file.id"
                   class="o_mailpro_file d-flex align-items-center justify-content-between gap-2"
                   t-att-href="fileUrl(file)" t-att-title="file.name">
                    <span class="o_mailpro_file_name text-truncate" t-esc="file.name"/>
                    <span class="o_mailpro_muted flex-shrink-0">
                        <t t-esc="fileSize(file.size)"/> &#183; <t t-esc="day(file.date)"/>
                    </span>
                </a>
            </t>
            <div t-else="" class="o_mailpro_empty">
                <h3 class="o_mailpro_empty_title">No files on this conversation.</h3>
                <p class="o_mailpro_empty_text">Attachments on its mail and its notes appear here.</p>
            </div>
        </div>
    </t>

    <!--
        The follow-ups. `mail.activity` on the records this conversation
        touched, scheduled through Odoo's own wizard so it lands in the
        Activities clock the rest of the database reads.
    -->
    <t t-name="pan_mail_pro.ConversationActivities">
        <div class="o_mailpro_activities">
            <div t-if="selectedRecord" class="o_mailpro_activities_head">
                <button type="button" class="btn btn-secondary btn-sm"
                        t-on-click="() => this.scheduleActivity()">Schedule</button>
            </div>
            <t t-if="state.thread.activities.length">
                <button t-foreach="state.thread.activities" t-as="activity" t-key="activity.id"
                        type="button" class="o_mailpro_activity"
                        t-att-class="{ 'o_mailpro_activity_late': activity.state === 'overdue' }"
                        t-on-click="() => this.openActivityRecord(activity)">
                    <span class="d-flex justify-content-between align-items-baseline gap-2">
                        <span class="o_mailpro_activity_summary text-truncate" t-esc="activity.summary"/>
                        <span class="o_mailpro_date flex-shrink-0" t-esc="activity.deadline"/>
                    </span>
                    <span class="o_mailpro_muted d-block text-truncate">
                        <t t-esc="activity.user"/><t t-if="activity.record_name"> &#183; <t t-esc="activity.record_name"/></t>
                    </span>
                </button>
            </t>
            <div t-else="" class="o_mailpro_empty">
                <h3 class="o_mailpro_empty_title">Nothing scheduled.</h3>
                <p class="o_mailpro_empty_text">A follow-up with a date on it lives on the record.</p>
            </div>
        </div>
    </t>

    <!--
        One divider, three call sites. It is a separator with a value, so a
        screen reader reads a width rather than a decoration, and the chevron
        is a real button: the fold has to be reachable without a mouse and
        without knowing that double-click resets.
    -->
    <t t-name="pan_mail_pro.PaneSplitter">
        <div t-if="!panes.state.zoom" class="o_mailpro_split"
             t-att-class="'o_mailpro_split_' + divider
                          + (panes.state.collapsed[divider] ? ' o_mailpro_split_folded' : '')"
             role="separator" aria-orientation="vertical" tabindex="0"
             t-att-aria-label="panes.label(divider)"
             t-att-aria-valuenow="panes.state.collapsed[divider] ? 0 : panes.state[divider]"
             t-att-aria-valuemin="panes.panes[divider].min"
             t-att-aria-valuemax="panes.panes[divider].max"
             t-on-pointerdown="(ev) => panes.startDrag(divider, ev)"
             t-on-keydown="(ev) => panes.onKey(divider, ev)"
             t-on-dblclick="() => panes.reset(divider)">
            <button t-if="panes.collapsible(divider)" type="button"
                    class="o_mailpro_split_toggle"
                    t-att-aria-label="panes.toggleLabel(divider)"
                    t-att-aria-expanded="panes.state.collapsed[divider] ? 'false' : 'true'"
                    t-on-pointerdown.stop="() => {}"
                    t-on-dblclick.stop="() => {}"
                    t-on-click.stop="() => panes.toggle(divider)">
                <i class="fa" t-att-class="panes.chevron(divider)" aria-hidden="true"/>
            </button>
        </div>
    </t>

    <!--
        The composer, one component deep so the env mail's composer form needs
        stops at it rather than reaching the record pane. See use_composer.js.
    -->
    <t t-name="pan_mail_pro.ComposerForm">
        <View t-props="props.viewProps"/>
    </t>

    <t t-name="pan_mail_pro.RecordPane">
        <div class="o_mailpro_record_inner h-100">
            <t t-if="!state.failed">
                <!--
                    The form's own control panel is off, so the pane says which
                    record this is and offers the one action that leaves the
                    screen. Everything else you can do to it, you do below.
                -->
<div class="o_mailpro_record_head d-flex align-items-center justify-content-between gap-2"
                     t-on-dblclick="() => this.props.onToggleZoom()">
                    <div class="min-w-0">
                        <div class="o_mailpro_label" t-esc="props.record.model_label"/>
                        <h2 class="o_mailpro_record_name text-truncate" t-esc="props.record.name"/>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                        <!--
                            The record on the whole screen while you read it.
                            Quiet, because Open is still the action that
                            leaves; this one only moves a divider.
                        -->
                        <button type="button" class="btn btn-link btn-sm o_mailpro_record_zoom"
                                t-att-title="props.zoomLabel"
                                t-att-aria-pressed="props.zoomed ? 'true' : 'false'"
                                t-on-click="() => this.props.onToggleZoom()">
                            <i class="fa" aria-hidden="true"
                               t-att-class="props.zoomed ? 'fa-compress' : 'fa-expand'"/>
                            <span class="visually-hidden" t-esc="props.zoomLabel"/>
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm"
                                t-on-click="() => this.openRecord()">Open</button>
                    </div>
                </div>
                <View t-props="viewProps"/>
            </t>
            <div t-else="" class="o_mailpro_empty">
                <h3 class="o_mailpro_empty_title" t-esc="props.record.name"/>
                <p class="o_mailpro_empty_text">This record could not be shown here.</p>
                <button type="button" class="btn btn-secondary btn-sm"
                        t-on-click="() => this.openRecord()">Open</button>
            </div>
        </div>
    </t>

</templates>
