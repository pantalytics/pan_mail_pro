<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Four panes: where you are, what is waiting, the conversation, the
        record. Content carries the screen; the chrome stays out of the way.
        Progressive disclosure: the folder rail holds the six states that earn
        a line, everything else is one click deeper on the record itself.
    -->
    <t t-name="pan_mail_pro.ConversationView">
        <div class="o_content o_mailpro_conversation d-flex flex-column h-100">

            <!--
                No title here: the control panel above already says Mail Pro /
                Inbox, and saying it twice is chrome competing with content.
            -->
            <div class="o_mailpro_topbar d-flex align-items-center justify-content-end">
                <div class="d-flex align-items-center gap-2">
                    <select class="o_mailpro_select form-select form-select-sm"
                            aria-label="Mailbox" t-on-change="(ev) => this.setMailbox(ev)">
                        <option t-foreach="state.mailboxes" t-as="mailbox" t-key="mailbox.id"
                                t-att-value="mailbox.id" t-esc="mailbox.email"/>
                    </select>
                    <input type="search" class="o_mailpro_search form-control form-control-sm"
                           placeholder="Search people and subjects"
                           t-on-keyup="(ev) => this.onSearch(ev)"/>
                </div>
            </div>

            <div t-if="state.error" class="o_mailpro_error d-flex align-items-center gap-2">
                <span>That did not load. Nothing was changed.</span>
                <button class="btn btn-sm btn-link p-0" t-on-click="() => this.refresh()">Try again</button>
            </div>

            <div class="o_mailpro_panes d-flex flex-grow-1">

                <!-- 1. where you are -->
                <div class="o_mailpro_rail">
                    <div t-foreach="state.folders" t-as="folder" t-key="folder.id"
                         class="o_mailpro_folder d-flex align-items-center justify-content-between"
                         t-att-class="{ 'o_mailpro_folder_active': folder.id === state.folder }"
                         t-on-click="() => this.setFolder(folder.id)">
                        <span t-esc="folder.name"/>
                        <span t-if="folder.count" class="o_mailpro_count" t-esc="folder.count"/>
                    </div>
                </div>

                <!-- 2. what is waiting -->
                <div class="o_mailpro_list">
                    <div t-if="state.loading" class="o_mailpro_skeleton">
                        <div class="o_mailpro_skeleton_row" t-foreach="[1, 2, 3, 4, 5]" t-as="row" t-key="row"/>
                    </div>
                    <t t-elif="!state.conversations.length">
                        <div class="o_mailpro_empty">
                            <p class="o_mailpro_empty_title">Nothing in <t t-esc="folderLabel(state.folder)"/>.</p>
                            <p class="o_mailpro_empty_text">
                                Mail lands here once a mailbox is receiving.
                            </p>
                        </div>
                    </t>
                    <t t-else="">
                        <div t-foreach="state.conversations" t-as="conversation"
                             t-key="conversation.model + '-' + conversation.res_id"
                             class="o_mailpro_item"
                             t-att-class="{
                                'o_mailpro_item_active': state.selected
                                    and state.selected.model === conversation.model
                                    and state.selected.res_id === conversation.res_id,
                                'o_mailpro_item_unread': conversation.unread }"
                             t-on-click="() => this.select(conversation)">
                            <div class="d-flex justify-content-between align-items-baseline gap-2">
                                <span class="o_mailpro_from text-truncate" t-esc="conversation.correspondent"/>
                                <span class="o_mailpro_date" t-esc="day(conversation.date)"/>
                            </div>
                            <div class="o_mailpro_subject text-truncate" t-esc="conversation.subject"/>
                            <div class="o_mailpro_preview text-truncate" t-esc="conversation.preview"/>
                            <div class="o_mailpro_meta d-flex align-items-center gap-2">
                                <span t-if="conversation.record_name" class="o_mailpro_chip"
                                      t-esc="conversation.record_name"/>
                                <span class="o_mailpro_muted" t-esc="conversation.count + ' messages'"/>
                                <span t-if="conversation.waiting_on_us" class="o_mailpro_chip_warn">Needs reply</span>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- 3. the conversation -->
                <div class="o_mailpro_thread">
                    <t t-if="state.selected">
                        <div class="o_mailpro_thread_head">
                            <div class="d-flex align-items-start justify-content-between gap-3">
                                <div class="min-w-0">
                                    <h2 class="o_mailpro_thread_title" t-esc="state.selected.subject"/>
                                    <div class="o_mailpro_thread_sub" t-esc="state.selected.correspondent"/>
                                </div>
                                <!-- One primary action per screen. This is it. -->
                                <button class="btn btn-primary btn-sm flex-shrink-0"
                                        t-on-click="() => this.reply()">Reply</button>
                            </div>
                            <div t-if="state.thread.records.length" class="o_mailpro_chips d-flex align-items-center gap-2">
                                <span class="o_mailpro_label">Filed on</span>
                                <button t-foreach="state.thread.records" t-as="chip"
                                        t-key="chip.model + '-' + chip.res_id"
                                        class="o_mailpro_chip_button"
                                        t-on-click="() => this.openRecordChip(chip)">
                                    <span t-esc="chip.name"/>
                                </button>
                            </div>
                            <div t-if="!state.thread.records.length and state.thread.rejected.length"
                                 class="o_mailpro_unfiled">
                                <p class="o_mailpro_unfiled_title">Not filed on a record yet.</p>
                                <ul class="o_mailpro_unfiled_list">
                                    <li t-foreach="state.thread.rejected" t-as="row" t-key="row.id">
                                        <span t-esc="row.rule"/>: <span t-esc="row.reason"/>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="o_mailpro_messages">
                            <div t-foreach="state.thread.messages" t-as="message" t-key="message.id"
                                 class="o_mailpro_message">
                                <div class="d-flex justify-content-between align-items-baseline gap-2">
                                    <span class="o_mailpro_message_from" t-esc="message.author"/>
                                    <span class="o_mailpro_date" t-esc="day(message.date)"/>
                                </div>
                                <div t-if="message.recipients.length" class="o_mailpro_muted"
                                     t-esc="'to ' + message.recipients.join(', ')"/>
                                <div class="o_mailpro_body" t-out="body(message)"/>
                            </div>
                        </div>
                    </t>
                    <div t-else="" class="o_mailpro_empty">
                        <p class="o_mailpro_empty_title">Pick a conversation.</p>
                    </div>
                </div>

                <!-- 4. the record: the pane a mail client cannot have -->
                <div class="o_mailpro_record">
                    <RecordPane t-if="selectedRecord" record="selectedRecord"/>
                    <div t-else="" class="o_mailpro_empty">
                        <p class="o_mailpro_empty_title">No record yet.</p>
                        <p class="o_mailpro_empty_text">File this conversation and it appears here.</p>
                    </div>
                </div>

            </div>
        </div>
    </t>

    <t t-name="pan_mail_pro.RecordPane">
        <div class="o_mailpro_record_inner h-100">
            <t t-if="!state.failed">
                <!--
                    The form's own control panel is off, so the pane says which
                    record this is and offers the one action that leaves the
                    screen. Everything else you can do to it, you do below.
                -->
                <div class="o_mailpro_record_head d-flex align-items-center justify-content-between gap-2">
                    <div class="min-w-0">
                        <div class="o_mailpro_label" t-esc="props.record.model_label"/>
                        <div class="o_mailpro_record_name text-truncate" t-esc="props.record.name"/>
                    </div>
                    <button class="btn btn-secondary btn-sm" t-on-click="() => this.openRecord()">Open</button>
                </div>
                <View t-props="viewProps"/>
            </t>
            <div t-else="" class="o_mailpro_empty">
                <p class="o_mailpro_empty_title" t-esc="props.record.name"/>
                <p class="o_mailpro_empty_text">This record could not be shown here.</p>
                <button class="btn btn-primary btn-sm" t-on-click="() => this.openRecord()">Open it</button>
            </div>
        </div>
    </t>

</templates>
