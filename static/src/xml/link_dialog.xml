<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Step one of two: the kind of record, as a search box over a short
        list. Step two is Odoo's own record picker, so it has no template
        here.
    -->
    <t t-name="pan_mail_pro.LinkDialog">
        <Dialog size="'md'" title="title" footer="false" contentClass="'o_mailpro_link_dialog'">
            <input type="text" class="form-control o_mailpro_link_search"
                   t-ref="search" autofocus="autofocus"
                   placeholder="Search for a kind of record..."
                   t-on-input="onSearch"/>
            <ul class="o_mailpro_link_list">
                <li t-foreach="state.rows" t-as="row" t-key="row.model">
                    <button type="button" class="o_mailpro_link_row"
                            t-on-click="() => this.choose(row)">
                        <!-- The app's tile, where the model has one: the same
                             tile the Linked-to chips wear. The slot stays
                             when it has not, so the labels line up. -->
                        <span class="o_mailpro_link_icon">
                            <img t-if="row.icon" t-att-src="row.icon" alt=""/>
                        </span>
                        <t t-esc="row.label"/>
                    </button>
                </li>
            </ul>
            <p t-if="!state.rows.length and !state.loading" class="o_mailpro_link_empty">
                <t t-if="state.search">Nothing matches that.</t>
                <t t-else="">Nothing to link to here.</t>
            </p>
        </Dialog>
    </t>

</templates>
