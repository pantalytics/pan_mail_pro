<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Step one only: which kind of record. Step two is Odoo's own
        SelectCreateDialog, which this one opens and then closes itself.
    -->
    <t t-name="pan_mail_pro.LinkDialog">
        <Dialog size="'md'" title="title" footer="false" contentClass="'o_mailpro_link_dialog'">
            <input type="text" class="form-control o_mailpro_link_search"
                   t-ref="search" autofocus="autofocus"
                   placeholder="Search for a kind of record..."
                   t-on-input="onSearch"/>
            <ul class="o_mailpro_link_list">
                <li t-foreach="state.rows" t-as="entry" t-key="entry.key">
                    <button type="button" class="o_mailpro_link_row"
                            t-on-click="() => this.choose(entry)">
                        <img t-if="entry.icon" class="o_mailpro_link_icon"
                             t-att-src="entry.icon" t-att-alt="entry.label"/>
                        <span t-esc="entry.label"/>
                    </button>
                </li>
            </ul>
            <p t-if="!state.rows.length and !state.loading" class="o_mailpro_link_empty">
                <t t-if="state.search">Nothing matches that.</t>
                <t t-else="">Nothing to link to here.</t>
            </p>
        </Dialog>
    </t>

</templates>
