<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pan_mail_pro.ProviderVerifyDialog">
        <Dialog title="props.label" size="'md'">
            <div class="o_mailpro_provider_verify">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i t-if="state.phase === 'connecting'" class="fa fa-circle-o-notch fa-spin"/>
                    <i t-else="" class="fa fa-check text-success"/>
                    <span t-att-class="{'text-muted': state.phase !== 'connecting'}">
                        Connecting to <t t-esc="props.label"/>
                    </span>
                </div>
                <div class="d-flex align-items-center gap-2 mb-2"
                     t-if="state.phase !== 'connecting' and state.phase !== 'unverifiable'">
                    <i t-if="state.phase === 'verifying'" class="fa fa-circle-o-notch fa-spin"/>
                    <i t-elif="state.phase === 'verified'" class="fa fa-check text-success"/>
                    <i t-else="" class="fa fa-times text-danger"/>
                    <span t-att-class="{'text-muted': state.phase !== 'verifying'}">Verifying credentials</span>
                </div>
                <div t-if="!busy" class="mt-3" t-att-class="{
                        'alert alert-danger mb-0': state.phase === 'rejected',
                        'text-muted': state.phase !== 'rejected'}"
                     t-esc="state.message"/>
            </div>
            <t t-set-slot="footer">
                <t t-if="state.phase === 'verified' or state.phase === 'unverifiable'">
                    <button class="btn btn-primary" t-on-click="signIn">Sign in</button>
                    <button class="btn btn-secondary" t-on-click="props.close">Later</button>
                </t>
                <button t-elif="state.phase === 'rejected'" class="btn btn-primary"
                        t-on-click="props.close">OK</button>
                <button t-else="" class="btn btn-secondary" disabled="disabled">Verifying</button>
            </t>
        </Dialog>
    </t>
</templates>
