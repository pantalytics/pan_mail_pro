<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- OAuth Result Template -->
    <template id="oauth_result" name="Microsoft OAuth Result">
        <html>
            <head>
                <title t-out="title"/>
                <style>
                    body {
                        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        min-height: 100vh;
                        margin: 0;
                        background-color: #f8f9fa;
                    }
                    .container {
                        text-align: center;
                        padding: 40px;
                    }
                    .icon {
                        font-size: 64px;
                        margin-bottom: 20px;
                    }
                    .icon.success { color: #28a745; }
                    .icon.error { color: #dc3545; }
                    .title {
                        font-size: 24px;
                        font-weight: 600;
                        color: #1a1a1a;
                        margin-bottom: 12px;
                    }
                    .message {
                        color: #5a6169;
                        font-size: 15px;
                        margin-bottom: 24px;
                        max-width: 400px;
                    }
                    .hint {
                        color: #5c6570;
                        font-size: 14px;
                    }
                </style>
            </head>
            <body>
                <div class="container">
                    <div t-attf-class="icon #{success and 'success' or 'error'}">
                        <t t-if="success">&#10003;</t>
                        <t t-else="">&#10007;</t>
                    </div>
                    <div class="title" t-out="title"/>
                    <div class="message" t-out="message"/>
                    <t t-if="success">
                        <div class="hint">You can close this tab.</div>
                        <script>
                            // Reload the Odoo tab to show updated status
                            if (window.opener) {
                                window.opener.location.reload();
                            }
                        </script>
                    </t>
                    <t t-else="">
                        <!-- No timed redirect: the provider's reason is the
                             one thing on this page worth reading, and three
                             seconds is not enough to read or copy it. -->
                        <div class="hint"><a href="/odoo">Back to Odoo</a></div>
                    </t>
                </div>
            </body>
        </html>
    </template>
</odoo>
