<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_microsoft_mailbox_list" model="ir.ui.view">
        <field name="name">x_microsoft.mailbox.list</field>
        <field name="model">x_microsoft.mailbox</field>
        <field name="arch" type="xml">
            <list string="Microsoft Mailboxes" js_class="mailbox_list"
                  decoration-danger="x_health_status == 'error'"
                  decoration-warning="x_health_status == 'warning'">
                <field name="sequence" widget="handle"/>
                <field name="email"/>
                <field name="x_mailbox_type" string="Type"/>
                <field name="x_owner_user_id" string="Owner" optional="show"/>
                <field name="x_sync_mode" string="Sync"/>
                <field name="x_health_status" string="Health" widget="badge"
                       decoration-success="x_health_status == 'healthy'"
                       decoration-warning="x_health_status == 'warning'"
                       decoration-danger="x_health_status == 'error'"/>
                <field name="x_last_sync_date" string="Last Sync" optional="show"/>
                <field name="x_error_message" string="Error" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_microsoft_mailbox_form" model="ir.ui.view">
        <field name="name">x_microsoft.mailbox.form</field>
        <field name="model">x_microsoft.mailbox</field>
        <field name="arch" type="xml">
            <form string="Microsoft Mailbox">
                <sheet>
                    <group>
                        <group>
                            <field name="email" placeholder="e.g., support@company.com" string="Email Address"/>
                            <field name="x_mailbox_type" string="Mailbox Type" widget="radio"/>
                        </group>
                    </group>

                    <!-- Owner -->
                    <group>
                        <group>
                            <field name="x_owner_user_id" string="Owner"
                                   required="x_mailbox_type in ('personal', 'notification') or (x_mailbox_type == 'shared' and x_sync_mode != 'none')"/>
                        </group>
                    </group>
                    <div class="text-muted mb-3" invisible="x_mailbox_type != 'shared'">
                        For sync, the Owner's Microsoft account reads this mailbox. For sending, each user sends with their own account.
                    </div>

                    <!-- Help text based on mailbox type -->
                    <div class="alert alert-info mb-3" role="alert" invisible="x_mailbox_type != 'personal'">
                        <strong>Personal Mailbox:</strong> This mailbox belongs to the owner specified above.
                        Only the owner can see and send from this mailbox in the composer dropdown.
                    </div>
                    <div class="alert alert-info mb-3" role="alert" invisible="x_mailbox_type != 'shared'">
                        <strong>Shared Mailbox:</strong> All users can send from this mailbox using their own Microsoft account.
                        Each user needs Mail.ReadWrite.Shared permission and "Send As" rights on this mailbox in Microsoft 365.
                    </div>
                    <div class="alert alert-warning mb-3" role="alert" invisible="x_mailbox_type != 'notification'">
                        <strong>Notification Mailbox:</strong> Used for system notifications to internal users (outgoing only).
                        Only one notification mailbox can be active. The owner's Microsoft account will be used to send.
                    </div>

                    <!-- Email Sync (hidden for notification mailboxes - outgoing only) -->
                    <separator string="Email Sync" invisible="x_mailbox_type == 'notification'"/>

                    <group invisible="x_mailbox_type == 'notification'">
                        <group>
                            <field name="x_sync_mode" string="Sync Mode" widget="radio"/>
                        </group>
                    </group>

                    <div class="text-muted mb-3" invisible="x_mailbox_type == 'notification' or x_sync_mode == 'none'">
                        Only emails from contacts that already exist in Odoo will be synced. Internal users and unknown senders are skipped.
                    </div>

                    <div class="d-flex align-items-center gap-3 mb-3" invisible="x_mailbox_type == 'notification' or x_sync_mode == 'none'">
                        <button name="action_sync_now"
                                string="Sync Now"
                                type="object"
                                class="btn-primary"
                                icon="fa-refresh"/>
                        <span class="text-muted" invisible="not x_last_sync_date">
                            Last synced: <field name="x_last_sync_date" readonly="1" nolabel="1"/>
                        </span>
                    </div>

                    <div class="alert alert-danger mb-3" role="alert" invisible="x_mailbox_type == 'notification' or state != 'error'">
                        <strong>Sync failed:</strong> <field name="x_error_message" nolabel="1" readonly="1"/>
                    </div>

                    <!-- Hidden fields -->
                    <field name="state" invisible="1"/>
                    <field name="x_incoming_enabled" invisible="1"/>
                    <field name="x_incoming_user_id" invisible="1"/>
                    <field name="x_sync_inbox" invisible="1"/>
                    <field name="x_sync_sent" invisible="1"/>
                    <field name="x_create_activity" invisible="1"/>
                    <field name="x_activity_user_id" invisible="1"/>
                    <field name="active" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_microsoft_mailbox" model="ir.actions.act_window">
        <field name="name">Microsoft Mailboxes</field>
        <field name="res_model">x_microsoft.mailbox</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first Microsoft mailbox
            </p>
            <p>
                Add the email addresses of Microsoft 365 mailboxes that users can send from.<br/>
                These can be personal mailboxes, shared mailboxes, or group mailboxes.<br/>
                <br/>
                <strong>Note:</strong> Users must have "Send As" permissions in Microsoft 365 for these mailboxes.
            </p>
        </field>
    </record>

</odoo>
