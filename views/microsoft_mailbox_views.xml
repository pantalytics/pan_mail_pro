<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_microsoft_mailbox_list" model="ir.ui.view">
        <field name="name">x_microsoft.mailbox.list</field>
        <field name="model">x_microsoft.mailbox</field>
        <field name="arch" type="xml">
            <list string="Microsoft Mailboxes" js_class="mailbox_list"
                  decoration-danger="x_health_status == 'error'"
                  decoration-warning="x_health_status == 'warning'">
                <field name="sequence" widget="handle"/>
                <field name="email" string="Email"/>
                <field name="x_mailbox_type" string="Type"/>
                <field name="x_owner_user_id" string="Owner" optional="show"/>
                <field name="x_incoming_sync" string="Sync" optional="show"/>
                <field name="x_health_status" string="Status" widget="badge"
                       decoration-success="x_health_status == 'healthy'"
                       decoration-warning="x_health_status == 'warning'"
                       decoration-danger="x_health_status == 'error'"/>
                <field name="x_last_sync_date" string="Last Synced" optional="show"/>
                <field name="x_error_message" string="Error" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_microsoft_mailbox_form" model="ir.ui.view">
        <field name="name">x_microsoft.mailbox.form</field>
        <field name="model">x_microsoft.mailbox</field>
        <field name="arch" type="xml">
            <form string="Microsoft Mailbox">
                <sheet>
                    <!-- SECTION 1: MAILBOX -->
                    <group string="Mailbox">
                        <group>
                            <field name="email" placeholder="support@company.com"/>
                            <field name="x_mailbox_type" widget="radio" string="Type"/>
                            <field name="x_owner_user_id"
                                   required="x_mailbox_type in ('personal', 'notification') or x_incoming_sync"/>
                        </group>
                        <group>
                            <!-- Type explanations -->
                            <div class="text-muted" invisible="x_mailbox_type != 'personal'">
                                Only the owner can send from this mailbox.
                            </div>
                            <div class="text-muted" invisible="x_mailbox_type != 'shared'">
                                All users can send using their own Microsoft account.
                            </div>
                            <div class="text-muted" invisible="x_mailbox_type != 'notification'">
                                For system emails. The owner's account is used to send.
                            </div>
                        </group>
                    </group>

                    <!-- SECTION 2: INCOMING EMAIL (not for notification) -->
                    <group string="Incoming Email" invisible="x_mailbox_type == 'notification'">
                        <group>
                            <field name="x_incoming_sync" string="Enable Sync" widget="boolean_toggle"/>
                            <field name="x_exclude_internal" widget="boolean_toggle"
                                   invisible="not x_incoming_sync"/>
                            <field name="x_sync_start_date"
                                   invisible="not x_incoming_sync or x_last_sync_date"/>
                        </group>
                        <group>
                            <div class="text-muted" invisible="not x_incoming_sync">
                                <span invisible="x_last_sync_date">
                                    Set "Import From" to sync historical emails.
                                </span>
                                <span invisible="not x_last_sync_date">
                                    Last synced: <field name="x_last_sync_date" readonly="1" class="d-inline"/>
                                </span>
                            </div>
                        </group>
                    </group>

                    <!-- SECTION 3: ROUTING (only when sync enabled) -->
                    <group string="Routing" invisible="x_mailbox_type == 'notification' or not x_incoming_sync">
                        <group>
                            <field name="x_routing_smart" widget="boolean_toggle"/>
                            <field name="x_route_to_team" widget="boolean_toggle"
                                   invisible="x_routing_smart"/>
                            <field name="x_alias_id" string="Team"
                                   invisible="x_routing_smart or not x_route_to_team"
                                   required="x_route_to_team and not x_routing_smart"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   placeholder="Select team..."/>
                        </group>
                        <group>
                            <div class="text-muted"
                                 invisible="x_routing_smart or x_route_to_team">
                                Emails will be posted to the sender's contact record.
                            </div>
                            <div class="alert alert-warning mb-0" role="alert"
                                 invisible="not x_routing_smart">
                                AI routing coming soon. Currently defaults to CRM Lead.
                            </div>
                        </group>
                    </group>

                    <!-- SECTION 4: UNKNOWN SENDERS (only when sync enabled) -->
                    <group string="Unknown Senders" invisible="x_mailbox_type == 'notification' or not x_incoming_sync">
                        <group>
                            <field name="x_sync_unknown_contacts" string="Include" widget="boolean_toggle"/>
                            <field name="x_queue_unknown_contacts" widget="boolean_toggle"
                                   invisible="not x_sync_unknown_contacts"/>
                        </group>
                        <group>
                            <div class="text-muted" invisible="x_sync_unknown_contacts">
                                Only sync emails from existing contacts.
                            </div>
                            <div class="text-muted" invisible="not x_sync_unknown_contacts or x_queue_unknown_contacts">
                                Auto-create new contacts for unknown senders.
                            </div>
                            <div class="alert alert-warning mb-0" role="alert"
                                 invisible="not x_sync_unknown_contacts or not x_queue_unknown_contacts">
                                Queue for review not yet available. Unknown senders will be skipped.
                            </div>
                        </group>
                    </group>

                    <!-- SYNC BUTTON -->
                    <group invisible="x_mailbox_type == 'notification' or not x_incoming_sync">
                        <group>
                            <button name="action_sync_now" string="Sync Now"
                                    type="object" class="btn-primary" icon="fa-refresh"/>
                        </group>
                        <group/>
                    </group>

                    <!-- Error alert -->
                    <div class="alert alert-danger" role="alert" invisible="state != 'error'">
                        <strong>Sync failed:</strong> <field name="x_error_message" nolabel="1" readonly="1"/>
                    </div>

                    <!-- Hidden fields -->
                    <field name="state" invisible="1"/>
                    <field name="x_sync_mode" invisible="1"/>
                    <field name="x_incoming_enabled" invisible="1"/>
                    <field name="x_incoming_user_id" invisible="1"/>
                    <field name="x_sync_inbox" invisible="1"/>
                    <field name="x_sync_sent" invisible="1"/>
                    <field name="x_create_activity" invisible="1"/>
                    <field name="x_activity_user_id" invisible="1"/>
                    <field name="active" invisible="1"/>
                    <field name="x_health_status" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_microsoft_mailbox" model="ir.actions.act_window">
        <field name="name">Mailboxes</field>
        <field name="res_model">x_microsoft.mailbox</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first mailbox
            </p>
            <p>
                Configure mailboxes for sending and receiving email via Microsoft 365.
            </p>
        </field>
    </record>

    <!-- Menu: Settings → Technical → Email → Microsoft Mailboxes -->
    <menuitem id="menu_microsoft_mailbox"
              name="Microsoft Mailboxes"
              parent="base.menu_email"
              action="action_microsoft_mailbox"
              sequence="5"
              groups="base.group_system"/>

</odoo>
