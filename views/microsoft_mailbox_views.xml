<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_microsoft_mailbox_list" model="ir.ui.view">
        <field name="name">x_microsoft.mailbox.list</field>
        <field name="model">x_microsoft.mailbox</field>
        <field name="arch" type="xml">
            <list string="Microsoft Mailboxes" js_class="mailbox_list"
                  decoration-danger="x_health_status == 'error'"
                  decoration-warning="x_health_status == 'warning'">
                <field name="sequence" widget="handle"/>
                <field name="email"/>
                <field name="x_mailbox_type" string="Type"/>
                <field name="x_owner_user_id" string="Owner" optional="show"/>
                <field name="x_health_status" string="Health" widget="badge"
                       decoration-success="x_health_status == 'healthy'"
                       decoration-warning="x_health_status == 'warning'"
                       decoration-danger="x_health_status == 'error'"/>
                <field name="x_last_sync_date" string="Last Sync" optional="show"/>
                <field name="x_error_message" string="Error" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View - Clean Apple-style layout -->
    <record id="view_microsoft_mailbox_form" model="ir.ui.view">
        <field name="name">x_microsoft.mailbox.form</field>
        <field name="model">x_microsoft.mailbox</field>
        <field name="arch" type="xml">
            <form string="Microsoft Mailbox">
                <sheet>
                    <!-- SECTION 1: MAILBOX -->
                    <group string="Mailbox">
                        <group>
                            <field name="email" placeholder="support@company.com"/>
                            <field name="x_mailbox_type" widget="radio"/>
                            <field name="x_owner_user_id"
                                   required="x_mailbox_type in ('personal', 'notification') or x_incoming_sync"/>
                        </group>
                        <group>
                            <!-- Empty for layout -->
                        </group>
                    </group>

                    <!-- Help text per type -->
                    <div class="text-muted mb-4" invisible="x_mailbox_type != 'personal'">
                        Only the owner can send from this mailbox.
                    </div>
                    <div class="text-muted mb-4" invisible="x_mailbox_type != 'shared'">
                        All users can send from this mailbox using their own Microsoft account.
                    </div>
                    <div class="text-muted mb-4" invisible="x_mailbox_type != 'notification'">
                        Used for system notifications. The owner's account is used to send.
                    </div>

                    <!-- SECTION 2: INCOMING EMAIL (not for notification) -->
                    <group string="Incoming Email" invisible="x_mailbox_type == 'notification'">
                        <group>
                            <field name="x_incoming_sync" widget="boolean_toggle"/>
                        </group>
                        <group/>
                    </group>

                    <!-- Routing options (only when sync enabled) -->
                    <group string="Routing" invisible="x_mailbox_type == 'notification' or not x_incoming_sync">
                        <group>
                            <field name="x_routing_smart" widget="boolean_toggle"
                                   help="AI decides where to route emails (CRM, Helpdesk, etc.)"/>
                            <field name="x_alias_id" string="Route to"
                                   invisible="x_routing_smart"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   placeholder="Select team alias..."/>
                        </group>
                        <group>
                            <field name="x_sync_unknown_contacts" widget="boolean_toggle"/>
                            <field name="x_routing_unknown_contact"
                                   invisible="not x_sync_unknown_contacts"/>
                        </group>
                    </group>

                    <!-- Info boxes for routing mode -->
                    <div class="alert alert-info" role="alert"
                         invisible="x_mailbox_type == 'notification' or not x_incoming_sync or x_routing_smart">
                        <strong>Alias Routing:</strong> Emails will be routed to the selected team/alias.
                        Teams manage their aliases in their settings (e.g., Sales Team → Alias).
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="x_mailbox_type == 'notification' or not x_incoming_sync or not x_routing_smart">
                        <strong>Smart Routing:</strong> AI-based routing coming soon. Currently defaults to CRM Lead.
                    </div>

                    <!-- Historical sync option -->
                    <group invisible="x_mailbox_type == 'notification' or not x_incoming_sync">
                        <group>
                            <field name="x_sync_start_date"
                                   invisible="x_last_sync_date"
                                   help="Import emails starting from this date"/>
                        </group>
                        <group/>
                    </group>

                    <!-- Sync status -->
                    <group invisible="x_mailbox_type == 'notification' or not x_incoming_sync">
                        <group>
                            <div class="d-flex align-items-center gap-3">
                                <button name="action_sync_now" string="Sync Now"
                                        type="object" class="btn-primary" icon="fa-refresh"/>
                                <span class="text-muted" invisible="not x_last_sync_date">
                                    Last synced: <field name="x_last_sync_date" readonly="1" nolabel="1"/>
                                </span>
                            </div>
                        </group>
                    </group>

                    <!-- Error alert -->
                    <div class="alert alert-danger" role="alert" invisible="state != 'error'">
                        <strong>Sync failed:</strong> <field name="x_error_message" nolabel="1" readonly="1"/>
                    </div>

                    <!-- Hidden fields -->
                    <field name="state" invisible="1"/>
                    <field name="x_sync_mode" invisible="1"/>
                    <field name="x_incoming_enabled" invisible="1"/>
                    <field name="x_incoming_user_id" invisible="1"/>
                    <field name="x_sync_inbox" invisible="1"/>
                    <field name="x_sync_sent" invisible="1"/>
                    <field name="x_create_activity" invisible="1"/>
                    <field name="x_activity_user_id" invisible="1"/>
                    <field name="active" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_microsoft_mailbox" model="ir.actions.act_window">
        <field name="name">Microsoft Mailboxes</field>
        <field name="res_model">x_microsoft.mailbox</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first Microsoft mailbox
            </p>
            <p>
                Configure mailboxes for sending and receiving email via Microsoft 365.
            </p>
        </field>
    </record>

</odoo>
