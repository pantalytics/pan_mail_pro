<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_microsoft_mailbox_list" model="ir.ui.view">
        <field name="name">x_microsoft.mailbox.list</field>
        <field name="model">x_microsoft.mailbox</field>
        <field name="arch" type="xml">
            <list string="Microsoft Mailboxes" js_class="mailbox_list"
                  decoration-danger="x_health_status == 'error'"
                  decoration-warning="x_health_status == 'warning'">
                <field name="sequence" widget="handle"/>
                <field name="email" string="Mailbox"/>
                <field name="x_health_status" string="Status" widget="badge"
                       decoration-success="x_health_status == 'healthy'"
                       decoration-warning="x_health_status == 'warning'"
                       decoration-danger="x_health_status == 'error'"/>
                <field name="x_mailbox_type" string="Type" optional="hide"/>
                <field name="x_provider" string="Provider" optional="hide"/>
                <field name="x_owner_user_id" string="Owner" optional="hide"/>
                <field name="x_sync_mode" string="Incoming" optional="hide"/>
                <field name="x_last_sync_date" string="Last Synced" widget="timeago" optional="hide"/>
                <field name="x_error_message" string="Error" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_microsoft_mailbox_form" model="ir.ui.view">
        <field name="name">x_microsoft.mailbox.form</field>
        <field name="model">x_microsoft.mailbox</field>
        <field name="arch" type="xml">
            <form string="Microsoft Mailbox">
                <sheet>
                    <!-- SECTION 1: MAILBOX -->
                    <group string="Mailbox">
                        <group>
                            <field name="email" placeholder="support@company.com"/>
                            <field name="x_provider"/>
                            <field name="x_health_status" string="Status" widget="badge"
                                   decoration-success="x_health_status == 'healthy'"
                                   decoration-warning="x_health_status == 'warning'"
                                   decoration-danger="x_health_status == 'error'"
                                   readonly="1"/>
                            <field name="x_mailbox_type" widget="radio" string="Type"/>
                            <field name="x_owner_user_id"
                                   required="x_mailbox_type in ('personal', 'notification')"/>
                        </group>
                        <group>
                            <!-- Type explanations -->
                            <div class="text-muted" invisible="x_mailbox_type != 'personal'">
                                Only the owner can send from this mailbox.
                            </div>
                            <div class="text-muted" invisible="x_mailbox_type != 'shared' or x_provider != 'outlook'">
                                All users can send using their own Microsoft account.
                            </div>
                            <div class="text-muted" invisible="x_mailbox_type != 'shared' or x_provider == 'outlook'">
                                All users can send from this address. It has its own
                                credentials, so it needs no owner.
                            </div>
                            <div class="text-muted" invisible="x_mailbox_type != 'notification'">
                                For system emails. The owner's account is used to send.
                            </div>
                            <div class="mt-2" invisible="x_provider != 'imap'">
                                <button name="action_open_account" type="object"
                                        string="Server Credentials" class="btn-link ps-0"
                                        icon="fa-key"/>
                                <div class="text-muted">
                                    IMAP/SMTP mailboxes are reached with a server, a login
                                    and a password rather than a consent screen.
                                </div>
                            </div>
                        </group>
                    </group>

                    <!-- SECTION 2: INCOMING EMAIL (not for notification) -->
                    <group string="Incoming Email" invisible="x_mailbox_type == 'notification'">
                        <group>
                            <field name="x_sync_mode" widget="radio"/>
                            <field name="x_exclude_internal" widget="boolean_toggle"
                                   invisible="x_sync_mode == 'none'"/>
                            <field name="x_sync_start_date"
                                   invisible="x_sync_mode == 'none'"/>
                            <field name="x_last_sync_date" readonly="1" widget="timeago"
                                   invisible="x_sync_mode == 'none' or not x_last_sync_date"/>
                        </group>
                        <group>
                            <div class="text-muted" invisible="x_sync_mode == 'none'">
                                Emails are imported from oldest to newest, up to 200 per minute. You can change "Import From" to re-sync from an earlier date — duplicates are skipped automatically.
                            </div>
                            <div class="text-muted" invisible="x_sync_mode != 'all'">
                                Senders who are not contacts yet are created automatically,
                                unless you hold them for review below.
                            </div>
                            <div class="alert alert-warning mt-2" role="alert"
                                 invisible="x_sync_mode == 'none' or x_exclude_internal">
                                <i class="fa fa-exclamation-triangle me-2" title="Warning"/>
                                Email between colleagues is synced into Odoo for this mailbox,
                                including confidential threads. Everyone with access to the record
                                can read it.
                            </div>
                        </group>
                    </group>

                    <!-- SECTION 3: ROUTING (only when sync enabled) -->
                    <group string="Routing" invisible="x_mailbox_type == 'notification' or x_sync_mode == 'none'">
                        <group>
                            <field name="x_route_to_team" widget="boolean_toggle"/>
                            <field name="x_alias_id" string="Team"
                                   invisible="not x_route_to_team"
                                   required="x_route_to_team"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   placeholder="Select team..."/>
                        </group>
                        <group>
                            <div class="text-muted" invisible="x_route_to_team">
                                Emails will be posted to the sender's contact record.
                            </div>
                        </group>
                    </group>
                    <!-- The interlock that keeps AI auto-routing off. See models/ai/. -->
                    <field name="x_routing_smart" invisible="1"/>

                    <!-- SECTION 4: REVIEW QUEUE (only when unknown senders are synced) -->
                    <group string="Review Queue" invisible="x_mailbox_type == 'notification' or x_sync_mode != 'all'">
                        <group>
                            <field name="x_queue_unknown_contacts" string="Hold for review"
                                   widget="boolean_toggle"/>
                        </group>
                        <group>
                            <div class="text-muted" invisible="not x_queue_unknown_contacts">
                                Mail from unknown senders waits in Communication →
                                Triage instead of creating a contact automatically.
                            </div>
                        </group>
                    </group>

                    <!-- SYNC BUTTON -->
                    <group invisible="x_mailbox_type == 'notification' or x_sync_mode == 'none'">
                        <group>
                            <button name="action_sync_now" string="Sync Now"
                                    type="object" class="btn-primary" icon="fa-refresh"/>
                        </group>
                        <group/>
                    </group>

                    <!-- Error alert -->
                    <div class="alert alert-danger" role="alert" invisible="state != 'error'">
                        <strong>Sync failed:</strong> <field name="x_error_message" nolabel="1" readonly="1"/>
                    </div>

                    <!-- Hidden fields -->
                    <field name="state" invisible="1"/>
                    <field name="x_sync_mode" invisible="1"/>
                    <field name="active" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_microsoft_mailbox" model="ir.actions.act_window">
        <field name="name">Mailboxes</field>
        <field name="res_model">x_microsoft.mailbox</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first mailbox
            </p>
            <p>
                Configure mailboxes for sending and receiving email via Microsoft 365.
            </p>
        </field>
    </record>

    <!-- Menu: Settings → Technical → Email → Microsoft Mailboxes -->
    <menuitem id="menu_microsoft_mailbox"
              name="Microsoft Mailboxes"
              parent="base.menu_email"
              action="action_microsoft_mailbox"
              sequence="5"
              groups="base.group_system"/>

</odoo>
