<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List: newest first, grouped by code when asked. The row is the
         diagnosis; the form below holds the traceback. -->
    <record id="view_pan_mail_error_list" model="ir.ui.view">
        <field name="name">pan.mail.error.list</field>
        <field name="model">pan.mail.error</field>
        <field name="arch" type="xml">
            <list string="Errors" create="false" edit="false"
                  decoration-muted="level == 'warning'">
                <field name="create_date" string="When"/>
                <field name="code"/>
                <field name="level" widget="badge"
                       decoration-danger="level == 'error'"
                       decoration-warning="level == 'warning'"/>
                <field name="mailbox_id"/>
                <field name="provider" optional="hide"/>
                <field name="account_id" optional="hide"/>
                <field name="user_id" optional="hide"/>
                <field name="message"/>
                <field name="flow" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_pan_mail_error_form" model="ir.ui.view">
        <field name="name">pan.mail.error.form</field>
        <field name="model">pan.mail.error</field>
        <field name="arch" type="xml">
            <form string="Error" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="code" readonly="1"/></h1>
                        <div class="text-muted"><field name="description" readonly="1"/></div>
                    </div>
                    <group>
                        <group>
                            <field name="create_date" string="When" readonly="1"/>
                            <field name="level" readonly="1"/>
                            <field name="flow" readonly="1"/>
                        </group>
                        <group>
                            <field name="mailbox_id" readonly="1"/>
                            <field name="account_id" readonly="1"/>
                            <field name="provider" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="What happened">
                        <field name="message" nolabel="1" colspan="2" readonly="1"/>
                        <field name="traceback" nolabel="1" colspan="2" readonly="1"
                               invisible="not traceback"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pan_mail_error_search" model="ir.ui.view">
        <field name="name">pan.mail.error.search</field>
        <field name="model">pan.mail.error</field>
        <field name="arch" type="xml">
            <search string="Errors">
                <field name="code"/>
                <field name="message"/>
                <field name="mailbox_id"/>
                <filter name="errors" string="Errors" domain="[('level', '=', 'error')]"/>
                <filter name="warnings" string="Warnings" domain="[('level', '=', 'warning')]"/>
                <separator/>
                <filter name="incoming" string="Incoming" domain="[('flow', '=', 'incoming')]"/>
                <filter name="outgoing" string="Outgoing" domain="[('flow', '=', 'outgoing')]"/>
                <filter name="inbox" string="Inbox" domain="[('flow', '=', 'inbox')]"/>
                <separator/>
                <filter name="today" string="Last 24 hours"
                        domain="[('create_date', '>=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_code" string="Code" context="{'group_by': 'code'}"/>
                    <filter name="group_mailbox" string="Mailbox" context="{'group_by': 'mailbox_id'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pan_mail_error" model="ir.actions.act_window">
        <field name="name">Errors</field>
        <field name="res_model">pan.mail.error</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pan_mail_error_search"/>
        <field name="context">{'search_default_group_code': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">Nothing has failed</p>
            <p>
                Every failure Mail Pro catches is recorded here for thirty
                days: a sync run that raised, a mail that could not be sent,
                a connection that was revoked, a request from the Inbox that
                failed. Open a row for the traceback. Only the code and a
                count leave this database, on the daily report to Pantalytics.
            </p>
        </field>
    </record>

    <!-- Menu: Settings → Technical → Email → Mail Pro → Errors, after Mail
         Routing, which answers "where did it go" where this answers "why did
         it not". -->
    <menuitem id="menu_pan_mail_error"
              name="Errors"
              parent="pan_mail_pro.menu_pan_mail_root"
              action="action_pan_mail_error"
              sequence="55"
              groups="pan_mail_pro.group_mail_mailbox_manager"/>

</odoo>
