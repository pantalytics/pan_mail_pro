<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend User List View for admin overview -->
    <record id="view_users_list_inherit_microsoft" model="ir.ui.view">
        <field name="name">res.users.list.inherit.microsoft</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='login']" position="after">
                <field name="x_microsoft_oauth_connected" string="MS Connected" optional="hide"/>
                <field name="x_microsoft_health_status" string="MS Health" widget="badge"
                       decoration-success="x_microsoft_health_status == 'healthy'"
                       decoration-warning="x_microsoft_health_status == 'warning'"
                       decoration-danger="x_microsoft_health_status == 'error'"
                       decoration-muted="x_microsoft_health_status == 'not_configured'"
                       optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Extend Full User Form (Settings > Users > User) -->
    <record id="view_users_form_inherit_microsoft_oauth" model="ir.ui.view">
        <field name="name">res.users.form.inherit.microsoft.oauth</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="after">
                <page string="Outlook Pro" name="outlook_pro">
                    <group string="Microsoft Account">
                        <field name="x_microsoft_oauth_connected" invisible="1"/>

                        <div colspan="2" class="text-muted mb-4">
                            Connect your Microsoft 365 account to send emails via Outlook.
                        </div>

                        <!-- Not Connected State -->
                        <div colspan="2" invisible="x_microsoft_oauth_connected">
                            <div class="mb-3">
                                <span class="badge rounded-pill text-bg-secondary fs-6 px-3 py-2">
                                    Status: Not Connected
                                </span>
                            </div>
                            <button type="object"
                                    name="action_connect_microsoft"
                                    string="Connect Microsoft 365 account"
                                    class="btn-primary"/>
                        </div>

                        <!-- Connected State -->
                        <div colspan="2" invisible="not x_microsoft_oauth_connected">
                            <div class="mb-3">
                                <span class="badge rounded-pill text-bg-success fs-6 px-3 py-2">
                                    Status: Connected
                                </span>
                            </div>
                            <button type="object"
                                    name="action_disconnect_microsoft"
                                    string="Disconnect Microsoft Account"
                                    class="btn-secondary"
                                    confirm="This will remove access to send emails via Microsoft. Are you sure?"/>
                        </div>
                    </group>

                    <group string="Email Preferences" invisible="not x_microsoft_oauth_connected">
                        <div colspan="2" class="text-muted mb-3">
                            For shared mailboxes, you need "Send As" permission in Microsoft 365.
                        </div>
                        <field name="x_microsoft_default_mailbox_id"
                               string="Default Mailbox"
                               domain="['|', ('x_mailbox_type', '=', 'shared'), '&amp;', ('x_mailbox_type', '=', 'personal'), ('x_owner_user_id', '=', id)]"
                               options="{'no_create': True, 'no_open': True}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Extend My Preferences popup (view_users_form_simple_modif) -->
    <record id="view_users_preferences_inherit_microsoft_oauth" model="ir.ui.view">
        <field name="name">res.users.preferences.inherit.microsoft.oauth</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_security']" position="after">
                <page string="Outlook Pro" name="outlook_pro">
                    <group string="Microsoft Account">
                        <field name="x_microsoft_oauth_connected" invisible="1"/>

                        <div colspan="2" class="text-muted mb-4">
                            Connect your Microsoft 365 account to send emails via Outlook.
                        </div>

                        <!-- Not Connected State -->
                        <div colspan="2" invisible="x_microsoft_oauth_connected">
                            <div class="mb-3">
                                <span class="badge rounded-pill text-bg-secondary fs-6 px-3 py-2">
                                    Status: Not Connected
                                </span>
                            </div>
                            <button type="object"
                                    name="action_connect_microsoft"
                                    string="Connect Microsoft 365 account"
                                    class="btn-primary"/>
                        </div>

                        <!-- Connected State -->
                        <div colspan="2" invisible="not x_microsoft_oauth_connected">
                            <div class="mb-3">
                                <span class="badge rounded-pill text-bg-success fs-6 px-3 py-2">
                                    Status: Connected
                                </span>
                            </div>
                            <button type="object"
                                    name="action_disconnect_microsoft"
                                    string="Disconnect Microsoft Account"
                                    class="btn-secondary"
                                    confirm="This will remove access to send emails via Microsoft. Are you sure?"/>
                        </div>
                    </group>

                    <group string="Email Preferences" invisible="not x_microsoft_oauth_connected">
                        <div colspan="2" class="text-muted mb-3">
                            For shared mailboxes, you need "Send As" permission in Microsoft 365.
                        </div>
                        <field name="x_microsoft_default_mailbox_id"
                               string="Default Mailbox"
                               domain="['|', ('x_mailbox_type', '=', 'shared'), '&amp;', ('x_mailbox_type', '=', 'personal'), ('x_owner_user_id', '=', id)]"
                               options="{'no_create': True, 'no_open': True}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
