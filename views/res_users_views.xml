<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The record ids below deliberately still say "microsoft". Renaming a view
        record does not rename it in the database: the old record survives the
        upgrade with its old arch, and Odoo validates the whole res.users
        inheritance tree at once - so a rename ships an arch referencing fields
        this release deletes, and the upgrade fails in a way nothing about the
        rename hints at. The ids are internal; the labels are what users read.
    -->

    <!-- Extend User List View for admin overview -->
    <record id="view_users_list_inherit_microsoft" model="ir.ui.view">
        <field name="name">res.users.list.inherit.microsoft</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="action_send_connect_invite" type="object"
                            string="Send Mail Pro Invite"
                            groups="base.group_system"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='login']" position="after">
                <field name="x_pan_mail_connected" string="Mailbox Connected" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Extend Full User Form (Settings > Users > User) -->
    <record id="view_users_form_inherit_microsoft_oauth" model="ir.ui.view">
        <field name="name">res.users.form.inherit.microsoft.oauth</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="after">
                <page string="Mail Pro" name="outlook_pro">
                    <field name="x_pan_mail_connected" invisible="1"/>

                    <group invisible="x_pan_mail_connected">
                        <div colspan="2">
                            <div class="text-muted mb-3">Sign in so Odoo can send and read mail on your behalf</div>
                            <button type="object"
                                    name="action_connect_mailbox"
                                    string="Connect Mailbox"
                                    class="btn-primary" icon="fa-sign-in"/>
                        </div>
                    </group>

                    <group invisible="not x_pan_mail_connected">
                        <field name="x_microsoft_default_mailbox_id"
                               string="Send from"
                               domain="['|', ('x_mailbox_type', '=', 'shared'), '&amp;', ('x_mailbox_type', '=', 'personal'), ('x_owner_user_id', '=', id)]"
                               options="{'no_create': True, 'no_open': True}"/>
                        <div colspan="2">
                            <button type="object"
                                    name="action_disconnect_mailbox"
                                    string="Disconnect"
                                    class="oe_link text-danger"
                                    confirm="Odoo will stop sending and receiving mail for this account until you connect it again."/>
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Extend My Preferences popup (view_users_form_simple_modif) -->
    <record id="view_users_preferences_inherit_microsoft_oauth" model="ir.ui.view">
        <field name="name">res.users.preferences.inherit.microsoft.oauth</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_security']" position="after">
                <page string="Mail Pro" name="outlook_pro">
                    <field name="x_pan_mail_connected" invisible="1"/>

                    <group invisible="x_pan_mail_connected">
                        <div colspan="2">
                            <div class="text-muted mb-3">Sign in so Odoo can send and read mail on your behalf</div>
                            <button type="object"
                                    name="action_connect_mailbox"
                                    string="Connect Mailbox"
                                    class="btn-primary" icon="fa-sign-in"/>
                        </div>
                    </group>

                    <group invisible="not x_pan_mail_connected">
                        <field name="x_microsoft_default_mailbox_id"
                               string="Send from"
                               domain="['|', ('x_mailbox_type', '=', 'shared'), '&amp;', ('x_mailbox_type', '=', 'personal'), ('x_owner_user_id', '=', id)]"
                               options="{'no_create': True, 'no_open': True}"/>
                        <div colspan="2">
                            <button type="object"
                                    name="action_disconnect_mailbox"
                                    string="Disconnect"
                                    class="oe_link text-danger"
                                    confirm="Odoo will stop sending and receiving mail for this account until you connect it again."/>
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
