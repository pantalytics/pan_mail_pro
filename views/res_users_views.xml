        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_security']" position="after">
                <page string="Mail Pro" name="outlook_pro">
                    <field name="x_microsoft_oauth_connected" invisible="1"/>
                    <field name="x_google_oauth_connected" invisible="1"/>

                    <!-- Microsoft: Not Connected -->
                    <group invisible="x_microsoft_oauth_connected">
                        <div colspan="2">
                            <div class="text-muted mb-3">Send emails via your Microsoft 365 account</div>
                            <button type="object"
                                    name="action_connect_microsoft"
                                    string="Connect Microsoft 365"
                                    class="btn-primary" icon="fa-windows"/>
                        </div>
                    </group>

                    <!-- Microsoft: Connected -->
                    <group invisible="not x_microsoft_oauth_connected">
                        <field name="x_microsoft_oauth_connected" widget="boolean_toggle" string="Connected"/>
                        <field name="x_microsoft_default_mailbox_id"
                               string="Send from"
                               domain="['|', ('x_mailbox_type', '=', 'shared'), '&amp;', ('x_mailbox_type', '=', 'personal'), ('x_owner_user_id', '=', id)]"
                               options="{'no_create': True, 'no_open': True}"/>
                        <button type="object"
                                name="action_disconnect_microsoft"
                                string="Disconnect Microsoft 365"
                                class="btn-secondary" icon="fa-windows"
                                confirm="Disconnect this Microsoft account? Sending and syncing via Microsoft 365 will stop for this user."/>
                    </group>

                    <!-- Google: Not Connected -->
                    <group invisible="x_google_oauth_connected">
                        <div colspan="2">
                            <div class="text-muted mb-3">Send emails via your Google account</div>
                            <button type="object"
                                    name="action_connect_google"
                                    string="Connect Google"
                                    class="btn-primary" icon="fa-google"/>
                        </div>
                    </group>

                    <!-- Google: Connected -->
                    <group invisible="not x_google_oauth_connected">
                        <field name="x_google_oauth_connected" widget="boolean_toggle" string="Google Connected"/>
