<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Renamed from *_inherit_microsoft* in 19.0.6.0.0. A view record renamed
        in XML alone survives the upgrade under its old id with its old arch,
        which then references fields this release renamed; the migration
        therefore renames the xml ids in place before the registry loads.
    -->

    <!-- Extend User List View for admin overview -->
    <record id="view_users_list_inherit_mail_pro" model="ir.ui.view">
        <field name="name">res.users.list.inherit.microsoft</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="action_send_connect_invite" type="object"
                            string="Send Mail Pro Invite"
                            groups="base.group_system"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='login']" position="after">
                <!-- The address, not a tick: an empty cell is "not connected",
                     and a filled one says which identity this user sends as,
                     which a tick never could. -->
                <field name="x_pan_mail_connected_as" string="Connected as" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Extend Full User Form (Settings > Users > User) -->
    <record id="view_users_form_inherit_mail_pro" model="ir.ui.view">
        <field name="name">res.users.form.inherit.microsoft.oauth</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="after">
                <page string="Mail Pro" name="mail_pro">
                    <field name="x_pan_mail_connected" invisible="1"/>

                    <group invisible="x_pan_mail_connected">
                        <div colspan="2">
                            <div class="text-muted mb-3">Sign in so Odoo can send and read mail on your behalf</div>
                            <button type="object"
                                    name="action_connect_mailbox"
                                    string="Connect mailbox"
                                    class="btn-primary" icon="fa-sign-in"/>
                        </div>
                    </group>

                    <!-- Three things a person owns here, in the order they
                         matter: which sign-in this is, which address it sends
                         from unless they pick another, and how much of their
                         own mailbox Odoo reads back. Section headers, rows,
                         the one destructive action red and confirmed: the
                         shape the brand guide gives a settings page
                         (brand.pantalytics.com/product-ui), in Odoo's own
                         group markup. -->
                    <group string="Connected account" invisible="not x_pan_mail_connected">
                        <label for="x_pan_mail_connected_as" string="Connected as"/>
                        <div>
                            <field name="x_pan_mail_connected_as" nolabel="1" readonly="1"
                                   class="d-inline-block"/>
                            <div class="mt-1">
                                <button type="object"
                                        name="action_disconnect_mailbox"
                                        string="Disconnect"
                                        class="btn-link p-0 text-danger"
                                        confirm="Odoo will stop sending and receiving mail for this account until you connect it again."/>
                            </div>
                        </div>
                        <field name="x_default_mailbox_id"
                               string="Default mailbox"
                               domain="['|', ('mailbox_type', '=', 'shared'), '&amp;', ('mailbox_type', '=', 'personal'), ('owner_user_id', '=', id)]"
                               options="{'no_create': True, 'no_open': True}"/>
                    </group>

                    <!-- The one mailbox setting that is the person's own.
                         Absent until the connect flow has claimed their
                         address, which it cannot before the internal domains
                         are set. -->
                    <group string="Personal mailbox"
                           invisible="not x_pan_mail_connected or not x_pan_mail_personal_mailbox_id">
                        <field name="x_pan_mail_personal_mailbox_id" string="Mailbox"
                               readonly="1" options="{'no_open': True}"/>
                        <label for="x_pan_mail_sync_level"/>
                        <div>
                            <field name="x_pan_mail_sync_level" widget="radio" nolabel="1"/>
                            <div class="alert alert-warning mt-2 mb-0" role="alert"
                                 invisible="x_pan_mail_sync_level != 'everyone'">
                                Every sender becomes a contact in Odoo, newsletters
                                and private email included. Pick this only for an
                                address that exists to hear from strangers.
                            </div>
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

