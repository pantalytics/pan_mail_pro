<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mail Pro Settings App -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.outlook.pro</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Mail Pro" name="pan_mail_pro" groups="base.group_system">
                    <!-- State the sections below hide behind. -->
                    <field name="x_provider_credentials_set" invisible="1"/>
                    <field name="x_provider_connected" invisible="1"/>
                    <field name="x_provider_uses_oauth" invisible="1"/>
                    <field name="x_setup_domains_done" invisible="1"/>
                    <field name="x_setup_notification_done" invisible="1"/>
                    <field name="x_setup_complete" invisible="1"/>

                    <!-- One status. Setup, Syncing or Attention needed — never
                         two at once, and never a stack of banners. A headline,
                         one sentence, and a dot. Everything that used to be
                         explained here is behind an info icon on the step it
                         belongs to. -->
                    <div class="o_mailpro_status">
                        <div class="o_mailpro_status_head">
                            <span class="o_mailpro_dot o_mailpro_dot--setup"
                                  invisible="x_setup_status != 'setup'"/>
                            <span class="o_mailpro_dot o_mailpro_dot--syncing"
                                  invisible="x_setup_status != 'syncing'"/>
                            <span class="o_mailpro_dot o_mailpro_dot--error"
                                  invisible="x_setup_status != 'error'"/>
                            <field name="x_setup_status" nolabel="1" readonly="1"
                                   class="o_mailpro_status_label"/>
                        </div>
                        <div class="o_mailpro_status_detail">
                            <field name="x_setup_status_detail" nolabel="1" readonly="1"/>
                        </div>
                        <div class="o_mailpro_status_note"
                             invisible="x_setup_pending_notifications == 0">
                            <field name="x_setup_pending_notifications" class="d-inline" readonly="1"/>
                            queued
                            <i class="fa fa-info-circle ms-1"
                               title="Invitations and password resets wait here until the notification mailbox works. They are sent automatically once it does — nothing is lost."/>
                        </div>
                        <div class="o_mailpro_status_note" invisible="x_setup_status != 'error'">
                            <button type="action" name="%(action_pan_mail_mailbox)d"
                                    string="Review mailboxes" icon="oi-arrow-right"
                                    class="oe_link ps-0"/>
                        </div>
                    </div>

                    <div class="o_mailpro_step" invisible="not (x_mail_provider) or x_edit_provider">
                        <i class="fa fa-check-circle o_mailpro_step_check" title="Done"/>
                        <span class="o_mailpro_step_name">1. Email Provider</span>
                        <span class="o_mailpro_step_value"><field name="x_mail_provider" nolabel="1" readonly="1"/></span>
                        <field name="x_edit_provider" nolabel="1" widget="boolean_icon"
                               options="{'icon': 'fa-pencil'}" class="o_mailpro_step_edit"/>
                    </div>
                    <!-- STEP 1 — the answer every step below depends on. -->
                    <h2 invisible="x_mail_provider and not x_edit_provider">1. Email Provider</h2>
                    <div class="row mt-3 mb-4 o_settings_container" invisible="x_mail_provider and not x_edit_provider">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Where is your email hosted?</span>
                                <i class="fa fa-info-circle text-muted ms-1"
                                   title="The setup steps differ per provider, so only one provider's steps are shown. Each keeps its own credentials, so you can switch back."/>
                                <div class="content-group mt-2">
                                    <field name="x_mail_provider" class="col-lg-8"
                                           placeholder="Search providers..."/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="o_mailpro_step" invisible="not (x_provider_credentials_set) or x_edit_credentials">
                        <i class="fa fa-check-circle o_mailpro_step_check" title="Done"/>
                        <span class="o_mailpro_step_name">2. Credentials</span>
                        <span class="o_mailpro_step_value">Configured</span>
                        <field name="x_edit_credentials" nolabel="1" widget="boolean_icon"
                               options="{'icon': 'fa-pencil'}" class="o_mailpro_step_edit"/>
                    </div>
                    <!-- STEP 2A — Microsoft 365 -->
                    <h2 invisible="x_provider_credentials_set and not x_edit_credentials or x_mail_provider != 'outlook'">2. Microsoft 365 Credentials</h2>
                    <div class="row mt-3 mb-4 o_settings_container" invisible="x_provider_credentials_set and not x_edit_credentials or x_mail_provider != 'outlook'">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Azure app registration</span>
                                <div class="content-group">
                                    <div class="row mt-2">
                                        <label class="col-lg-3 o_light_label" for="x_microsoft_client_id">Client ID</label>
                                        <field name="x_microsoft_client_id" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"/>
                                    </div>
                                    <div class="row mt-2">
                                        <label class="col-lg-3 o_light_label" for="x_microsoft_client_secret">Secret</label>
                                        <field name="x_microsoft_client_secret" password="True"/>
                                    </div>
                                    <div class="row mt-2">
                                        <label class="col-lg-3 o_light_label" for="x_microsoft_tenant_id">Tenant ID</label>
                                        <field name="x_microsoft_tenant_id" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Callback URL</span>
                                <i class="fa fa-info-circle text-muted ms-1"
                                   title="Paste this into Azure → Authentication → Redirect URIs. Sign-in fails until it matches exactly."/>
                                <div class="content-group mt-2">
                                    <field name="x_microsoft_redirect_uri" readonly="1" widget="CopyClipboardChar"/>
                                </div>
                                <div class="mt-3">
                                    <a href="https://pantalytics.gitbook.io/pantalytics-docs/getting-started/azure-setup" target="_blank">
                                        <i class="fa fa-external-link me-1" title="Setup guide"/>Azure setup guide
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 2B — Google Workspace -->
                    <h2 invisible="x_provider_credentials_set and not x_edit_credentials or x_mail_provider != 'gmail'">2. Google Workspace Credentials</h2>
                    <div class="row mt-3 mb-4 o_settings_container" invisible="x_provider_credentials_set and not x_edit_credentials or x_mail_provider != 'gmail'">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Google Cloud OAuth client</span>
                                <div class="content-group">
                                    <div class="row mt-2">
                                        <label class="col-lg-3 o_light_label" for="x_google_client_id">Client ID</label>
                                        <field name="x_google_client_id" placeholder="xxxxxxxx.apps.googleusercontent.com"/>
                                    </div>
                                    <div class="row mt-2">
                                        <label class="col-lg-3 o_light_label" for="x_google_client_secret">Secret</label>
                                        <field name="x_google_client_secret" password="True"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Redirect URI</span>
                                <i class="fa fa-info-circle text-muted ms-1"
                                   title="Paste this into Google Cloud → Credentials → Authorized redirect URIs. Sign-in fails until it matches exactly."/>
                                <div class="content-group mt-2">
                                    <field name="x_google_redirect_uri" readonly="1" widget="CopyClipboardChar"/>
                                </div>
                                <div class="mt-3">
                                    <a href="https://console.cloud.google.com/apis/credentials" target="_blank">
                                        <i class="fa fa-external-link me-1" title="Google Cloud"/>Google Cloud credentials
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 2C — IMAP/SMTP has no global credential. -->
                    <h2 invisible="x_provider_credentials_set and not x_edit_credentials or x_mail_provider != 'imap'">2. Mail Accounts</h2>
                    <div class="row mt-3 mb-4 o_settings_container" invisible="x_provider_credentials_set and not x_edit_credentials or x_mail_provider != 'imap'">
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Server, login and password per address</span>
                                <i class="fa fa-info-circle text-muted ms-1"
                                   title="There is no consent screen here. Have ready: IMAP server and port (usually 993, SSL/TLS), SMTP server and port (usually 465, SSL/TLS), and the mailbox password or app password. Test Connection checks reading and sending separately."/>
                                <div class="mt-2">
                                    <button type="action" name="%(action_pan_mail_account)d"
                                            string="Email Accounts" icon="oi-arrow-right" class="oe_link ps-0"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="o_mailpro_step" invisible="not (x_setup_domains_done) or x_edit_domains">
                        <i class="fa fa-check-circle o_mailpro_step_check" title="Done"/>
                        <span class="o_mailpro_step_name">3. Internal Domains</span>
                        <span class="o_mailpro_step_value"><field name="x_internal_domain_ids" nolabel="1" readonly="1" widget="many2many_tags"/></span>
                        <field name="x_edit_domains" nolabel="1" widget="boolean_icon"
                               options="{'icon': 'fa-pencil'}" class="o_mailpro_step_edit"/>
                    </div>
                    <!-- STEP 3 — before mailboxes, because a mailbox refuses to
                         enable sync until this is answered. -->
                    <h2 invisible="x_setup_domains_done and not x_edit_domains or not x_provider_credentials_set">3. Internal Domains</h2>
                    <div class="row mt-3 mb-4 o_settings_container" invisible="x_setup_domains_done and not x_edit_domains or not x_provider_credentials_set">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Your domains</span>
                                <i class="fa fa-info-circle text-muted ms-1"
                                   title="One tag per domain, e.g. company.com. Type a domain and press enter to add it. Mail between these domains is never synced into Odoo, and incoming sync stays off until the list is filled in."/>
                                <div class="content-group mt-2">
                                    <field name="x_internal_domain_ids" nolabel="1"
                                           widget="many2many_tags"
                                           placeholder="company.com"
                                           options="{'create_name_field': 'name'}"/>
                                    <div class="mt-2" invisible="not x_internal_domains_suggested">
                                        <button name="action_apply_suggested_internal_domains" type="object"
                                                class="btn-link btn-sm ps-0" string="Use suggestion"/>
                                        <span class="text-muted small">
                                            <field name="x_internal_domains_suggested" class="d-inline" readonly="1"/>
                                        </span>
                                    </div>
                                    <div class="text-warning small mt-2" invisible="not x_internal_domains_uncovered">
                                        <i class="fa fa-exclamation-triangle me-1" title="Warning"/>
                                        Mailboxes on
                                        <field name="x_internal_domains_uncovered" class="d-inline" readonly="1"/>
                                        are treated as external.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="o_mailpro_step" invisible="not (x_setup_notification_done)">
                        <i class="fa fa-check-circle o_mailpro_step_check" title="Done"/>
                        <span class="o_mailpro_step_name">4. Mailboxes</span>
                        <span class="o_mailpro_step_value"><field name="x_notification_mailbox_id" nolabel="1" readonly="1"/></span>
                        <button type="action" name="%(action_pan_mail_mailbox)d"
                                icon="oi-arrow-right" class="oe_link o_mailpro_step_edit"/>
                    </div>
                    <!-- STEP 4 — the last gate. The mailbox itself demands a
                         connected owner, so "has anybody signed in" is answered
                         here rather than in a step of its own. -->
                    <h2 invisible="x_setup_notification_done or not x_provider_credentials_set">4. Mailboxes</h2>
                    <div class="row mt-3 mb-4 o_settings_container" invisible="x_setup_notification_done or not x_provider_credentials_set">
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Your mailboxes</span>
                                <i class="fa fa-info-circle text-muted ms-1"
                                   title="Add the addresses Mail Pro sends and receives on. One of them needs 'Notification Mailbox' ticked: user invitations, password resets and activity reminders go out from it. Its owner has to have connected their own mailbox, because it sends with their account."/>
                                <div class="mt-2" invisible="not x_setup_notification_done">
                                    <span class="text-success">
                                        <i class="fa fa-check-circle me-1" title="Ready"/>
                                    </span>
                                    <field name="x_notification_mailbox_id" class="d-inline" readonly="1" nolabel="1"/>
                                </div>
                                <div class="mt-2">
                                    <button type="action" name="%(action_pan_mail_mailbox)d"
                                            string="Mailboxes" icon="oi-arrow-right" class="oe_link ps-0"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <h2>About</h2>
                    <div class="row mt-3 o_settings_container">
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <a href="https://pantalytics.gitbook.io/pantalytics-docs/" target="_blank">
                                    <i class="fa fa-external-link me-1" title="Documentation"/>Documentation
                                </a>
                                <i class="fa fa-info-circle text-muted ms-1"
                                   title="© Pantalytics B.V. All rights reserved. This software is proprietary and confidential. Unauthorized copying, modification, distribution, or use of this module, in whole or in part, is strictly prohibited and may result in legal action. Protected under international copyright and trade secret law."/>
                            </div>
                        </div>
                    </div>
                </app>
            </xpath>
        </field>
    </record>

    <!-- Banner in standard Email settings -->
    <record id="res_config_settings_view_form_email_banner" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.outlook.pro.email.banner</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='email_servers_setting']" position="before">
                <div class="alert alert-info mb-3" role="alert">
                    <i class="fa fa-info-circle me-2" title="Info"/>
                    <strong>Mail Pro is installed.</strong>
                    Outgoing and incoming email is handled by Mail Pro.
                    <a href="#" class="alert-link ms-1">Configure in Settings → Mail Pro</a>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
