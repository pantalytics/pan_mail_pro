<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Banner in standard Email settings -->
    <record id="res_config_settings_view_form_email_banner" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.outlook.pro.email.banner</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='email_servers_setting']" position="before">
                <div class="alert alert-info mb-3" role="alert">
                    <i class="fa fa-info-circle me-2"/>
                    <strong>Outlook Pro is installed.</strong>
                    Email is managed via Microsoft Graph API.
                    <a href="#" class="alert-link ms-1">Configure in Settings → Outlook Pro</a>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Outlook Pro Settings App -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.outlook.pro</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Outlook Pro" name="pan_outlook_pro" groups="base.group_system">
                    <!-- Hidden fields -->
                    <field name="x_microsoft_config_status" invisible="1"/>
                    <field name="x_microsoft_config_status_message" invisible="1"/>
                    <field name="x_current_user_oauth_connected" invisible="1"/>
                    <field name="x_microsoft_mailbox_count" invisible="1"/>
                    <field name="x_microsoft_notification_configured" invisible="1"/>

                    <!-- ============================================ -->
                    <!-- STATUS BAR -->
                    <!-- ============================================ -->
                    <div class="d-flex gap-4 mb-4 p-3 bg-light rounded">
                        <div class="d-flex align-items-center">
                            <i class="fa fa-cloud me-2 text-success" invisible="x_microsoft_config_status not in ('configured', 'verified')"/>
                            <i class="fa fa-cloud me-2 text-muted" invisible="x_microsoft_config_status in ('configured', 'verified')"/>
                            <span invisible="x_microsoft_config_status not in ('configured', 'verified')">Azure</span>
                            <span class="text-muted" invisible="x_microsoft_config_status in ('configured', 'verified')">Azure</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="fa fa-user me-2 text-success" invisible="not x_current_user_oauth_connected"/>
                            <i class="fa fa-user me-2 text-muted" invisible="x_current_user_oauth_connected"/>
                            <span invisible="not x_current_user_oauth_connected">Connected</span>
                            <span class="text-muted" invisible="x_current_user_oauth_connected">Not connected</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="fa fa-envelope me-2 text-success" invisible="x_microsoft_mailbox_count == 0"/>
                            <i class="fa fa-envelope me-2 text-muted" invisible="x_microsoft_mailbox_count > 0"/>
                            <span invisible="x_microsoft_mailbox_count == 0"><field name="x_microsoft_mailbox_count" class="d-inline" readonly="1"/> mailbox(es)</span>
                            <span class="text-muted" invisible="x_microsoft_mailbox_count > 0">No mailboxes</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="fa fa-bell me-2 text-success" invisible="not x_microsoft_notification_configured"/>
                            <i class="fa fa-bell me-2 text-muted" invisible="x_microsoft_notification_configured"/>
                            <span invisible="not x_microsoft_notification_configured">Notifications</span>
                            <span class="text-muted" invisible="x_microsoft_notification_configured">No notifications</span>
                        </div>
                    </div>

                    <!-- ============================================ -->
                    <!-- SETUP GUIDE (first for new users) -->
                    <!-- ============================================ -->
                    <block title="Setup Guide" invisible="x_microsoft_config_status in ('configured', 'verified')">
                        <setting string="First-time setup" help="Follow these steps to configure Microsoft 365 integration">
                            <details class="mt-2" open="open">
                                <summary class="btn btn-link ps-0"><i class="fa fa-book me-2"/>Azure App Setup</summary>
                                <div class="mt-3 p-3 border rounded bg-white">
                                    <ol class="mb-0">
                                        <li class="mb-2">Open <a href="https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade" target="_blank">Azure Portal → App registrations</a></li>
                                        <li class="mb-2">Click <strong>+ New registration</strong></li>
                                        <li class="mb-2">Name: <code>Odoo Email Integration</code></li>
                                        <li class="mb-2">Account type: <em>Single tenant</em></li>
                                        <li class="mb-2">Redirect URI: <em>Web</em> → copy from field below</li>
                                        <li class="mb-2">Copy <strong>Client ID</strong> and <strong>Tenant ID</strong> from Overview</li>
                                        <li class="mb-2">Go to <strong>Certificates &amp; secrets</strong> → create secret → copy <strong>Value</strong></li>
                                        <li class="mb-2">Go to <strong>API permissions</strong> → add: <code>Mail.ReadWrite</code>, <code>Mail.ReadWrite.Shared</code>, <code>User.Read</code>, <code>offline_access</code></li>
                                        <li class="mb-2">Click <strong>Grant admin consent</strong></li>
                                    </ol>
                                </div>
                            </details>
                        </setting>
                    </block>

                    <!-- ============================================ -->
                    <!-- AZURE CREDENTIALS -->
                    <!-- ============================================ -->
                    <block title="Azure Credentials">
                        <setting string="Microsoft Azure App" help="Credentials from your Azure App Registration">
                            <div class="row mt-2">
                                <label for="x_microsoft_redirect_uri" class="col-lg-3 o_light_label"/>
                                <field name="x_microsoft_redirect_uri" readonly="1" widget="CopyClipboardChar"/>
                            </div>
                            <div class="row mt-2">
                                <label for="x_microsoft_client_id" class="col-lg-3 o_light_label"/>
                                <field name="x_microsoft_client_id" placeholder="Application (client) ID"/>
                            </div>
                            <div class="row mt-2">
                                <label for="x_microsoft_client_secret" class="col-lg-3 o_light_label"/>
                                <field name="x_microsoft_client_secret" password="True" placeholder="Client secret value"/>
                            </div>
                            <div class="row mt-2">
                                <label for="x_microsoft_tenant_id" class="col-lg-3 o_light_label"/>
                                <field name="x_microsoft_tenant_id" placeholder="Directory (tenant) ID"/>
                            </div>

                            <div class="mt-3">
                                <button name="action_test_azure_configuration" type="object"
                                        string="Test Connection" class="btn-secondary" icon="fa-plug"
                                        invisible="x_microsoft_config_status == 'not_configured'"/>
                                <span class="text-success ms-3" invisible="x_microsoft_config_status != 'verified'">
                                    <i class="fa fa-check-circle me-1"/>Connected
                                </span>
                                <span class="text-danger ms-3" invisible="x_microsoft_config_status != 'error'">
                                    <i class="fa fa-times-circle me-1"/><field name="x_microsoft_config_status_message" class="d-inline"/>
                                </span>
                            </div>
                        </setting>
                    </block>

                    <!-- ============================================ -->
                    <!-- YOUR CONNECTION -->
                    <!-- ============================================ -->
                    <block title="Your Connection" invisible="x_microsoft_config_status == 'not_configured'">
                        <setting string="Microsoft Account" help="Connect your Microsoft account to send emails">
                            <div class="d-flex align-items-center">
                                <button name="action_connect_microsoft_admin" type="object"
                                        string="Connect Microsoft" class="btn-primary" icon="fa-windows"
                                        invisible="x_current_user_oauth_connected"/>
                                <span class="text-success" invisible="not x_current_user_oauth_connected">
                                    <i class="fa fa-check-circle me-2"/>Your Microsoft account is connected
                                </span>
                            </div>
                        </setting>
                    </block>

                    <!-- ============================================ -->
                    <!-- MAILBOXES -->
                    <!-- ============================================ -->
                    <block title="Mailboxes" invisible="x_microsoft_config_status == 'not_configured'">
                        <setting string="Email addresses" help="Configure mailboxes for sending and receiving">
                            <button type="action" name="%(action_microsoft_mailbox)d"
                                    string="Manage Mailboxes" class="btn-primary" icon="fa-envelope"/>
                            <span class="text-muted ms-3">
                                <field name="x_microsoft_mailbox_count" class="d-inline" readonly="1"/> configured
                            </span>
                        </setting>
                    </block>

                    <!-- ============================================ -->
                    <!-- OPTIONS -->
                    <!-- ============================================ -->
                    <block title="Options">
                        <setting string="Allow Personal Mailboxes" help="Auto-create personal mailbox when user connects Microsoft">
                            <field name="x_microsoft_allow_personal_mailboxes"/>
                        </setting>
                        <setting string="Exclude Internal Emails" help="Skip emails from your company domain during sync">
                            <field name="x_microsoft_exclude_internal"/>
                            <div invisible="not x_microsoft_exclude_internal" class="text-muted mt-2">
                                <span invisible="not x_microsoft_detected_domain">
                                    Excluding: <strong><field name="x_microsoft_detected_domain" readonly="1" class="d-inline"/></strong>
                                </span>
                                <span invisible="x_microsoft_detected_domain" class="text-warning">
                                    No domain detected. Set company email or add a mailbox first.
                                </span>
                            </div>
                        </setting>
                    </block>

                    <!-- ============================================ -->
                    <!-- HELP (for configured users) -->
                    <!-- ============================================ -->
                    <block title="Help" invisible="x_microsoft_config_status not in ('configured', 'verified')">
                        <setting string="Documentation" help="Setup guides and troubleshooting">
                            <details class="mt-2">
                                <summary class="btn btn-link ps-0"><i class="fa fa-users me-2"/>User Setup</summary>
                                <div class="mt-3 p-3 border rounded bg-white">
                                    <p class="mb-2"><strong>Each user needs to:</strong></p>
                                    <ol class="mb-0">
                                        <li class="mb-1">Go to <strong>My Profile → Preferences</strong></li>
                                        <li class="mb-1">Click <strong>Connect Microsoft Account</strong></li>
                                        <li class="mb-1">Sign in and approve permissions</li>
                                        <li class="mb-1">Select default mailbox</li>
                                    </ol>
                                </div>
                            </details>
                            <details class="mt-2">
                                <summary class="btn btn-link ps-0"><i class="fa fa-envelope me-2"/>Mailbox Types</summary>
                                <div class="mt-3 p-3 border rounded bg-white">
                                    <ul class="mb-0">
                                        <li><strong>Personal:</strong> Individual user mailbox (john@company.com)</li>
                                        <li><strong>Shared:</strong> Team mailbox (sales@company.com) - requires M365 Send As permission</li>
                                        <li><strong>Notification:</strong> System notifications mailbox</li>
                                    </ul>
                                    <a href="https://admin.microsoft.com/#/SharedMailboxes" target="_blank" class="btn btn-link ps-0 mt-2">
                                        <i class="fa fa-external-link me-1"/>Create shared mailboxes in M365 Admin
                                    </a>
                                </div>
                            </details>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>
</odoo>
