<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mail Pro Settings App -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.outlook.pro</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Mail Pro" name="pan_mail_pro" groups="base.group_system">
                    <!-- State the sections below hide behind. -->
                    <field name="x_provider_credentials_set" invisible="1"/>
                    <field name="x_provider_connected" invisible="1"/>
                    <field name="x_provider_uses_oauth" invisible="1"/>
                    <field name="x_setup_domains_done" invisible="1"/>
                    <field name="x_setup_notification_done" invisible="1"/>
                    <field name="x_setup_complete" invisible="1"/>

                    <!-- The three steps, in one shape: a coloured dot on the
                         left, the name, the answer, and the way to the place you
                         change it. Steps 2 and 3 are tables, so that way is a
                         link to the table; step 1 is the only one that opens in
                         place. Anything longer than an answer — a warning, a fix
                         — goes on its own line under the name, never beside it,
                         so the column of dots and names stays a column. -->
                    <div class="o_mailpro_step">
                        <span class="o_mailpro_dot o_mailpro_dot_ok" title="Done"
                              invisible="not x_provider_credentials_set"/>
                        <span class="o_mailpro_dot o_mailpro_dot_todo" title="To do"
                              invisible="x_provider_credentials_set"/>
                        <div class="o_mailpro_step_body">
                            <div class="o_mailpro_step_head">
                                <span class="o_mailpro_step_name">1. Email Provider</span>
                                <i class="fa fa-info-circle text-muted" title="Where your company's email lives. The setup steps differ per provider, so only the chosen one is shown; each keeps its own credentials, so you can switch back."/>
                                <span class="o_mailpro_step_value" invisible="not x_mail_provider">
                                    <field name="x_mail_provider" nolabel="1" readonly="1"/>
                                </span>
                                <span class="o_mailpro_step_value" invisible="x_mail_provider">Not chosen yet</span>
                            </div>
                        </div>
                        <field name="x_edit_provider" nolabel="1" widget="boolean_icon"
                               options="{'icon': 'fa-arrow-right'}" class="o_mailpro_step_edit"/>
                    </div>
                    <!-- STEP 1 — the answer every step below depends on. -->
                    <h2 invisible="x_provider_credentials_set and not x_edit_provider">1. Email Provider</h2>
                    <div class="row mt-3 mb-4 o_settings_container" invisible="x_provider_credentials_set and not x_edit_provider">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Where is your email hosted?</span>
                                <i class="fa fa-info-circle text-muted ms-1"
                                   title="The setup steps differ per provider, so only one provider's steps are shown. Each keeps its own credentials, so you can switch back."/>
                                <div class="content-group mt-2">
                                    <field name="x_mail_provider" class="col-lg-8"
                                           placeholder="Search providers..."/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Part of step 1: the registration for the chosen provider. 2A — Microsoft 365 -->
                    <h2 invisible="x_provider_credentials_set and not x_edit_provider or x_mail_provider != 'outlook'">Microsoft 365 Credentials</h2>
                    <div class="row mt-3 mb-4 o_settings_container" invisible="x_provider_credentials_set and not x_edit_provider or x_mail_provider != 'outlook'">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Azure app registration</span>
                                <div class="content-group">
                                    <div class="row mt-2">
                                        <label class="col-lg-3 o_light_label" for="x_microsoft_client_id">Client ID</label>
                                        <field name="x_microsoft_client_id" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"/>
                                    </div>
                                    <div class="row mt-2">
                                        <label class="col-lg-3 o_light_label" for="x_microsoft_client_secret">Secret</label>
                                        <field name="x_microsoft_client_secret" password="True"/>
                                    </div>
                                    <div class="row mt-2">
                                        <label class="col-lg-3 o_light_label" for="x_microsoft_tenant_id">Tenant ID</label>
                                        <field name="x_microsoft_tenant_id" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Callback URL</span>
                                <i class="fa fa-info-circle text-muted ms-1"
                                   title="Paste this into Azure → Authentication → Redirect URIs. Sign-in fails until it matches exactly."/>
                                <div class="content-group mt-2">
                                    <field name="x_microsoft_redirect_uri" readonly="1" widget="CopyClipboardChar"/>
                                </div>
                                <div class="mt-3">
                                    <a href="https://pantalytics.gitbook.io/pantalytics-docs/getting-started/azure-setup" target="_blank">
                                        <i class="fa fa-external-link me-1" title="Setup guide"/>Azure setup guide
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 2B — Google Workspace -->
                    <h2 invisible="x_provider_credentials_set and not x_edit_provider or x_mail_provider != 'gmail'">Google Workspace Credentials</h2>
                    <div class="row mt-3 mb-4 o_settings_container" invisible="x_provider_credentials_set and not x_edit_provider or x_mail_provider != 'gmail'">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Google Cloud OAuth client</span>
                                <div class="content-group">
                                    <div class="row mt-2">
                                        <label class="col-lg-3 o_light_label" for="x_google_client_id">Client ID</label>
                                        <field name="x_google_client_id" placeholder="xxxxxxxx.apps.googleusercontent.com"/>
                                    </div>
                                    <div class="row mt-2">
                                        <label class="col-lg-3 o_light_label" for="x_google_client_secret">Secret</label>
                                        <field name="x_google_client_secret" password="True"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Redirect URI</span>
                                <i class="fa fa-info-circle text-muted ms-1"
                                   title="Paste this into Google Cloud → Credentials → Authorized redirect URIs. Sign-in fails until it matches exactly."/>
                                <div class="content-group mt-2">
                                    <field name="x_google_redirect_uri" readonly="1" widget="CopyClipboardChar"/>
                                </div>
                                <div class="mt-3">
                                    <a href="https://console.cloud.google.com/apis/credentials" target="_blank">
                                        <i class="fa fa-external-link me-1" title="Google Cloud"/>Google Cloud credentials
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 2C — IMAP/SMTP has no global credential. -->
                    <h2 invisible="x_provider_credentials_set and not x_edit_provider or x_mail_provider != 'imap'">Mail Accounts</h2>
                    <div class="row mt-3 mb-4 o_settings_container" invisible="x_provider_credentials_set and not x_edit_provider or x_mail_provider != 'imap'">
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Server, login and password per address</span>
                                <i class="fa fa-info-circle text-muted ms-1"
                                   title="There is no consent screen here. Have ready: IMAP server and port (usually 993, SSL/TLS), SMTP server and port (usually 465, SSL/TLS), and the mailbox password or app password. Test Connection checks reading and sending separately."/>
                                <div class="mt-2">
                                    <button type="action" name="%(action_pan_mail_account)d"
                                            string="Email Accounts" icon="oi-arrow-right" class="oe_link ps-0"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="o_mailpro_step">
                        <span class="o_mailpro_dot o_mailpro_dot_ok" title="Done"
                              invisible="not x_setup_domains_done or x_internal_domains_uncovered"/>
                        <span class="o_mailpro_dot o_mailpro_dot_warn" title="Attention needed"
                              invisible="not x_internal_domains_uncovered"/>
                        <span class="o_mailpro_dot o_mailpro_dot_todo" title="To do"
                              invisible="x_setup_domains_done"/>
                        <div class="o_mailpro_step_body">
                            <div class="o_mailpro_step_head">
                                <span class="o_mailpro_step_name">2. Internal Domains</span>
                                <i class="fa fa-info-circle text-muted" title="One row per domain your company owns, e.g. company.com. Mail between them is never synced into Odoo, and no mailbox can be created until at least one is listed."/>
                                <span class="o_mailpro_step_value" invisible="not x_setup_domains_done">
                                    <field name="x_internal_domain_ids" nolabel="1" readonly="1" widget="many2many_tags"/>
                                </span>
                                <span class="o_mailpro_step_value" invisible="x_setup_domains_done">Not set yet</span>
                            </div>
                            <div class="o_mailpro_step_msg o_mailpro_msg_warn" invisible="not x_internal_domains_uncovered">
                                Mailboxes on
                                <field name="x_internal_domains_uncovered" class="d-inline" readonly="1" nolabel="1"/>
                                are treated as external.
                            </div>
                            <!-- The one fix worth a line of its own: the domains
                                 can be read off the addresses already in the
                                 database, so neither an empty list nor an
                                 incomplete one has to be typed. -->
                            <div class="o_mailpro_step_msg" invisible="not x_internal_domains_suggested">
                                <button name="action_apply_suggested_internal_domains" type="object"
                                        class="btn-link btn-sm p-0" string="Add"/>
                                <field name="x_internal_domains_suggested" class="d-inline" readonly="1" nolabel="1"/>
                            </div>
                        </div>
                        <button type="action" name="%(action_pan_mail_domain)d"
                                icon="oi-arrow-right" title="Internal Domains"
                                class="oe_link o_mailpro_step_edit"/>
                    </div>

                    <div class="o_mailpro_step">
                        <span class="o_mailpro_dot o_mailpro_dot_ok" title="Done"
                              invisible="not x_setup_notification_done or x_mailboxes_alert"/>
                        <span class="o_mailpro_dot o_mailpro_dot_warn" title="Attention needed"
                              invisible="not x_mailboxes_alert"/>
                        <span class="o_mailpro_dot o_mailpro_dot_todo" title="To do"
                              invisible="x_setup_notification_done"/>
                        <div class="o_mailpro_step_body">
                            <div class="o_mailpro_step_head">
                                <span class="o_mailpro_step_name">3. Mailboxes</span>
                                <i class="fa fa-info-circle text-muted" title="The addresses Mail Pro sends and receives on. One needs 'Notification Mailbox' ticked: user invitations, password resets and activity reminders go out from it, using its owner's connected account."/>
                                <span class="o_mailpro_step_value" invisible="not x_setup_notification_done">
                                    <field name="x_notification_mailbox_id" nolabel="1" readonly="1"/>
                                </span>
                                <span class="o_mailpro_step_value" invisible="x_setup_notification_done">No notification mailbox</span>
                            </div>
                            <div class="o_mailpro_step_msg o_mailpro_msg_warn" invisible="not x_mailboxes_alert">
                                <field name="x_mailboxes_alert" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                        <button type="action" name="%(action_pan_mail_mailbox)d"
                                icon="oi-arrow-right" title="Mailboxes"
                                class="oe_link o_mailpro_step_edit"/>
                    </div>

                    <h2>About</h2>
                    <div class="row mt-3 o_settings_container">
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <a href="https://pantalytics.gitbook.io/pantalytics-docs/" target="_blank">
                                    <i class="fa fa-external-link me-1" title="Documentation"/>Documentation
                                </a>
                                <i class="fa fa-info-circle text-muted ms-1"
                                   title="© Pantalytics B.V. All rights reserved. This software is proprietary and confidential. Unauthorized copying, modification, distribution, or use of this module, in whole or in part, is strictly prohibited and may result in legal action. Protected under international copyright and trade secret law."/>
                            </div>
                        </div>
                    </div>
                </app>
            </xpath>
        </field>
    </record>

    <!-- Banner in standard Email settings -->
    <record id="res_config_settings_view_form_email_banner" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.outlook.pro.email.banner</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='email_servers_setting']" position="before">
                <div class="alert alert-info mb-3" role="alert">
                    <i class="fa fa-info-circle me-2" title="Info"/>
                    <strong>Mail Pro is installed.</strong>
                    Outgoing and incoming email is handled by Mail Pro.
                    <a href="#" class="alert-link ms-1">Configure in Settings → Mail Pro</a>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
