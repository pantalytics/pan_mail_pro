<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mail Pro Settings App -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mail.pro</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Mail Pro" name="pan_mail_pro" groups="base.group_system">
                    <!-- State the sections below hide behind. -->
                    <field name="x_setup_provider_done" invisible="1"/>
                    <field name="x_setup_domains_done" invisible="1"/>
                    <field name="x_setup_notification_done" invisible="1"/>
                    <field name="x_internal_domain_ids" invisible="1" widget="many2many_tags"/>
                    <field name="x_users_relevant" invisible="1"/>
                    <field name="x_users_pending" invisible="1"/>

                    <!-- The checklist sits in Odoo's own settings container so
                         it is capped and indented like every other block on this
                         page. Without it the rows ran the full width of the
                         window and the arrow ended up a screen away from the
                         name it belongs to.

                         The three steps, in one shape: a coloured dot on the
                         left, the name, the answer, and the way to the place you
                         change it. All three are tables now, so that way is
                         always a link to the table — nothing is typed on this
                         page. Anything longer than an answer — a warning, a fix
                         — goes on its own line under the name, never beside it,
                         so the column of dots and names stays a column. -->
                    <h2>Pantalytics Account</h2>
                    <!-- Not a setup step: mail flows without it. One primary
                         action per state, and the code is the biggest thing on
                         screen while it is waiting, because it gets read off
                         here and typed somewhere else. -->
                    <div class="row mt-3 o_settings_container">
                        <div class="col-12 o_setting_box o_mailpro_about">
                            <div invisible="x_license_state != 'not_connected'">
                                <div class="text-muted mb-2">
                                    Mail Pro works on an Odoo instance that is connected to a Pantalytics account.
                                    Setup starts once this one is. The button opens a Pantalytics tab where you
                                    sign in, or create an account, and approve a code. Free during the beta.
                                </div>
                                <button name="action_license_connect" type="object"
                                        string="Connect to Pantalytics" class="btn-primary"/>
                            </div>
                            <div invisible="x_license_state != 'pending'">
                                <div class="mb-1">
                                    Approve the connection in the Pantalytics tab that just opened.
                                    It shows this code:
                                    <field name="x_license_user_code" nolabel="1" readonly="1" class="fw-bold ms-1"/>
                                </div>
                                <div class="text-muted">
                                    No tab? <field name="x_license_verify_url" widget="url" nolabel="1" readonly="1"
                                                   options="{'website_path': False}" text="Open it again"/>
                                </div>
                                <div class="mt-2">
                                    <button name="action_license_check" type="object"
                                            string="Check Approval" class="btn-secondary"/>
                                    <button name="action_license_disconnect" type="object"
                                            string="Cancel" class="btn-link"/>
                                </div>
                            </div>
                            <div invisible="x_license_state != 'connected'">
                                <div>
                                    <span class="o_form_label">Status</span>
                                    <field name="x_license_status" nolabel="1" readonly="1" class="ms-1"/>
                                </div>
                                <div class="text-muted" invisible="not x_license_message">
                                    <field name="x_license_message" nolabel="1" readonly="1"/>
                                </div>
                                <div class="text-muted" invisible="not x_license_valid_until">
                                    Valid until <field name="x_license_valid_until" nolabel="1" readonly="1"/>
                                </div>
                                <!-- Usage and the invoice live at Pantalytics. A link, not a
                                     copy of the numbers: the count that decides the invoice is
                                     the one that server kept. -->
                                <div class="mt-2">
                                    <field name="x_license_dashboard_url" widget="url" nolabel="1"
                                           readonly="1" options="{'website_path': False}"
                                           text="Usage and billing"/>
                                </div>
                                <!-- Help improve Mail Pro. Switched on at Pantalytics, for
                                     the workspace; this page can only refuse it for this
                                     instance. Shown only while it is on: a checkbox that
                                     refuses something that is not happening is a puzzle. -->
                                <div class="mt-3" invisible="not x_improve_on">
                                    <div>
                                        <span class="o_form_label">Help improve Mail Pro</span>
                                    </div>
                                    <div class="text-muted">
                                        Switched on for your Pantalytics workspace: the Mail Pro inbox reports which
                                        screens, tabs and buttons are used and records the session with every word
                                        and every field masked. Never a mail, an address, a name or a subject.
                                        Switch it off for every Odoo instance at app.mailpro.pantalytics.com, Settings.
                                    </div>
                                    <div class="mt-1">
                                        <field name="x_improve_refused"/>
                                        <label for="x_improve_refused" class="ms-1"/>
                                    </div>
                                </div>
                                <div class="mt-2" invisible="not x_license_sync_blocked">
                                    <button name="action_license_check" type="object"
                                            string="Check again" class="btn-secondary"/>
                                </div>
                                <button name="action_license_disconnect" type="object"
                                        string="Disconnect" class="btn-link text-danger ps-0"
                                        confirm="This Odoo instance forgets its Pantalytics key. You can connect again at any time."/>
                            </div>
                            <div class="alert alert-warning mt-2 mb-0" role="alert"
                                 invisible="not x_license_sync_blocked or x_license_state == 'not_connected'">
                                Incoming mail is not synced and no new mailbox can be connected until this
                                Odoo instance is connected. Sending keeps working.
                            </div>
                            <div class="text-warning mt-2" invisible="not x_license_last_error">
                                <field name="x_license_last_error" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                    </div>

                    <!-- Nothing below this line exists on an instance that is
                         not connected: every step of it configures a product
                         that will not run, and a checklist you cannot finish
                         reads as the thing that is broken. One screen, one
                         action: connect. -->
                    <div invisible="x_license_state != 'connected'">
                    <h2>Setup</h2>
                    <div class="row mt-3 o_settings_container">
                    <div class="col-12 o_setting_box o_mailpro_steps">
                    <div class="o_mailpro_step">
                        <span class="o_mailpro_dot o_mailpro_dot_ok" role="img" aria-label="Done" title="Done"
                              invisible="not x_setup_provider_done"/>
                        <span class="o_mailpro_dot o_mailpro_dot_todo" role="img" aria-label="To do" title="To do"
                              invisible="x_setup_provider_done"/>
                        <div class="o_mailpro_step_body">
                            <div class="o_mailpro_step_head">
                                <span class="o_mailpro_step_name">1. Email Provider</span>
                                <span class="o_mailpro_step_value" invisible="not x_setup_provider_done">
                                    <field name="x_active_provider_id" nolabel="1" readonly="1" options="{'no_open': True}"/>
                                </span>
                                <span class="o_mailpro_step_value" invisible="x_setup_provider_done">
                                    <field name="x_setup_provider_todo" nolabel="1" readonly="1"/>
                                </span>
                            </div>
                            <!-- Only while the step is open. Once it is answered
                                 the answer beside the name explains the step
                                 better than any sentence could, and a hint that
                                 stays is the one people learn to skip. -->
                            <div class="o_mailpro_step_msg" invisible="x_setup_provider_done or x_setup_provider_needs_account">
                                Where your company's email lives. Mail Pro sends and receives through it.
                            </div>
                            <div class="o_mailpro_step_msg" invisible="not x_setup_provider_needs_account">
                                Each IMAP/SMTP address is an account with its own server, login and password.
                            </div>
                        </div>
                        <field name="x_setup_provider_needs_account" invisible="1"/>
                        <button type="action" name="%(action_pan_mail_provider)d"
                                icon="oi-arrow-right" title="Providers"
                                class="oe_link o_mailpro_step_edit"
                                invisible="x_setup_provider_needs_account"/>
                        <button type="action" name="%(action_pan_mail_account)d"
                                icon="oi-arrow-right" title="Email Accounts"
                                class="oe_link o_mailpro_step_edit"
                                invisible="not x_setup_provider_needs_account"/>
                    </div>

                    <div class="o_mailpro_step">
                        <span class="o_mailpro_dot o_mailpro_dot_ok" role="img" aria-label="Done" title="Done"
                              invisible="not x_setup_domains_done"/>
                        <span class="o_mailpro_dot o_mailpro_dot_todo" role="img" aria-label="To do" title="To do"
                              invisible="x_setup_domains_done"/>
                        <div class="o_mailpro_step_body">
                            <div class="o_mailpro_step_head">
                                <span class="o_mailpro_step_name">2. Internal Domains</span>
                                <span class="o_mailpro_step_value" invisible="not x_setup_domains_done">
                                    <field name="x_internal_domains_summary" nolabel="1" readonly="1"/>
                                </span>
                                <span class="o_mailpro_step_value" invisible="x_setup_domains_done">Not set yet</span>
                            </div>
                            <div class="o_mailpro_step_msg" invisible="x_setup_domains_done">
                                The domains your company owns. Email between them is never copied into Odoo.
                            </div>
                            <!-- Only while the list is empty: the domains can be
                                 read off the addresses already in the database,
                                 so nobody has to type them on day one. A list
                                 that has something in it is the admin's, and
                                 offering additions to it forever would read as
                                 a complaint about a deliberate choice. -->
                            <div class="o_mailpro_step_msg"
                                 invisible="x_setup_domains_done or not x_internal_domains_suggested">
                                <button name="action_apply_suggested_internal_domains" type="object"
                                        class="btn-link btn-sm p-0 me-1" string="Add"/>
                                <field name="x_internal_domains_suggested" class="d-inline" readonly="1" nolabel="1"/>
                            </div>
                        </div>
                        <button type="action" name="%(action_pan_mail_domain)d"
                                icon="oi-arrow-right" title="Internal Domains"
                                class="oe_link o_mailpro_step_edit"/>
                    </div>

                    <div class="o_mailpro_step">
                        <span class="o_mailpro_dot o_mailpro_dot_ok" role="img" aria-label="Done" title="Done"
                              invisible="not x_setup_notification_done or x_mailboxes_alert"/>
                        <span class="o_mailpro_dot o_mailpro_dot_warn" role="img" aria-label="Attention needed" title="Attention needed"
                              invisible="not x_mailboxes_alert"/>
                        <!-- A step that has stopped is one dot, not two: the
                             warning wins, and "still to do" is not additional
                             information next to it. -->
                        <span class="o_mailpro_dot o_mailpro_dot_todo" role="img" aria-label="To do" title="To do"
                              invisible="x_setup_notification_done or x_mailboxes_alert"/>
                        <div class="o_mailpro_step_body">
                            <div class="o_mailpro_step_head">
                                <span class="o_mailpro_step_name">3. Mailboxes</span>
                                <!-- The address alone does not say why one of
                                     several is the one on this line. The value
                                     answers the step, so it has to say which
                                     question it answered. -->
                                <span class="o_mailpro_step_value" invisible="not x_setup_notification_done">
                                    Notifications from
                                    <field name="x_notification_mailbox_id" class="d-inline"
                                           nolabel="1" readonly="1" options="{'no_open': True}"/>
                                </span>
                                <span class="o_mailpro_step_value" invisible="x_setup_notification_done">No notification mailbox</span>
                            </div>
                            <div class="o_mailpro_step_msg" invisible="x_setup_notification_done">
                                The addresses Mail Pro sends and receives on. One of them
                                sends Odoo's own email.
                            </div>
                            <div class="o_mailpro_step_msg o_mailpro_msg_warn" invisible="not x_mailboxes_alert">
                                <field name="x_mailboxes_alert" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                        <button type="action" name="%(action_pan_mail_mailbox)d"
                                icon="oi-arrow-right" title="Mailboxes"
                                class="oe_link o_mailpro_step_edit"/>
                    </div>

                    </div>
                    </div>

                    <!-- Not a fourth step, and deliberately not a fourth dot:
                         setup is finished without it. It is the answer to the
                         question the three steps leave open — whether anybody
                         but the administrator can send from their own address —
                         in the same shape as the steps: the answer, and the way
                         to the list where something is done about it. The
                         invite button stays on that list.

                         Hidden entirely on a provider with no consent screen,
                         where an administrator types the credentials and there
                         is nothing to ask a user for. -->
                    <div invisible="not x_users_relevant">
                        <h2>Users</h2>
                        <div class="row mt-3 o_settings_container">
                            <div class="col-12 o_setting_box o_mailpro_steps">
                                <div class="o_mailpro_team">
                                    <div class="o_mailpro_step_body">
                                        <div class="o_mailpro_step_head">
                                            <span class="o_mailpro_step_name">Connected mailboxes</span>
                                            <span class="o_mailpro_step_value">
                                                <field name="x_users_summary" nolabel="1" readonly="1"/>
                                            </span>
                                        </div>
                                        <div class="o_mailpro_step_msg" invisible="not x_users_pending">
                                            The rest still send as the Odoo instance, not as themselves.
                                            Select them in Users and press "Send Mail Pro Invite".
                                        </div>
                                    </div>
                                    <button type="action" name="%(base.action_res_users)d"
                                            icon="oi-arrow-right" title="Users"
                                            class="oe_link o_mailpro_step_edit"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    </div>

                    <h2>About</h2>
                    <!-- No left/right pane: an empty left pane draws a divider
                         beside a single link, which reads as a missing field.

                         The version is the first thing a support mail has to
                         answer, and the licence claim belongs where anyone
                         using the module can read it — not in the tooltip it
                         used to hide in. -->
                    <div class="row mt-3 o_settings_container">
                        <div class="col-12 o_setting_box o_mailpro_about">
                            <div>
                                <span class="o_form_label">Mail Pro</span>
                                <field name="x_module_version" nolabel="1" readonly="1" class="ms-1"/>
                            </div>
                            <div class="text-muted">
                                © Pantalytics B.V. Licensed under the Elastic License 2.0.
                                You may use, copy and modify this software. You may not
                                offer it to third parties as a hosted or managed service,
                                and you may not remove or circumvent its licensing notices.
                            </div>
                            <div class="mt-2">
                                <a href="https://odoo.pantalytics.com/knowledge/article/116" target="_blank">
                                    <i class="fa fa-external-link me-1" title="Documentation"/>Documentation
                                </a>
                            </div>
                        </div>
                    </div>
                </app>
            </xpath>
        </field>
    </record>

    <!-- Banner in standard Email settings -->
    <record id="res_config_settings_view_form_email_banner" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mail.pro.email.banner</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='email_servers_setting']" position="before">
                <div class="alert alert-info mb-3" role="alert">
                    <i class="fa fa-info-circle me-2" title="Info"/>
                    <strong>Mail Pro is installed.</strong>
                    Outgoing and incoming email is handled by Mail Pro.
                    <a href="/odoo/settings#pan_mail_pro" class="alert-link ms-1">Configure in Settings → Mail Pro</a>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
