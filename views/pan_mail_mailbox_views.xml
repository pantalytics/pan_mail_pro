<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_pan_mail_mailbox_list" model="ir.ui.view">
        <field name="name">pan.mail.mailbox.list</field>
        <field name="model">pan.mail.mailbox</field>
        <field name="arch" type="xml">
            <list string="Mailboxes" js_class="mailbox_list"
                  decoration-danger="health_status == 'error'"
                  decoration-warning="health_status == 'warning'">
                <field name="sequence" widget="handle"/>
                <field name="email" string="Mailbox"/>
                <field name="health_status" string="Status" widget="badge"
                       decoration-success="health_status == 'healthy'"
                       decoration-warning="health_status == 'warning'"
                       decoration-danger="health_status == 'error'"/>
                <!-- Editable straight from the list: which mailbox sends the
                     system email is one tick, and moving it is untick here,
                     tick there. -->
                <field name="is_notification_mailbox" string="Notification"
                       widget="boolean_toggle"/>
                <field name="mailbox_type" string="Type" optional="hide"/>
                <field name="provider" string="Provider" optional="hide"/>
                <field name="owner_user_id" string="Owner" optional="hide"/>
                <field name="sync_received" string="Sync Other Email" optional="hide"/>
                <field name="sync_sent" string="Sync Sent Items" optional="hide"/>
                <field name="last_sync_date" optional="hide"/>
                <field name="error_message" string="Error" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_pan_mail_mailbox_form" model="ir.ui.view">
        <field name="name">pan.mail.mailbox.form</field>
        <field name="model">pan.mail.mailbox</field>
        <field name="arch" type="xml">
            <form string="Mailbox">
                <sheet>
                    <!-- SECTION 1: MAILBOX -->
                    <group string="Mailbox">
                        <group>
                            <field name="email" placeholder="support@company.com"/>
                            <!-- Inherited from the one provider this database
                                 runs on; only the IMAP button below reads it. -->
                            <field name="provider" invisible="1"/>
                            <field name="health_status" string="Status" widget="badge"
                                   decoration-success="health_status == 'healthy'"
                                   decoration-warning="health_status == 'warning'"
                                   decoration-danger="health_status == 'error'"
                                   readonly="1"/>
                            <label for="mailbox_type" string="Type"/>
                            <div>
                                <field name="mailbox_type" widget="radio" nolabel="1" class="d-inline-block"/>
                                <div class="text-muted mt-1">
                                    Personal: only the owner sends from it.
                                    Shared: everyone can send from this address.
                                </div>
                            </div>
                            <field name="owner_user_id"
                                   required="mailbox_type == 'personal' or is_notification_mailbox"/>
                            <label for="is_notification_mailbox"/>
                            <div>
                                <field name="is_notification_mailbox" widget="boolean_toggle"
                                       nolabel="1" class="d-inline-block"/>
                                <div class="text-muted mt-1">
                                    Odoo's own email leaves from here: invitations,
                                    password resets, reminders. Exactly one mailbox.
                                </div>
                            </div>
                        </group>
                        <group>
                            <div invisible="provider != 'imap'">
                                <button name="action_open_account" type="object"
                                        string="Server Credentials" class="btn-link ps-0"
                                        icon="fa-key"/>
                                <div class="text-muted mt-1">
                                    This address is reached with a server, a login and a
                                    password rather than a consent screen.
                                </div>
                            </div>
                        </group>
                    </group>

                    <!-- SECTION 2: SENDING (not for notification) -->
                    <!-- Two ways out of this address, and only the second one
                         is a choice. Sending from Odoo is what the mailbox is
                         for; a toggle there would be a way to break sending
                         from a settings page, so it is stated and not asked.
                         Reading back what the owner wrote in their own mail app
                         is a copy of correspondence Odoo was never part of, so
                         it is asked separately and starts at off. -->
                    <group string="Sending" invisible="is_notification_mailbox">
                        <group>
                            <div colspan="2" class="text-muted mb-3">
                                Messages you write in Odoo are always sent from this address.
                            </div>
                            <label for="sync_sent"/>
                            <div>
                                <field name="sync_sent" widget="boolean_toggle"
                                       nolabel="1" class="d-inline-block"/>
                                <div class="text-muted mt-1">
                                    Sync Sent Items from your email program to Odoo.
                                </div>
                                <div class="text-muted mt-1" invisible="not sync_sent">
                                    Only replies to emails that are already in Odoo.
                                    They land on the record they continue. Mail that
                                    starts a new conversation stays out.
                                </div>
                            </div>
                        </group>
                        <group/>
                    </group>

                    <!-- SECTION 3: RECEIVING (not for notification) -->
                    <!-- Three steps, each a level deeper than the last: what
                         happens with no setting at all, then one switch, then
                         the question that switch opens. The answer that turns
                         every sender into a contact is two deliberate clicks
                         away and says out loud what it does. -->
                    <group string="Receiving" invisible="is_notification_mailbox">
                        <group>
                            <div colspan="2" class="text-muted mb-3">
                                Replies to email sent from Odoo always appear on the
                                record they belong to.
                            </div>
                            <label for="sync_received"/>
                            <div>
                                <field name="sync_received" widget="boolean_toggle"
                                       nolabel="1" class="d-inline-block"/>
                                <div class="text-muted mt-1">
                                    Also sync email that starts a new conversation.
                                </div>
                            </div>
                            <div colspan="2" class="mt-3" invisible="not sync_received">
                                <span class="o_form_label">Which email should be synced?</span>
                                <field name="sync_received_scope" widget="radio"
                                       nolabel="1" class="mt-1"/>
                                <div class="alert alert-warning mt-2 mb-0" role="alert"
                                     invisible="sync_received_scope != 'all'">
                                    Every sender becomes a contact in Odoo, newsletters
                                    and private email included. Pick this only for an
                                    address that exists to hear from strangers.
                                </div>
                            </div>
                        </group>
                        <group/>
                    </group>

                    <!-- SECTION 4: SYNC -->
                    <group string="Sync" invisible="is_notification_mailbox">
                        <group>
                            <field name="sync_start_date"/>
                            <field name="last_sync_date" readonly="1"
                                   invisible="not last_sync_date"/>
                            <field name="last_sent_sync_date" readonly="1"
                                   invisible="not sync_sent or not last_sent_sync_date"/>
                        </group>
                        <group/>
                    </group>

                    <!-- SECTION 5: ROUTING -->
                    <group string="Routing" invisible="is_notification_mailbox">
                        <group>
                            <label for="route_to_team"/>
                            <div>
                                <field name="route_to_team" widget="boolean_toggle" nolabel="1" class="d-inline-block"/>
                                <div class="text-muted mt-1">
                                    Off: email lands on the sender's contact.
                                    On: it goes to the team behind the alias you pick.
                                </div>
                            </div>
                            <field name="alias_id" string="Team"
                                   invisible="not route_to_team"
                                   required="route_to_team"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   placeholder="Select team..."/>
                        </group>
                        <group/>
                    </group>

                    <!-- BUTTONS -->
                    <group>
                        <group>
                            <!-- Every mailbox syncs something since 19.0.7.6.0:
                                 replies land on their record with no setting at
                                 all, so there is no configuration under which
                                 this button has nothing to do. -->
                            <button name="action_sync_now" string="Sync Now"
                                    type="object" class="btn-primary" icon="fa-refresh"
                                    invisible="is_notification_mailbox"/>
                            <!-- Every mailbox, including the notification one:
                                 sending is the one thing the consent screen
                                 does not prove. The mail goes to the user who
                                 presses it, never to this address. -->
                            <button name="action_test_send" string="Send Test Email"
                                    type="object" class="btn-secondary" icon="fa-paper-plane"/>
                        </group>
                        <group/>
                    </group>

                    <!-- Error alert -->
                    <div class="alert alert-danger" role="alert" invisible="state != 'error'">
                        <strong>Sync failed:</strong> <field name="error_message" nolabel="1" readonly="1"/>
                    </div>

                    <!-- Hidden fields -->
                    <field name="state" invisible="1"/>
                    <field name="active" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_pan_mail_mailbox" model="ir.actions.act_window">
        <field name="name">Mailboxes</field>
        <field name="res_model">pan.mail.mailbox</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first mailbox
            </p>
            <p>
                A mailbox is an address Mail Pro sends and receives on, using the
                provider you set up. One of them carries the system email.
            </p>
        </field>
    </record>

    <!-- Menu: Settings → Technical → Email → Mailboxes -->
    <menuitem id="menu_pan_mail_mailbox"
              name="Mailboxes"
              parent="pan_mail_pro.menu_pan_mail_root"
              action="action_pan_mail_mailbox"
              sequence="20"
              groups="base.group_system"/>

</odoo>
