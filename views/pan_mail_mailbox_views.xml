<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_pan_mail_mailbox_list" model="ir.ui.view">
        <field name="name">pan.mail.mailbox.list</field>
        <field name="model">pan.mail.mailbox</field>
        <field name="arch" type="xml">
            <list string="Mailboxes" js_class="mailbox_list"
                  decoration-danger="health_status == 'error'"
                  decoration-warning="health_status == 'warning'">
                <field name="sequence" widget="handle"/>
                <field name="email" string="Mailbox"/>
                <field name="health_status" string="Status" widget="badge"
                       decoration-success="health_status == 'healthy'"
                       decoration-warning="health_status == 'warning'"
                       decoration-danger="health_status == 'error'"/>
                <!-- Editable straight from the list: which mailbox sends the
                     system email is one tick, and moving it is untick here,
                     tick there. -->
                <field name="is_notification_mailbox" string="Notification"
                       widget="boolean_toggle"/>
                <field name="mailbox_type" string="Type" optional="hide"/>
                <!-- What the provider says is at the address, as the access
                     check last found it. Odoo's policy word is the column
                     above; this is Exchange's or Gmail's factual one. -->
                <field name="address_kind" string="Kind" optional="hide"/>
                <field name="provider" string="Provider" optional="hide"/>
                <field name="owner_user_id" string="Owner" optional="hide"/>
                <field name="sync_level" string="Sync" optional="hide"/>
                <!-- The cursor, named as one. It used to say "Last Synced"
                     here too, which is the question the next column answers. -->
                <field name="last_sync_date" string="Newest mail read" optional="hide"/>
                <field name="last_check_date" string="Last checked" optional="hide"/>
                <field name="error_message" string="Error" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View.

         Three speeds, three places. The identity (address, type, owner) is set
         once and read many times, so it is the title. The state (status, last
         sync, how much landed) is looked at when something is wrong, so it is
         the header and two counters, with no field to fill in. The sync
         settings are adjusted now and then, so they are the first tab; the
         things set once are the second. Nothing on the screen scrolls. -->
    <record id="view_pan_mail_mailbox_form" model="ir.ui.view">
        <field name="name">pan.mail.mailbox.form</field>
        <field name="model">pan.mail.mailbox</field>
        <field name="arch" type="xml">
            <form string="Mailbox" class="o_mailpro_mailbox_form">
                <!-- No header. A mailbox that works has no action to offer,
                     and a header carrying two buttons on such a screen is the
                     module admitting it cannot tell the reader whether the
                     sync runs. Recovery moved next to the reason it exists
                     for, at the bottom; the send test moved to Setup, which
                     is the one moment it answers a question anyone has. -->
                <sheet>
                    <!-- Inherited from the one provider this database runs on;
                         only the IMAP button below reads it. -->
                    <field name="provider" invisible="1"/>
                    <field name="state" invisible="1"/>
                    <field name="active" invisible="1"/>

                    <!-- The inspection surface: is it working, and since when. -->
                    <div name="button_box" class="oe_button_box">
                        <!-- The counter that was here read "Last synced" over
                             `last_sync_date`, which is the fetch cursor: the
                             date of the newest message read, not the moment of
                             the last run. On a quiet mailbox it stands still
                             while everything works, so the one number on the
                             form claiming to answer "is this working" was the
                             one number that could not. It is a grey line under
                             the address now, reading the heartbeat. -->
                        <button name="action_open_routing_log" type="object"
                                class="oe_stat_button" icon="fa-random"
                                invisible="is_notification_mailbox">
                            <field name="routing_log_count" widget="statinfo" string="Routed here"/>
                        </button>
                    </div>

                    <!-- The identity: read, not filled in. The address and its
                         status on one line, then one grey line of facts: the
                         brand's overview page is a title, its status, and
                         nothing that needs a second line to explain it. -->
                    <div class="oe_title o_mailpro_mailbox_head">
                        <h1 class="d-flex align-items-center gap-3">
                            <field name="email" placeholder="support@company.com"
                                   class="o_mailpro_mailbox_address"/>
                            <field name="health_status" string="Status" widget="badge"
                                   decoration-success="health_status == 'healthy'"
                                   decoration-warning="health_status == 'warning'"
                                   decoration-danger="health_status == 'error'"
                                   readonly="1"/>
                        </h1>
                        <!-- Time Machine's line, for the same reason: a result
                             nobody can see any other way has to be stated. The
                             reader of this mailbox sees the sync working in
                             the Inbox; the admin setting up an address for
                             somebody else's team never does. -->
                        <div class="text-muted o_mailpro_mailbox_meta">
                            <field name="subtitle" readonly="1" nolabel="1" class="d-inline"/>
                            <span invisible="is_notification_mailbox or not last_check_date">
                                · Last checked <field name="last_check_date" readonly="1" nolabel="1"
                                                           class="d-inline"/>
                            </span>
                            <span invisible="is_notification_mailbox or last_check_date">
                                · Not checked yet
                            </span>
                        </div>
                    </div>

                    <notebook>
                        <!-- Hidden for the notification mailbox: it carries the
                             system email and syncs nothing itself. -->
                        <page string="Sync settings" name="sync"
                              invisible="is_notification_mailbox">
                            <!-- Sending is stated, not asked. Whether this
                                 address is used is decided per message, in the
                                 composer's Send From. One sentence: the brand
                                 allows no more under a heading. -->
                            <p class="text-muted o_mailpro_mailbox_lead">
                                Mail you send from Odoo with this address under Send From
                                leaves from it and lands in your Sent Items.
                            </p>

                            <!-- Rows, label left and value right, in Odoo's own
                                 group: the label used to run straight into the
                                 first radio. One ladder; each answer keeps
                                 strictly more of the mailbox than the one above
                                 it, so the widest is three deliberate clicks
                                 from the default and says out loud what it does. -->
                            <group class="o_mailpro_mailbox_rows">
                                <field name="sync_level" string="Sync level" widget="radio"/>
                                <!-- Where a new conversation lands only matters
                                     once new conversations come in, so it
                                     appears with the rung that lets them in. -->
                                <label for="route_to_team" string="Route to a team"
                                       invisible="sync_level not in ('contacts', 'everyone')"/>
                                <div invisible="sync_level not in ('contacts', 'everyone')">
                                    <field name="route_to_team" widget="boolean_toggle" nolabel="1"
                                           class="d-inline-block"/>
                                    <div class="text-muted">
                                        Off: new email lands on the sender's contact.
                                    </div>
                                </div>
                                <field name="alias_id" string="Team"
                                       invisible="sync_level not in ('contacts', 'everyone') or not route_to_team"
                                       required="route_to_team"
                                       options="{'no_create': True, 'no_create_edit': True}"
                                       placeholder="Select team..."/>
                            </group>
                            <div class="alert alert-warning mb-0" role="alert"
                                 invisible="sync_level != 'everyone'">
                                Every sender becomes a contact in Odoo, newsletters
                                and private email included. Pick this only for an
                                address that exists to hear from strangers.
                            </div>
                        </page>

                        <!-- The things you set once. One click away rather than
                             one screen away. -->
                        <page string="Setup" name="setup">
                            <group>
                                <group>
                                    <label for="owner_user_id"/>
                                    <div>
                                        <field name="owner_user_id" nolabel="1" class="d-inline-block"
                                               required="is_notification_mailbox"/>
                                        <!-- Whose sign-in the mail leaves with: the
                                             owner's on a personal or notification
                                             mailbox, each sender's own on a shared one.
                                             The address named is the one the provider
                                             has to allow, which is not always the
                                             owner's own. -->
                                        <div class="text-muted mt-1" invisible="not sends_with">
                                            <field name="sends_with" nolabel="1" readonly="1"/>
                                        </div>
                                    </div>
                                    <!-- Derived, not asked: see _compute_mailbox_type. -->
                                    <label for="mailbox_type" string="Type"/>
                                    <div>
                                        <field name="mailbox_type" nolabel="1" class="d-inline-block"/>
                                        <div class="text-muted mt-1">
                                            Follows from the owner. Their own address is
                                            personal: only they send from it. Any other
                                            address is shared: everyone can send from it.
                                        </div>
                                        <!-- The provider's own word for the address,
                                             once the access check has asked. Silent
                                             until then: "not checked yet" under a type
                                             that is already stated reads as a fault. -->
                                        <div class="text-muted mt-1" invisible="address_kind == 'unknown'">
                                            At the provider: <field name="address_kind" nolabel="1"
                                                                   readonly="1" class="d-inline-block"/>
                                        </div>
                                    </div>
                                    <label for="is_notification_mailbox"/>
                                    <div>
                                        <field name="is_notification_mailbox" widget="boolean_toggle"
                                               nolabel="1" class="d-inline-block"/>
                                        <div class="text-muted mt-1">
                                            Odoo's own email leaves from here: invitations,
                                            password resets, reminders. Exactly one mailbox.
                                        </div>
                                    </div>
                                    <field name="sync_start_date" string="Import from"
                                           invisible="is_notification_mailbox"/>
                                </group>
                                <group>
                                    <!-- Sending is the one thing the consent
                                         screen does not prove: a missing send
                                         scope, an ungranted SendAs, an SPF or
                                         DMARC record that rejects the address.
                                         So it belongs to setting the mailbox
                                         up, not to looking at one. The mail
                                         goes to whoever presses it, never to
                                         this address. -->
                                    <div>
                                        <button name="action_test_send" type="object"
                                                string="Send test email" class="btn-link ps-0"
                                                icon="fa-paper-plane"/>
                                        <div class="text-muted mt-1">
                                            Sends one email to you, to prove this address
                                            can actually send.
                                        </div>
                                    </div>
                                    <!-- The access check, by hand. It runs on its
                                         own at every consent and once an hour under
                                         the sync; this is for the admin who just
                                         granted a right in Exchange and wants to see
                                         it land. Secondary: the one primary action on
                                         this tab stays the test email. -->
                                    <div groups="pan_mail_pro.group_mail_mailbox_manager">
                                        <button name="action_check_access" type="object"
                                                string="Check access" class="btn-link ps-0"
                                                icon="fa-check-circle-o"/>
                                        <div class="text-muted mt-1">
                                            Asks the provider what this address is and whether
                                            each sign-in may read and send from it.
                                        </div>
                                    </div>
                                    <div invisible="provider != 'imap'">
                                        <button name="action_open_account" type="object"
                                                string="Server credentials" class="btn-link ps-0"
                                                icon="fa-key"/>
                                        <div class="text-muted mt-1">
                                            This address is reached with a server, a login and a
                                            password rather than a consent screen.
                                        </div>
                                    </div>
                                </group>
                            </group>
                            <!-- Who may do what here, as the provider last said:
                                 one line per sign-in that reads this mailbox or
                                 has sent through it. On a Microsoft shared
                                 mailbox that is each sender in turn, and the one
                                 Exchange refused is the line an admin needs when
                                 a quotation did not leave. Drawn only once there
                                 is a line to draw. -->
                            <div invisible="not access_ids" class="mt-3">
                                <span class="o_form_label">Access</span>
                                <field name="access_ids" nolabel="1" readonly="1" class="mt-1">
                                    <list create="false" edit="false" delete="false"
                                          decoration-danger="can_read == 'no' or can_send == 'no'"
                                          decoration-muted="can_read == 'unknown' and can_send == 'unknown'">
                                        <field name="account_id" string="Sign-in"/>
                                        <field name="can_read" string="Reads"/>
                                        <field name="can_send" string="Sends"/>
                                        <field name="checked_date" string="Checked"/>
                                        <field name="sent_date" string="Last send" optional="hide"/>
                                        <field name="error" string="Reason"/>
                                    </list>
                                </field>
                            </div>
                        </page>
                    </notebook>

                    <!-- The one sentence a mailbox owes the reader, and the
                         way back, together. Shown for every unhealthy state
                         rather than only `error`, because a cron that stopped
                         running leaves the state at `active` and used to say
                         nothing at all. Nothing is drawn while it works. -->
                    <div class="alert alert-danger mt-3" role="alert"
                         invisible="health_status == 'healthy'">
                        <field name="status_message" nolabel="1" readonly="1"/>
                        <button name="action_sync_now" type="object" string="Try again"
                                class="btn-secondary btn-sm ms-2"
                                invisible="is_notification_mailbox"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_pan_mail_mailbox" model="ir.actions.act_window">
        <field name="name">Mailboxes</field>
        <field name="res_model">pan.mail.mailbox</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first mailbox
            </p>
            <p>
                A mailbox is an address Mail Pro sends and receives on, using the
                provider you set up. One of them carries the system email.
            </p>
        </field>
    </record>

    <!--
        Mailbox Manager, not only the system administrator: the ACL gives that
        group write on `pan.mail.mailbox`, and `action_sync_now` /
        `action_test_incoming` are gated on it, so an admin-only menu meant the
        only people allowed to press those buttons could not reach the form
        they are on. Credentials stay administrator-only: Email Accounts and
        Providers keep `base.group_system`.
    -->
    <!-- Menu: Settings → Technical → Email → Mailboxes -->
    <menuitem id="menu_pan_mail_mailbox"
              name="Mailboxes"
              parent="pan_mail_pro.menu_pan_mail_root"
              action="action_pan_mail_mailbox"
              sequence="20"
              groups="pan_mail_pro.group_mail_mailbox_manager"/>

</odoo>
