<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_pan_mail_mailbox_list" model="ir.ui.view">
        <field name="name">pan.mail.mailbox.list</field>
        <field name="model">pan.mail.mailbox</field>
        <field name="arch" type="xml">
            <list string="Mailboxes" js_class="mailbox_list"
                  decoration-danger="health_status == 'error'"
                  decoration-warning="health_status == 'warning'">
                <field name="sequence" widget="handle"/>
                <field name="email" string="Mailbox"/>
                <field name="health_status" string="Status" widget="badge"
                       decoration-success="health_status == 'healthy'"
                       decoration-warning="health_status == 'warning'"
                       decoration-danger="health_status == 'error'"/>
                <!-- Editable straight from the list: which mailbox sends the
                     system email is one tick, and moving it is untick here,
                     tick there. -->
                <field name="is_notification_mailbox" string="Notification"
                       widget="boolean_toggle"/>
                <field name="mailbox_type" string="Type" optional="hide"/>
                <field name="provider" string="Provider" optional="hide"/>
                <field name="owner_user_id" string="Owner" optional="hide"/>
                <field name="sync_mode" string="Incoming" optional="hide"/>
                <field name="last_sync_date" string="Last Synced" optional="hide"/>
                <field name="error_message" string="Error" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_pan_mail_mailbox_form" model="ir.ui.view">
        <field name="name">pan.mail.mailbox.form</field>
        <field name="model">pan.mail.mailbox</field>
        <field name="arch" type="xml">
            <form string="Mailbox">
                <sheet>
                    <!-- SECTION 1: MAILBOX -->
                    <group string="Mailbox">
                        <group>
                            <field name="email" placeholder="support@company.com"/>
                            <field name="provider"/>
                            <field name="health_status" string="Status" widget="badge"
                                   decoration-success="health_status == 'healthy'"
                                   decoration-warning="health_status == 'warning'"
                                   decoration-danger="health_status == 'error'"
                                   readonly="1"/>
                            <label for="mailbox_type" string="Type"/>
                            <div>
                                <field name="mailbox_type" widget="radio" nolabel="1" class="d-inline-block"/>
                                <i class="fa fa-info-circle text-muted ms-1"
                                   title="Personal: only the owner sends from it. Shared: everyone sends from this address — on Microsoft 365 with their own account, on Gmail and IMAP with the address's own credentials, so it needs no owner. Notification: system emails, sent with the owner's account."/>
                            </div>
                            <field name="owner_user_id"
                                   required="mailbox_type == 'personal' or is_notification_mailbox"/>
                            <label for="is_notification_mailbox"/>
                            <div>
                                <field name="is_notification_mailbox" widget="boolean_toggle"
                                       nolabel="1" class="d-inline-block"/>
                                <i class="fa fa-info-circle text-muted ms-1"
                                   title="System emails — user invitations, password resets, activity reminders — go out from this mailbox. Exactly one mailbox has it ticked."/>
                            </div>
                        </group>
                        <group>
                            <div invisible="provider != 'imap'">
                                <button name="action_open_account" type="object"
                                        string="Server Credentials" class="btn-link ps-0"
                                        icon="fa-key"/>
                                <i class="fa fa-info-circle text-muted ms-1"
                                   title="IMAP/SMTP mailboxes are reached with a server, a login and a password rather than a consent screen."/>
                            </div>
                        </group>
                    </group>

                    <!-- SECTION 2: INCOMING EMAIL (not for notification) -->
                    <group string="Incoming Email" invisible="is_notification_mailbox">
                        <group>
                            <label for="sync_mode"/>
                            <div>
                                <field name="sync_mode" widget="radio" nolabel="1" class="d-inline-block"/>
                                <i class="fa fa-info-circle text-muted ms-1"
                                   title="Mail is imported oldest first, up to 200 per minute. From anyone: senders who are not contacts yet are created automatically, unless you hold them for review below."/>
                            </div>
                            <field name="sync_start_date"
                                   invisible="sync_mode == 'none'"/>
                            <field name="last_sync_date" readonly="1"
                                   invisible="sync_mode == 'none' or not last_sync_date"/>
                        </group>
                        <group/>
                    </group>

                    <!-- SECTION 3: ROUTING (only when sync enabled) -->
                    <group string="Routing" invisible="is_notification_mailbox or sync_mode == 'none'">
                        <group>
                            <label for="route_to_team"/>
                            <div>
                                <field name="route_to_team" widget="boolean_toggle" nolabel="1" class="d-inline-block"/>
                                <i class="fa fa-info-circle text-muted ms-1"
                                   title="Off: mail is posted on the sender's contact record. On: mail goes to the team behind the alias you pick."/>
                            </div>
                            <field name="alias_id" string="Team"
                                   invisible="not route_to_team"
                                   required="route_to_team"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   placeholder="Select team..."/>
                        </group>
                        <group/>
                    </group>
                    <!-- The interlock that keeps AI auto-routing off. See models/ai/. -->
                    <field name="routing_smart" invisible="1"/>

                    <!-- SECTION 4: REVIEW QUEUE (only when unknown senders are synced) -->
                    <group string="Review Queue" invisible="is_notification_mailbox or sync_mode != 'all'">
                        <group>
                            <label for="queue_unknown_contacts" string="Hold for review"/>
                            <div>
                                <field name="queue_unknown_contacts" widget="boolean_toggle"
                                       nolabel="1" class="d-inline-block"/>
                                <i class="fa fa-info-circle text-muted ms-1"
                                   title="Mail from unknown senders waits in Communication → Triage instead of creating a contact automatically."/>
                            </div>
                        </group>
                        <group/>
                    </group>

                    <!-- SYNC BUTTON -->
                    <group invisible="is_notification_mailbox or sync_mode == 'none'">
                        <group>
                            <button name="action_sync_now" string="Sync Now"
                                    type="object" class="btn-primary" icon="fa-refresh"/>
                        </group>
                        <group/>
                    </group>

                    <!-- Error alert -->
                    <div class="alert alert-danger" role="alert" invisible="state != 'error'">
                        <strong>Sync failed:</strong> <field name="error_message" nolabel="1" readonly="1"/>
                    </div>

                    <!-- Hidden fields -->
                    <field name="state" invisible="1"/>
                    <field name="sync_mode" invisible="1"/>
                    <field name="active" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_pan_mail_mailbox" model="ir.actions.act_window">
        <field name="name">Mailboxes</field>
        <field name="res_model">pan.mail.mailbox</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first mailbox
            </p>
            <p>
                Configure mailboxes for sending and receiving email via Microsoft 365.
            </p>
        </field>
    </record>

    <!-- Menu: Settings → Technical → Email → Mailboxes -->
    <menuitem id="menu_pan_mail_mailbox"
              name="Mailboxes"
              parent="base.menu_email"
              action="action_pan_mail_mailbox"
              sequence="5"
              groups="base.group_system"/>

</odoo>
