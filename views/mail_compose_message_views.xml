<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend mail compose message form to add Send From dropdown -->
    <record id="view_mail_compose_message_form_inherit" model="ir.ui.view">
        <field name="name">mail.compose.message.form.inherit</field>
        <field name="model">mail.compose.message</field>
        <field name="inherit_id" ref="mail.email_compose_message_wizard_form"/>
        <field name="arch" type="xml">
            <!-- Add Send From field after the email_from field -->
            <xpath expr="//field[@name='email_from']" position="after">
                <field name="x_microsoft_send_from_id"
                       placeholder="Select mailbox to send from..."
                       domain="['&amp;', ('active', '=', True), ('x_mailbox_type', '!=', 'notification'), '|', ('x_mailbox_type', '=', 'shared'), '&amp;', ('x_mailbox_type', '=', 'personal'), ('x_owner_user_id', '=', uid)]"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
