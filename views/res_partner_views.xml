<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add email sync blocked field to partner form -->
    <record id="view_partner_form_inherit_outlook_pro" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.outlook.pro</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="x_email_sync_blocked" string="Block Email Sync"
                       help="Block incoming email sync from this contact"/>
            </xpath>
        </field>
    </record>
</odoo>
